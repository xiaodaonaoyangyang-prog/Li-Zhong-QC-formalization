import References.Forster1981.Ch02.S20_AbelsTheorem

/-!
# Forster, Chapter 2 §21: The Jacobi inversion problem

Source: O. Forster, *Lectures on Riemann Surfaces*, GTM 81, §21 (`full.md` F1:7509–7936).

Conventions (ruling B0.11): Forster's definition of a lattice is `IsLattice` (new; Mathlib's `IsZLattice` is the
characterization of 21.1, so 21.1 would otherwise be a tautology). The period lattice `Per` is an `AddSubgroup.closure` of the
period vectors of Part A's `period` (a set that is already a subgroup by 10.11); `Jac`, `Pic` and `Pic₀` are quotient
groups; `Div₀` and `Div_P` are `AddSubgroup.closure`s of sets that are already subgroups (on a compact surface), which avoids
additivity proofs. The map `Φ : Div₀ → Jac` is existential, with its defining property `IsAbelJacobi`; `j` and `J` are stated
through it. The basis `ω₁, …, ω_g` of `Ω(X)` is given by representatives (`IsBasisOfHol`).

* Paragraph 21.1 (lattices, F1:7513) — `IsLattice`, `thm21_1`
* Paragraph 21.2 (period lattices, F1:7583) — `periodLattice`
* Lemma 21.3 (F1:7607) — `lemma21_3`
* Theorem 21.4 (F1:7623) — `thm21_4`
* Paragraph 21.6 (the Jacobi variety and the Picard group, F1:7721) — `jacobiVariety`, `divDeg0`, `principalDivisors`,
  `picardGroup`, `picardGroup0`, `IsAbelJacobi`, `para21_6`
* Theorem 21.7 (F1:7767) — `thm21_7`
* Theorem 21.9 (F1:7815) — `thm21_9`
* Theorem 21.10 (F1:7855) — `thm21_10`

Omitted (U−): the remark of 21.1, the remark of 21.2, 21.5 (`H₁(X) ≅ ℤ^{2g}`), the remark of 21.9. Near miss: `IsZLattice`.
-/

open scoped Manifold ContDiff Topology References
open Set Filter TopologicalSpace CategoryTheory Opposite

namespace Forster1981

/-- **Lattices** (21.1, Ch. 2 §21, F1:7513): an additive subgroup `Γ` of a real vector space `V` of dimension `N` is a lattice
if `Γ = ℤγ₁ + ⋯ + ℤγ_N` for `ℝ`-linearly independent vectors `γ_i`. -/
def IsLattice {V : Type} [AddCommGroup V] [Module ℝ V] (Γ : AddSubgroup V) : Prop :=
  ∃ γ : Fin (Module.finrank ℝ V) → V, LinearIndependent ℝ γ ∧ Γ = AddSubgroup.closure (Set.range γ)

/-- **Theorem 21.1** (Ch. 2 §21, F1:7513). A subgroup `Γ` of a finite dimensional real vector space `V` is a lattice precisely
if (i) it is discrete (there is a neighbourhood `U` of zero with `Γ ∩ U = {0}`) and (ii) it is contained in no proper vector
subspace of `V`. -/
theorem thm21_1 {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] [FiniteDimensional ℝ V] (Γ : AddSubgroup V) :
    IsLattice Γ ↔ (∃ U ∈ 𝓝 (0 : V), (Γ : Set V) ∩ U = {0}) ∧
      ∀ W : Submodule ℝ V, (Γ : Set V) ⊆ W → W = ⊤ := by
  sorry

section RiemannSurface

variable {X : Type} [TopologicalSpace X] [T2Space X] [ConnectedSpace X] [ChartedSpace ℂ X] [IsManifold 𝓘(ℂ) ω X]

/-- **The period lattice** `Per(ω₁, …, ω_g) ⊆ ℂ^g` (21.2, Ch. 2 §21, F1:7583): the vectors
`(∫_α ω₁, …, ∫_α ω_g)`, `α ∈ π₁(X)`. -/
def periodLattice {n : ℕ} (w : Fin n → Form1 X) : AddSubgroup (Fin n → ℂ) :=
  AddSubgroup.closure {v | ∃ (x₀ : X) (σ : FundamentalGroup X x₀), ∀ k, v k = period (w k) σ}

/-- **The Jacobi variety** `Jac(X) = ℂ^g / Per(ω₁, …, ω_g)` (21.6, Ch. 2 §21, F1:7721), as an abelian group. -/
abbrev jacobiVariety {n : ℕ} (w : Fin n → Form1 X) : Type := (Fin n → ℂ) ⧸ periodLattice w

variable (X) in
/-- **The group `Div₀(X)`** of divisors of degree zero (21.6, Ch. 2 §21, F1:7721), as the subgroup generated by them. -/
def divDeg0 : AddSubgroup (Function.locallyFinsupp X ℤ) := AddSubgroup.closure {D | divDeg D = 0}

variable (X) in
/-- **The group `Div_P(X)`** of principal divisors (21.6, Ch. 2 §21, F1:7721), as the subgroup generated by them. -/
def principalDivisors : AddSubgroup (Function.locallyFinsupp X ℤ) := AddSubgroup.closure {D | IsPrincipalDivisor D}

variable (X) in
/-- **The Picard group** `Pic(X) = Div(X)/Div_P(X)` (21.6, Ch. 2 §21, F1:7721). -/
abbrev picardGroup : Type := Function.locallyFinsupp X ℤ ⧸ principalDivisors X

variable (X) in
/-- **The group** `Pic₀(X) = Div₀(X)/Div_P(X)` (21.6, Ch. 2 §21, F1:7721). -/
abbrev picardGroup0 : Type := ↥(divDeg0 X) ⧸ (principalDivisors X).comap (divDeg0 X).subtype

/-- **The homomorphism `Φ : Div₀(X) → Jac(X)`** (21.6, Ch. 2 §21, F1:7721): for a chain `c` with `∂c = D`, `Φ(D)` is the class
of the vector `(∫_c ω₁, …, ∫_c ω_g)`. -/
def IsAbelJacobi {n : ℕ} (w : Fin n → Form1 X) (Φ : ↥(divDeg0 X) →+ jacobiVariety w) : Prop :=
  ∀ (D : ↥(divDeg0 X)) (c : Chain1 X), IsChainBoundary c D → ∀ v : Fin n → ℂ, (∀ k, HasChainIntegral (w k) c (v k)) →
    Φ D = QuotientAddGroup.mk v

/-- **Lemma 21.3** (Ch. 2 §21, F1:7607). On a compact Riemann surface of genus `g` there are `g` distinct points
`a_1, …, a_g` such that every holomorphic 1-form vanishing at all of them is identically zero. -/
theorem lemma21_3 [CompactSpace X] :
    ∃ a : Fin (genus X) → X, Function.Injective a ∧ ∀ s ∈ holFormsOn X ⊤,
      (∀ j, s.1 (a j) (chartAt ℂ (a j) (a j)) = 0) → s.VanishOn ⊤ := by
  sorry

/-- **Theorem 21.4** (Ch. 2 §21, F1:7623). For a compact Riemann surface of genus `g ≥ 1` and a basis `ω₁, …, ω_g` of
`Ω(X)`, `Per(ω₁, …, ω_g)` is a lattice in `ℂ^g`. -/
theorem thm21_4 [CompactSpace X] (hg : 1 ≤ genus X) {w : Fin (genus X) → Form1 X} (hw : IsBasisOfHol w) :
    IsLattice (periodLattice w) := by
  sorry

/-- **Paragraph 21.6** (Ch. 2 §21, F1:7721). For a compact Riemann surface of genus `g` and a basis `ω₁, …, ω_g` of `Ω(X)`
there is a group homomorphism `Φ : Div₀(X) → Jac(X)` with the property of 21.6, and its kernel is `Div_P(X)`. -/
theorem para21_6 [CompactSpace X] {w : Fin (genus X) → Form1 X} (hw : IsBasisOfHol w) :
    ∃ Φ : ↥(divDeg0 X) →+ jacobiVariety w, IsAbelJacobi w Φ ∧ Φ.ker = (principalDivisors X).comap (divDeg0 X).subtype := by
  sorry

/-- **Theorem 21.7** (Ch. 2 §21, F1:7767). For every compact Riemann surface the induced map `j : Pic₀(X) → Jac(X)` is an
isomorphism. -/
theorem thm21_7 [CompactSpace X] {w : Fin (genus X) → Form1 X} (hw : IsBasisOfHol w)
    {Φ : ↥(divDeg0 X) →+ jacobiVariety w} (hΦ : IsAbelJacobi w Φ) :
    ∃ e : picardGroup0 X ≃+ jacobiVariety w, ∀ D : ↥(divDeg0 X), e (QuotientAddGroup.mk D) = Φ D := by
  sorry

/-- **Theorem 21.9** (Ch. 2 §21, F1:7815). For points `a_1, …, a_g` the map
`J : X^g → Jac(X)`, `J(x_1, …, x_g) = Φ(Σ (D_{x_j} − D_{a_j}))`, is surjective. -/
theorem thm21_9 [CompactSpace X] {w : Fin (genus X) → Form1 X} (hw : IsBasisOfHol w)
    {Φ : ↥(divDeg0 X) →+ jacobiVariety w} (hΦ : IsAbelJacobi w Φ) (a : Fin (genus X) → X) (y : jacobiVariety w) :
    ∃ (x : Fin (genus X) → X) (D : ↥(divDeg0 X)),
      (D : Function.locallyFinsupp X ℤ) = ∑ j, (divSingle (x j) 1 -
        divSingle (a j) 1) ∧ Φ D = y := by
  sorry

/-- **Theorem 21.10** (Ch. 2 §21, F1:7855). If `X` has genus `1`, the map `J : X → Jac(X)` is biholomorphic onto a torus: there
are a lattice `L` with `L.lattice = Per(ω)` and a torus projection `π : ℂ → X` with `J(π(z)) = z mod Per`. -/
theorem thm21_10 [CompactSpace X] (hg : genus X = 1) {w : Fin (genus X) → Form1 X} (hw : IsBasisOfHol w)
    {Φ : ↥(divDeg0 X) →+ jacobiVariety w} (hΦ : IsAbelJacobi w Φ) (a₀ : X) :
    ∃ (L : PeriodPair) (π : ℂ → X), IsTorusProjection L π ∧
      (∀ z : ℂ, z ∈ L.lattice ↔ (fun _ => z) ∈ periodLattice w) ∧
      ∀ z : ℂ, ∃ D : ↥(divDeg0 X), (D : Function.locallyFinsupp X ℤ) =
        divSingle (π z) 1 - divSingle a₀ 1 ∧
        Φ D = QuotientAddGroup.mk (fun _ => z) := by
  sorry

end RiemannSurface

end Forster1981
