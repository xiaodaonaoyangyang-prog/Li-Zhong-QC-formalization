import References.FarkasKra1992.Ch04.S11_AlgebraicFunctionFields
import Mathlib.Topology.CompactOpen

/-!
# Farkas–Kra, Chapter V §4: The exceptional Riemann surfaces

Source: H. M. Farkas, I. Kra, *Riemann Surfaces*, 2nd ed., GTM 71, Ch. V §4 (`full.md` FK2:4902–5027).

Conventions: as in `Ch04/S06_ExceptionalSurfaces`. `Aut M` is the set of biholomorphic homeomorphisms of `M`. FK do not define
"`Aut M` is discrete"; the topology used here is the compact-open topology of `C(M, M)` induced on `Aut M` (`IsDiscreteAut`:
the identity is an isolated point; `Aut M` is a topological group, so this is discreteness). `Aut ℂ̂`, `Aut ℂ`, `Aut U`
(V.4.2) are `FarkasKra1992.para4_5_6_a`, `_b`, `_c`.

* Theorem V.4.1 — `IsDiscreteAut`, `thm5_4_1`
* V.4.2 (`Aut ℂ̂`, `Aut ℂ`, `Aut Δ`) — exists: `FarkasKra1992.para4_5_6_a`, `FarkasKra1992.para4_5_6_b`, `FarkasKra1992.para4_5_6_c`
* V.4.3 (`Aut ℂ*`) — `para5_4_3`
* V.4.4 (`Aut Δ*`) — `para5_4_4`
* V.4.5 (`Aut M ≅ N(G)/G`) — `para5_4_5`

Omitted (U−): V.4.6–V.4.8 (steps of the proof of V.4.1: the groups `Aut Δ_r` and `Aut T`, exhaustion).
-/

open scoped Manifold ContDiff MatrixGroups Topology References
open Set Filter

noncomputable section

namespace FarkasKra1992

open LiZhongQC (IsBiholomorphic RSConformallyEquivalent IsTorusWithPeriod)

variable {M : Type} [TopologicalSpace M] [T2Space M] [ConnectedSpace M] [ChartedSpace ℂ M] [IsManifold 𝓘(ℂ) ω M]

/-- **`Aut M` is discrete** (Ch. V §4.1). The group `Aut M` of conformal automorphisms of `M` is a discrete subgroup of
`Homeo(M)` in the compact-open topology: the identity has a neighbourhood in `C(M, M)` containing no other automorphism. -/
def IsDiscreteAut (M : Type) [TopologicalSpace M] [ChartedSpace ℂ M] : Prop :=
  ∃ U : Set C(M, M), IsOpen U ∧ ContinuousMap.id M ∈ U ∧
    ∀ f : M ≃ₜ M, IsBiholomorphic (f : M → M) → (f : C(M, M)) ∈ U → f = 1

/-- **Theorem V.4.1** (Ch. V §4.1). `Aut M` is not a discrete group if and only if `M` is conformally equivalent to one of:
`ℂ ∪ {∞}`, `ℂ`, `Δ`, `ℂ* = ℂ ∖ {0}`, `Δ* = Δ ∖ {0}`, `Δ_r = {r < |z| < 1}` (`0 < r < 1`), or a torus `ℂ/G`, where `G` is
generated by `z ↦ z + 1`, `z ↦ z + τ`, `Im τ > 0`. -/
theorem thm5_4_1 :
    ¬ IsDiscreteAut M ↔
      (RSConformallyEquivalent M References.RiemannSphere ∨ RSConformallyEquivalent M ℂ ∨
        RSConformallyEquivalent M ↥Forster1981.unitDiscOpen ∨ RSConformallyEquivalent M ↥Forster1981.punctPlane ∨
        RSConformallyEquivalent M ↥Forster1981.punctUnitDisc ∨
        (∃ r : ℝ, 0 < r ∧ r < 1 ∧ RSConformallyEquivalent M ↥(annulusOpens r)) ∨
        ∃ (τ : ℂ) (p : ℂ → M), IsTorusWithPeriod τ p) := by
  sorry

/-- **Unlabelled** (Ch. V §4.3, FK2:4932). The automorphisms of `ℂ* = ℂ ∖ {0}` are the Möbius transformations
`z ↦ kz` and `z ↦ k/z`, with `k ∈ ℂ*`. -/
theorem para5_4_3 (φ : ↥Forster1981.punctPlane ≃ₜ ↥Forster1981.punctPlane) :
    IsBiholomorphic (φ : ↥Forster1981.punctPlane → ↥Forster1981.punctPlane) ↔
      ∃ k : ℂ, k ≠ 0 ∧ ((∀ z : ↥Forster1981.punctPlane, (φ z : ℂ) = k * z) ∨
        ∀ z : ↥Forster1981.punctPlane, (φ z : ℂ) = k / z) := by
  sorry

/-- **Unlabelled** (Ch. V §4.4, FK2:4940). The automorphisms of `Δ* = Δ ∖ {0}` are the rotations `z ↦ e^{iθ} z`,
`θ ∈ ℝ`. -/
theorem para5_4_4 (φ : ↥Forster1981.punctUnitDisc ≃ₜ ↥Forster1981.punctUnitDisc) :
    IsBiholomorphic (φ : ↥Forster1981.punctUnitDisc → ↥Forster1981.punctUnitDisc) ↔
      ∃ θ : ℝ, ∀ z : ↥Forster1981.punctUnitDisc, (φ z : ℂ) = Complex.exp (θ * Complex.I) * z := by
  sorry

/-- **Unlabelled** (Ch. V §4.5, FK2:4948). Let `M` be a Riemann surface with holomorphic universal covering map
`π : M̃ → M` and `G` the covering group of `π`. Then `Aut M ≅ N(G)/G`, where `N(G)` is the normalizer of `G` in `Aut M̃`.
Modelling: there is a map `Φ` from the automorphisms of `M̃` normalizing `G` onto `Aut M`, characterized by
`π ∘ σ = Φ(σ) ∘ π`, multiplicative, with kernel exactly `G`. -/
theorem para5_4_5 {Mt : Type} [TopologicalSpace Mt] [T2Space Mt] [ConnectedSpace Mt] [ChartedSpace ℂ Mt]
    [IsManifold 𝓘(ℂ) ω Mt]
    {π : Mt → M} (hπ : Forster1981.IsUniversalCovering π) (hπa : MDifferentiable 𝓘(ℂ) 𝓘(ℂ) π) :
    ∃ Φ : (Mt ≃ₜ Mt) → (M ≃ₜ M),
      (∀ σ : Mt ≃ₜ Mt, IsBiholomorphic (σ : Mt → Mt) → σ ∈ Subgroup.normalizer (deck π : Set (Mt ≃ₜ Mt)) →
        IsBiholomorphic (Φ σ : M → M) ∧ π ∘ σ = Φ σ ∘ π) ∧
      (∀ τ : M ≃ₜ M, IsBiholomorphic (τ : M → M) →
        ∃ σ : Mt ≃ₜ Mt, IsBiholomorphic (σ : Mt → Mt) ∧ σ ∈ Subgroup.normalizer (deck π : Set (Mt ≃ₜ Mt)) ∧ Φ σ = τ) ∧
      (∀ σ σ' : Mt ≃ₜ Mt, σ ∈ Subgroup.normalizer (deck π : Set (Mt ≃ₜ Mt)) → σ' ∈ Subgroup.normalizer (deck π : Set (Mt ≃ₜ Mt)) → Φ (σ * σ') = Φ σ * Φ σ') ∧
      ∀ σ : Mt ≃ₜ Mt, IsBiholomorphic (σ : Mt → Mt) → σ ∈ Subgroup.normalizer (deck π : Set (Mt ≃ₜ Mt)) → (Φ σ = 1 ↔ σ ∈ deck π) := by
  sorry

end FarkasKra1992
