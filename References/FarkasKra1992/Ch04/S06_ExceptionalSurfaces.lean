import References.FarkasKra1992.Ch04.S05_Uniformization

/-!
# Farkas–Kra, Chapter IV §6: The exceptional Riemann surfaces

Source: H. M. Farkas, I. Kra, *Riemann Surfaces*, 2nd ed., GTM 71, Ch. IV §6 (`full.md` FK2:1049–1226).

Conventions: as in `Ch04/S05_Uniformization` (Riemann surfaces by instance binders, no second countability, `ℂ̂` is
`References.RiemannSphere`). The model surfaces are the open subsets of `ℂ`: `Δ = Forster1981.unitDiscOpen`,
`Δ* = Forster1981.punctUnitDisc`, `ℂ* = Forster1981.punctPlane`, `Δ_r = annulusOpens r`. A torus `ℂ/⟨1, τ⟩` is a
surface `X` with `LiZhongQC.IsTorusWithPeriod τ p` for a holomorphic covering `p : ℂ → X`. Möbius types are
those of `Lehto1987` (normal forms); FK's `loxodromic` (`trace² ∉ [0, 4]`) contains the hyperbolic elements and is
`IsLoxodromicFK`, while `Lehto1987.IsLoxodromicMob` excludes them. `trace² A = (a + d)²` of the matrix of `A` in
`SL(2, ℂ)`.

* Theorem IV.6.1 (a) — `thm4_6_1_a`
* Theorem IV.6.1 (b) — `thm4_6_1_b`
* Theorem IV.6.1 (c) — `thm4_6_1_c`
* Theorem IV.6.1 (d) — `thm4_6_1_d`
* IV.6.2 (Möbius types: parabolic, elliptic, hyperbolic) — exists: `Lehto1987.IsParabolicMob`, `Lehto1987.IsEllipticMob`, `Lehto1987.IsHyperbolicMob`
* IV.6.2 (loxodromic, FK's sense) — `IsLoxodromicFK`
* IV.6.2 (a Möbius transformation `≠ 1` has one or two fixed points) — `para4_6_2_a`
* IV.6.2 (parabolic ⇔ `trace² = 4`) — `para4_6_2_b`
* IV.6.2 (two fixed points: conjugate to `z ↦ λz`) — `para4_6_2_c`
* IV.6.2 (elliptic ⇔ `trace² ∈ [0, 4)`) — `para4_6_2_d`
* IV.6.2 (loxodromic ⇔ `trace² ∉ [0, 4]`) — `para4_6_2_e`
* IV.6.2 (hyperbolic ⇔ `trace²` real `> 4`) — `para4_6_2_f`
* Theorem IV.6.3 — `thm4_6_3`
* Theorem IV.6.4 — `thm4_6_4`
* Proposition IV.6.5 — `prop4_6_5`
* IV.6.6 (loxodromic elements of `Aut U` are hyperbolic) — `para4_6_6_a`
* IV.6.6 (the covering group has only parabolic and hyperbolic elements) — `para4_6_6_b`
* Lemma IV.6.6 (a) — `lemma4_6_6_a`
* Lemma IV.6.6 (b) — `lemma4_6_6_b`
* Corollary IV.6.6 — `cor4_6_6`
* Theorem IV.6.7 — `thm4_6_7`
* Theorem IV.6.8 — `thm4_6_8`
* Theorem IV.6.9 — `thm4_6_9`

Helpers (not book notions): `annulusOpens`, `mobiusFixSet`.
Omitted (U−): the multiplier remark in IV.6.2 (root of unity ⇔ elliptic of finite order), Remark after IV.6.5.
-/

open scoped Manifold ContDiff MatrixGroups Topology References
open Set Filter

noncomputable section

namespace FarkasKra1992

open LiZhongQC (mobiusSL mobiusExt IsMobius slRealToComplex IsBiholomorphic RSConformallyEquivalent
  IsTorusWithPeriod)
open Lehto1987 (IsParabolicMob IsEllipticMob IsHyperbolicMob IsLoxodromicMob)
open References (RiemannSphere)

variable {M : Type} [TopologicalSpace M] [T2Space M] [ConnectedSpace M] [ChartedSpace ℂ M] [IsManifold 𝓘(ℂ) ω M]

/-- The annulus `Δ_r = {z ∈ ℂ ; r < |z| < 1}` as an open subset of `ℂ` (helper). -/
def annulusOpens (r : ℝ) : TopologicalSpace.Opens ℂ :=
  ⟨{z | r < ‖z‖ ∧ ‖z‖ < 1}, (isOpen_lt continuous_const continuous_norm).inter
    (isOpen_lt continuous_norm continuous_const)⟩

/-- The fixed point set of the Möbius transformation of `g ∈ SL(2, ℂ)` on `ℂ̂` (helper). -/
def mobiusFixSet (g : SL(2, ℂ)) : Set RiemannSphere := {z | mobiusSL g z = z}

/-- **Loxodromic** (Ch. IV §6.2, FK's sense). The element `A` is loxodromic if `trace² A ∉ [0, 4]`; this class
contains the hyperbolic elements (`para4_6_2_e` gives the trace form). Modelling: `Lehto1987.IsLoxodromicMob` (`|k| ≠ 1`,
`k` not a positive real) or `Lehto1987.IsHyperbolicMob`. -/
def IsLoxodromicFK (g : SL(2, ℂ)) : Prop := IsLoxodromicMob g ∨ IsHyperbolicMob g

/-- **Theorem IV.6.1(a)** (Ch. IV §6.1). The only simply connected Riemann surfaces are the ones conformally
equivalent to `ℂ ∪ {∞}`, `ℂ`, or `Δ`. Near miss: `LiZhongQC.thm22_2_uniformization` (the sphere case is stated as
"compact, and minus a point conformal to `ℂ`"). -/
theorem thm4_6_1_a [SimplyConnectedSpace M] :
    RSConformallyEquivalent M RiemannSphere ∨ RSConformallyEquivalent M ℂ ∨
      RSConformallyEquivalent M ↥Forster1981.unitDiscOpen := by
  sorry

/-- **Theorem IV.6.1(b)** (Ch. IV §6.1). The only surfaces with `π₁(M) ≅ ℤ` are (conformally equivalent to)
`ℂ* = ℂ ∖ {0}`, `Δ* = Δ ∖ {0}`, or `Δ_r = {z ∈ ℂ ; r < |z| < 1}`, `0 < r < 1`. -/
theorem thm4_6_1_b (x₀ : M) (h : Nonempty (FundamentalGroup M x₀ ≃* Multiplicative ℤ)) :
    RSConformallyEquivalent M ↥Forster1981.punctPlane ∨ RSConformallyEquivalent M ↥Forster1981.punctUnitDisc ∨
      ∃ r : ℝ, 0 < r ∧ r < 1 ∧ RSConformallyEquivalent M ↥(annulusOpens r) := by
  sorry

/-- **Theorem IV.6.1(c)** (Ch. IV §6.1). The only surfaces with `π₁(M) ≅ ℤ ⊕ ℤ` are the tori `ℂ/G`, where `G` is
generated by `z ↦ z + 1` and `z ↦ z + τ`, `Im τ > 0`. -/
theorem thm4_6_1_c (x₀ : M)
    (h : Nonempty (FundamentalGroup M x₀ ≃* Multiplicative ℤ × Multiplicative ℤ)) :
    ∃ (τ : ℂ) (p : ℂ → M), IsTorusWithPeriod τ p := by
  sorry

/-- **Theorem IV.6.1(d)** (Ch. IV §6.1). For all surfaces other than those of (a)–(c), `π₁(M)` is not abelian:
if `π₁(M)` is commutative then `M` is conformally equivalent to `ℂ̂`, `ℂ`, `Δ`, `ℂ*`, `Δ*`, `Δ_r` or a torus. -/
theorem thm4_6_1_d (x₀ : M) (h : ∀ a b : FundamentalGroup M x₀, a * b = b * a) :
    RSConformallyEquivalent M RiemannSphere ∨ RSConformallyEquivalent M ℂ ∨
      RSConformallyEquivalent M ↥Forster1981.unitDiscOpen ∨ RSConformallyEquivalent M ↥Forster1981.punctPlane ∨
      RSConformallyEquivalent M ↥Forster1981.punctUnitDisc ∨
      (∃ r : ℝ, 0 < r ∧ r < 1 ∧ RSConformallyEquivalent M ↥(annulusOpens r)) ∨
      ∃ (τ : ℂ) (p : ℂ → M), IsTorusWithPeriod τ p := by
  sorry

/-- **Unlabelled** (Ch. IV §6.2, FK2:1067). A Möbius transformation `A ≠ 1` has one or two fixed points.
Modelling: `A` is `g ∈ SL(2, ℂ)` with `g ≠ ±1`. -/
theorem para4_6_2_a (g : SL(2, ℂ)) (h1 : g ≠ 1) (h2 : g ≠ -1) :
    (mobiusFixSet g).encard = 1 ∨ (mobiusFixSet g).encard = 2 := by
  sorry

/-- **Unlabelled** (Ch. IV §6.2, FK2:1067–1073). `A ≠ 1` is parabolic (one fixed point; here conjugate to
`z ↦ z + 1`, `Lehto1987.IsParabolicMob`) if and only if `trace² A = 4`. -/
theorem para4_6_2_b (g : SL(2, ℂ)) (h1 : g ≠ 1) (h2 : g ≠ -1) :
    IsParabolicMob g ↔ (g 0 0 + g 1 1) ^ 2 = 4 := by
  sorry

/-- **Unlabelled** (Ch. IV §6.2, FK2:1075). An element `A ≠ 1` with two fixed points is conjugate to `z ↦ λz` with
`λ ≠ 0, 1` (the multiplier). -/
theorem para4_6_2_c (g : SL(2, ℂ)) (h1 : g ≠ 1) (h2 : g ≠ -1) (h : (mobiusFixSet g).encard = 2) :
    ∃ (T : RiemannSphere → RiemannSphere) (lam : ℂ), IsMobius T ∧ lam ≠ 0 ∧ lam ≠ 1 ∧
      ∀ z, T (mobiusSL g z) = mobiusExt lam 0 0 1 (T z) := by
  sorry

/-- **Unlabelled** (Ch. IV §6.2, FK2:1073–1089). `A` is elliptic (`Lehto1987.IsEllipticMob`: conjugate to `z ↦ λz`,
`|λ| = 1`, `λ ≠ 1`) if and only if `trace² A` is real and `0 ≤ trace² A < 4`. -/
theorem para4_6_2_d (g : SL(2, ℂ)) :
    IsEllipticMob g ↔ ((g 0 0 + g 1 1) ^ 2).im = 0 ∧ 0 ≤ ((g 0 0 + g 1 1) ^ 2).re ∧
      ((g 0 0 + g 1 1) ^ 2).re < 4 := by
  sorry

/-- **Unlabelled** (Ch. IV §6.2, FK2:1073–1089). `A` is loxodromic (`|λ| ≠ 1`, `λ ≠ 0`, including the hyperbolic
elements) if and only if `trace² A ∉ [0, 4]`. -/
theorem para4_6_2_e (g : SL(2, ℂ)) :
    IsLoxodromicFK g ↔ ¬ (((g 0 0 + g 1 1) ^ 2).im = 0 ∧ 0 ≤ ((g 0 0 + g 1 1) ^ 2).re ∧
      ((g 0 0 + g 1 1) ^ 2).re ≤ 4) := by
  sorry

/-- **Unlabelled** (Ch. IV §6.2, FK2:1073–1089). `A` is hyperbolic (`Lehto1987.IsHyperbolicMob`: conjugate to
`z ↦ λz`, `λ > 0`, `λ ≠ 1`) if and only if `trace² A` is real and `> 4`. -/
theorem para4_6_2_f (g : SL(2, ℂ)) :
    IsHyperbolicMob g ↔ ((g 0 0 + g 1 1) ^ 2).im = 0 ∧ 4 < ((g 0 0 + g 1 1) ^ 2).re := by
  sorry

/-- **Theorem IV.6.3** (Ch. IV §6.3). The only Riemann surface `M` which has as universal covering the sphere is the
sphere itself.
Modelling: the covering is a holomorphic universal covering `p : ℂ̂ → M`. -/
theorem thm4_6_3 {p : RiemannSphere → M} (hp : Forster1981.IsUniversalCovering p)
    (hpa : MDifferentiable 𝓘(ℂ) 𝓘(ℂ) p) : RSConformallyEquivalent M RiemannSphere := by
  sorry

/-- **Theorem IV.6.4** (Ch. IV §6.4). If the holomorphic universal covering space of `M` is `ℂ`, then `M` is
conformally equivalent to `ℂ`, `ℂ*`, or a torus; these correspond to `π₁(M)` being trivial, `≅ ℤ`, and `≅ ℤ ⊕ ℤ`. -/
theorem thm4_6_4 {p : ℂ → M} (hp : Forster1981.IsUniversalCovering p) (hpa : MDifferentiable 𝓘(ℂ) 𝓘(ℂ) p)
    (x₀ : M) :
    (Subsingleton (FundamentalGroup M x₀) ∧ RSConformallyEquivalent M ℂ) ∨
      (Nonempty (FundamentalGroup M x₀ ≃* Multiplicative ℤ) ∧ RSConformallyEquivalent M ↥Forster1981.punctPlane) ∨
      (Nonempty (FundamentalGroup M x₀ ≃* Multiplicative ℤ × Multiplicative ℤ) ∧
        ∃ (τ : ℂ) (q : ℂ → M), IsTorusWithPeriod τ q) := by
  sorry

/-- **Proposition IV.6.5** (Ch. IV §6.5). The fundamental group of a Riemann surface is torsion free. -/
theorem prop4_6_5 (x₀ : M) : IsMulTorsionFree (FundamentalGroup M x₀) := by
  sorry

/-- **Unlabelled** (Ch. IV §6.6, FK2:1117–1129). A loxodromic element of `Aut U = PSL(2, ℝ)` is hyperbolic: a
real matrix `g ∈ SL(2, ℝ)` whose Möbius transformation is loxodromic in FK's sense is hyperbolic. -/
theorem para4_6_6_a (g : SL(2, ℝ)) (h : IsLoxodromicFK (slRealToComplex g)) : IsHyperbolicMob (slRealToComplex g) := by
  sorry

/-- **Unlabelled** (Ch. IV §6.6, FK2:1129). The covering group of a Riemann surface whose holomorphic universal
covering space is `U` consists, apart from the identity, of parabolic and hyperbolic elements: each such covering
transformation is given by some `g ∈ SL(2, ℝ)` with `g` parabolic or hyperbolic. -/
theorem para4_6_6_b {p : ↥upperHalfPlaneOpens → M} (hp : Forster1981.IsUniversalCovering p)
    (hpa : MDifferentiable 𝓘(ℂ) 𝓘(ℂ) p) {σ : ↥upperHalfPlaneOpens ≃ₜ ↥upperHalfPlaneOpens} (hσ : σ ∈ deck p)
    (h1 : σ ≠ 1) :
    ∃ g : SL(2, ℝ), (∀ z, (σ z : RiemannSphere) = mobiusSL (slRealToComplex g) (z : RiemannSphere)) ∧
      (IsParabolicMob (slRealToComplex g) ∨ IsHyperbolicMob (slRealToComplex g)) := by
  sorry

/-- **Lemma IV.6.6(a)** (Ch. IV §6.6). Let `A` and `B` be commuting Möbius transformations, neither the identity.
If `A` is parabolic, so is `B`, and both have the same fixed point. -/
theorem lemma4_6_6_a (g h : SL(2, ℂ)) (hg1 : g ≠ 1) (hg2 : g ≠ -1) (hh1 : h ≠ 1) (hh2 : h ≠ -1)
    (hcomm : mobiusSL g ∘ mobiusSL h = mobiusSL h ∘ mobiusSL g) (hpar : IsParabolicMob g) :
    IsParabolicMob h ∧ mobiusFixSet g = mobiusFixSet h := by
  sorry

/-- **Lemma IV.6.6(b)** (Ch. IV §6.6). Let `A` and `B` be commuting Möbius transformations, neither the identity. If
one of them is not parabolic (then neither is the other by (a)), then either `A` and `B` have the same fixed points,
or both are elliptic of order 2 and one permutes the fixed points of the other. -/
theorem lemma4_6_6_b (g h : SL(2, ℂ)) (hg1 : g ≠ 1) (hg2 : g ≠ -1) (hh1 : h ≠ 1) (hh2 : h ≠ -1)
    (hcomm : mobiusSL g ∘ mobiusSL h = mobiusSL h ∘ mobiusSL g) (hnp : ¬ IsParabolicMob g) :
    mobiusFixSet g = mobiusFixSet h ∨
      (IsEllipticMob g ∧ IsEllipticMob h ∧ mobiusSL g ∘ mobiusSL g = id ∧ mobiusSL h ∘ mobiusSL h = id ∧
        (mobiusSL h '' mobiusFixSet g = mobiusFixSet g ∨ mobiusSL g '' mobiusFixSet h = mobiusFixSet h)) := by
  sorry

/-- **Corollary IV.6.6** (Ch. IV §6.6). Two commuting loxodromic transformations have the same fixed point set. -/
theorem cor4_6_6 (g h : SL(2, ℂ)) (hg : IsLoxodromicFK g) (hh : IsLoxodromicFK h)
    (hcomm : mobiusSL g ∘ mobiusSL h = mobiusSL h ∘ mobiusSL g) : mobiusFixSet g = mobiusFixSet h := by
  sorry

/-- **Theorem IV.6.7** (Ch. IV §6.7). Let `M` be a Riemann surface with `π₁(M) ≅ ℤ ⊕ ℤ`; then the holomorphic
universal covering space of `M` is `ℂ`. -/
theorem thm4_6_7 (x₀ : M) (h : Nonempty (FundamentalGroup M x₀ ≃* Multiplicative ℤ × Multiplicative ℤ)) :
    ∃ p : ℂ → M, Forster1981.IsUniversalCovering p ∧ MDifferentiable 𝓘(ℂ) 𝓘(ℂ) p := by
  sorry

/-- **Theorem IV.6.8** (Ch. IV §6.8). Let `M` be a Riemann surface with holomorphic universal covering space `U`.
Then `M ≅ Δ`, `Δ*`, or `Δ_r`, provided `π₁(M)` is commutative. -/
theorem thm4_6_8 {p : ↥upperHalfPlaneOpens → M} (hp : Forster1981.IsUniversalCovering p)
    (hpa : MDifferentiable 𝓘(ℂ) 𝓘(ℂ) p) (x₀ : M) (hc : ∀ a b : FundamentalGroup M x₀, a * b = b * a) :
    RSConformallyEquivalent M ↥Forster1981.unitDiscOpen ∨ RSConformallyEquivalent M ↥Forster1981.punctUnitDisc ∨
      ∃ r : ℝ, 0 < r ∧ r < 1 ∧ RSConformallyEquivalent M ↥(annulusOpens r) := by
  sorry

/-- **Theorem IV.6.9** (Ch. IV §6.9). Let `D` be a domain in `ℂ ∪ {∞}` such that `(ℂ ∪ {∞}) ∖ D` consists of two
components. Then `D ≅ ℂ*`, `Δ*`, or `Δ_r`.
Modelling: the complement has exactly two connected components (`Nat.card = 2`). -/
theorem thm4_6_9 {D : Set RiemannSphere} (hD : IsOpen D) (hc : IsConnected D)
    (h2 : Nat.card (ConnectedComponents ↥Dᶜ) = 2) :
    RSConformallyEquivalent (⟨D, hD⟩ : TopologicalSpace.Opens RiemannSphere) ↥Forster1981.punctPlane ∨
      RSConformallyEquivalent (⟨D, hD⟩ : TopologicalSpace.Opens RiemannSphere) ↥Forster1981.punctUnitDisc ∨
      ∃ r : ℝ, 0 < r ∧ r < 1 ∧
        RSConformallyEquivalent (⟨D, hD⟩ : TopologicalSpace.Opens RiemannSphere) ↥(annulusOpens r) := by
  sorry

end FarkasKra1992
