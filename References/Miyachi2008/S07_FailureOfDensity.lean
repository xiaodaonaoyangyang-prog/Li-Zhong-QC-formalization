import References.Miyachi2008.S04_QuasiregularExtension

/-!
# Miyachi 2008, §7: Failure of density

H. Miyachi, *Image of asymptotic Bers map*, J. Math. Soc. Japan **60** (2008), 1255–1276; journal pages `p. n`.
Conventions: as in `S02_AsymptoticBersMap` (half-plane model: `D*` is `𝕃`, `Γ = 1` is `⊥`). A Riemann mapping `h : D* → Ω` is any
`h` with `IsUnivMero h lowerHalf` and `meroToExt h '' lowerHalf = Ω`; its Schwarzian derivative is the form `φ ∈ B(1)` equal to
`𝒮(h)` on `𝕃` (extended by `0`; the form belongs to `B(1)` by the Nehari–Kraus theorem). All statements hold for every Riemann
mapping (two differ by a Möbius transformation of `𝕃`, which preserves `B(1)`, `B₀(1)`, `𝒯₁` and the norms).

* Definition (the spiral curves `β`, `γ` and the spiral domain `Ω_Geh = Ĉ ∖ γ`, `a ∈ (0, 1/8π)`, p. 1267) — `spiralBeta`, `spiralGamma`, `spiralDomain`
* Definition (the group `RF` of similarities generated by `z ↦ 4 − z̄` and `z ↦ −4 − z̄`, `H₋₁` and the domain `Ω_∞`, p. 1269) — `rfMaps`, `halfPlaneM1`, `omegaInf`
* Proposition 7.1 (the asymptotic class of `φ_Geh` is in the Bers boundary of `𝒜𝒯₁`, p. 1268) — `prop7_1`
* Proposition 7.2 (a point not in the closure, `a ∈ (0, 1/8π)`, p. 1269) — `prop7_2`
* Theorem 2 (failure of density, p. 1259) — `thm2`

Omitted (U−): Lemma 7.1 (the Gehring estimate for the domains `D₀ = {|Re z| < 2, Im z > −1}`, `Ω₀ = D₀ ∖ γ`, p. 1270; a step in the
proof of Proposition 7.2), Gehring's own theorem that `φ_Geh ∉ cl(𝒯₁)` (quoted from [11]).
Reading: "the Bers boundary" of Proposition 7.1 is read as stated by the proof (p. 1268): `[φ_Geh]` is in the closure of `𝒜𝒯₁` in `B̂(1)`
and not in `𝒜𝒯₁` (Theorem 1 and the approximation `f_ε = T₀^{1−ε}`).
-/

open Complex Set Metric Filter Topology MeasureTheory
open scoped ENNReal NNReal Real ComplexConjugate

noncomputable section

namespace Miyachi2008

open LiZhongQC (lowerHalf toExt ExtPlane meroToExt schwarzian IsUnivMero)
open GardinerLakic2000 (cuspFormsL)

/-- **The spiral curves** (p. 1267). For `a > 0`, `β = {z = ±i e^{(−a + i)t} | t ∈ ℝ} ∪ {0, ∞}` (here without `∞`, which is not a point
of `ℂ`) and `γ = β ∩ {|z| ≤ 1}`. -/
def spiralBeta (a : ℝ) : Set ℂ :=
  {z | ∃ t : ℝ, z = I * Complex.exp ((-(a : ℂ) + I) * t) ∨ z = -I * Complex.exp ((-(a : ℂ) + I) * t)} ∪ {0}

/-- **The curve `γ = β ∩ {|z| ≤ 1}`** (p. 1267). -/
def spiralGamma (a : ℝ) : Set ℂ := spiralBeta a ∩ {z | ‖z‖ ≤ 1}

/-- **Gehring's spiral domain `Ω_Geh = Ĉ ∖ γ`** (p. 1267). -/
def spiralDomain (a : ℝ) : Set ExtPlane := (toExt (spiralGamma a))ᶜ

/-- **The group `RF`** (p. 1269). The discrete group of similarities generated by the two reflections `z ↦ 4 − z̄` and `z ↦ −4 − z̄`;
their product is the translation `z ↦ z + 8`, so `RF = {z ↦ z + 8k} ∪ {z ↦ 4 − z̄ + 8k : k ∈ ℤ}`. -/
def rfMaps : Set (ℂ → ℂ) :=
  {T | ∃ k : ℤ, T = (fun z : ℂ => z + 8 * (k : ℂ)) ∨ T = (fun z : ℂ => 4 - conj z + 8 * (k : ℂ))}

/-- **The half-plane `H₋₁ = {z ∈ ℂ | Im z > −1}`** (p. 1269). -/
def halfPlaneM1 : Set ℂ := {z | -1 < z.im}

/-- **The domain `Ω_∞ = H₋₁ ∖ ⋃_{T ∈ RF} T(γ)`** (p. 1269), for the spiral `γ` with parameter `a`. -/
def omegaInf (a : ℝ) : Set ℂ := halfPlaneM1 \ ⋃ T ∈ rfMaps, T '' spiralGamma a

/-- **Proposition 7.1** (p. 1268). Let `0 < a < 1/8π` and let `φ_Geh` be the Schwarzian derivative of a Riemann mapping of Gehring's
spiral domain `Ω_Geh` from `D*`. The asymptotic class `[φ_Geh]` is in the closure of `𝒜𝒯₁` in `B̂(1)` but not in `𝒜𝒯₁`, i.e. in the
Bers boundary `∂_b 𝒜𝒯₁`. -/
theorem prop7_1 {a : ℝ} (ha : 0 < a) (ha' : a < 1 / (8 * Real.pi)) {F : ℂ → ℂ} (hF : IsUnivMero F lowerHalf)
    (hΩ : meroToExt F '' lowerHalf = spiralDomain a) :
    ∃ φ : ℂ → ℂ, ∃ h : φ ∈ cuspFormsL ⊥, (∀ z ∈ lowerHalf, φ z = schwarzian F z) ∧
      bHatMk ⊥ φ h ∈ hatClosure ⊥ (asymBersImage ⊥) ∧ bHatMk ⊥ φ h ∉ asymBersImage ⊥ := by
  sorry

/-- **Proposition 7.2** (p. 1269). When `a ∈ (0, 1/8π)`, the asymptotic class `[φ_∞]` of `φ_∞`, the Schwarzian derivative of the
Riemann mapping of `Ω_∞` from `D*`, is not in the closure `cl(𝒜𝒯₁)` of `𝒜𝒯₁` in `B̂(1)`. -/
theorem prop7_2 {a : ℝ} (ha : 0 < a) (ha' : a < 1 / (8 * Real.pi)) {F : ℂ → ℂ} (hF : IsUnivMero F lowerHalf)
    (hΩ : meroToExt F '' lowerHalf = toExt (omegaInf a)) :
    ∃ φ : ℂ → ℂ, ∃ h : φ ∈ cuspFormsL ⊥, (∀ z ∈ lowerHalf, φ z = schwarzian F z) ∧
      bHatMk ⊥ φ h ∉ hatClosure ⊥ (asymBersImage ⊥) := by
  sorry

/-- **Theorem 2** (failure of density; p. 1259). There is `φ_∞ ∈ S(1)` (the Schwarzian derivative of a univalent function on `D*`)
with `[φ_∞] ∉ cl(𝒜𝒯₁)`. -/
theorem thm2 :
    ∃ f : ℂ → ℂ, IsUnivMero f lowerHalf ∧ ∃ φ : ℂ → ℂ, ∃ h : φ ∈ cuspFormsL ⊥,
      (∀ z ∈ lowerHalf, φ z = schwarzian f z) ∧ bHatMk ⊥ φ h ∉ hatClosure ⊥ (asymBersImage ⊥) := by
  sorry

end Miyachi2008
