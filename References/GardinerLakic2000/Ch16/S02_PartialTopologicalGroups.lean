import References.GardinerLakic2000.Ch16.S01_QuasisymmetricHomeomorphisms

/-!
# Gardiner–Lakic 2000, Ch. 16 §16.2 Partial topological groups

Source `teichmuller.txt`, lines 11965–12009 (Chapter 16, §16.2).

* Definition 1 (partial topological group, l. 11966) — `IsPartialTopGroupSystem`
* Definition (left and right neighbourhood systems of a point, l. 11968) — `nbhdFilterOne`, `leftNbhdFilter`,
  `rightNbhdFilter`
* Definition 2 (topological group, l. 11970) — exists: `IsTopologicalGroup` `T2Space` (Mathlib; the book's continuity
  of `(f, g) ↦ f ∘ g⁻¹` is equivalent to Mathlib's continuity of multiplication and inversion)
* Lemma 1 (l. 11972) — `lemma16_1`
* Definition (the characteristic topological subgroup, l. 11996) — `charTopSubgroupSet`
* Lemma 2 (l. 12000) — `lemma16_2`

Not items: "closed for one topology iff for the other" for inverse-invariant sets (l. 11998, U−). Modelling (E0.3):
generic definitions for a group `G` with a family `N` of subsets (the neighbourhoods of the identity); "system" is
read as a filter base (the book's `U(ε)` are nested). The neighbourhood filter at `1` is the filter generated by `N`,
the left (right) filter at `g` is its image under `x ↦ g x` (`x ↦ x g`). In Lemma 1 (i), "a topological group with
the given neighbourhood system" is a Hausdorff group topology whose neighbourhood filter at `1` is generated by `N`;
(iii) is continuity at `1` of `f ↦ h f h⁻¹` for these filters. The characteristic subgroup consists of the `h` for
which conjugation by `h` and by `h⁻¹` is continuous at `1` (both neighbourhood systems at `h` agree). Lemma 2's
"closed" fails in this generality and is not stated [CORRECTION, see `lemma16_2`].
-/

open Complex Set Metric Filter Topology MeasureTheory
open scoped ENNReal NNReal Real ComplexConjugate ContDiff Manifold Pointwise

noncomputable section

namespace GardinerLakic2000

variable {G : Type*} [Group G]

/-- **Definition 1** (partial topological group, §16.2, l. 11966). `N` is a Hausdorff system of neighbourhoods of the
identity with (a) for every `U` some `V` with `V V ⊆ U` and (b) for every `U` some `V` with `V⁻¹ ⊆ U`. -/
def IsPartialTopGroupSystem (N : Set (Set G)) : Prop :=
  N.Nonempty ∧ (∀ U ∈ N, (1 : G) ∈ U) ∧ (∀ U ∈ N, ∀ V ∈ N, ∃ W ∈ N, W ⊆ U ∩ V) ∧ ⋂₀ N = {1} ∧
    (∀ U ∈ N, ∃ V ∈ N, V * V ⊆ U) ∧ ∀ U ∈ N, ∃ V ∈ N, V⁻¹ ⊆ U

/-- Helper (§16.2). The neighbourhood filter of the identity generated by `N`. -/
def nbhdFilterOne (N : Set (Set G)) : Filter G := ⨅ U ∈ N, 𝓟 U

/-- **Definition** (left neighbourhoods of `h`, §16.2, l. 11968). The filter generated by the `h ∘ U`, `U ∈ N`. -/
def leftNbhdFilter (N : Set (Set G)) (h : G) : Filter G := map (fun x => h * x) (nbhdFilterOne N)

/-- **Definition** (right neighbourhoods of `h`, §16.2, l. 11968). The filter generated by the `U ∘ h`, `U ∈ N`. -/
def rightNbhdFilter (N : Set (Set G)) (h : G) : Filter G := map (fun x => x * h) (nbhdFilterOne N)

/-- **Lemma 1** (§16.2, l. 11972). For a partial topological group the following are equivalent: (i) it is a topological
group with the given neighbourhood system of the identity; (ii) the left and right neighbourhood systems agree at
every point; (iii) `f ↦ h f h⁻¹` is continuous at the identity for every `h`. -/
theorem lemma16_1 {N : Set (Set G)} (hN : IsPartialTopGroupSystem N) :
    List.TFAE [∃ t : TopologicalSpace G, @IsTopologicalGroup G t _ ∧ @T2Space G t ∧
        @nhds G t 1 = nbhdFilterOne N,
      ∀ h : G, leftNbhdFilter N h = rightNbhdFilter N h,
      ∀ h : G, Tendsto (fun f => h * f * h⁻¹) (nbhdFilterOne N) (nbhdFilterOne N)] := by
  obtain ⟨hne, h1, hdir, hT2, hmul, hinv⟩ := hN
  -- `N` is a basis of the filter it generates
  have hbasis : (nbhdFilterOne N).HasBasis (fun U => U ∈ N) fun U => U :=
    hasBasis_biInf_principal' (fun U hU V hV => by
      obtain ⟨W, hW, hWUV⟩ := hdir U hU V hV
      exact ⟨W, hW, hWUV.trans inter_subset_left, hWUV.trans inter_subset_right⟩) hne
  tfae_have 1 → 3 := by
    rintro ⟨t, htg, -, hnhds⟩ h
    let _i : TopologicalSpace G := t
    rw [← hnhds]
    have hc : Continuous fun f : G => h * f * h⁻¹ := (continuous_const.mul continuous_id).mul continuous_const
    simpa using hc.tendsto 1
  tfae_have 3 → 2 := by
    intro h3 h
    apply le_antisymm
    · -- `h * f = (h f h⁻¹) * h`
      have e : (fun x => h * x) = (fun x => x * h) ∘ fun f => h * f * h⁻¹ := by
        funext f
        simp [mul_assoc]
      show map (fun x => h * x) (nbhdFilterOne N) ≤ map (fun x => x * h) (nbhdFilterOne N)
      rw [e, ← map_map]
      exact map_mono (h3 h)
    · -- `f * h = h * (h⁻¹ f h)`
      have e : (fun x => x * h) = (fun x => h * x) ∘ fun f => h⁻¹ * f * h⁻¹⁻¹ := by
        funext f
        simp [mul_assoc]
      show map (fun x => x * h) (nbhdFilterOne N) ≤ map (fun x => h * x) (nbhdFilterOne N)
      rw [e, ← map_map]
      exact map_mono (h3 h⁻¹)
  tfae_have 2 → 3 := by
    intro h2 h
    have e : (fun f => h * f * h⁻¹) = (fun x => x * h⁻¹) ∘ fun x => h * x := by
      funext f
      rfl
    have h2h : map (fun x => h * x) (nbhdFilterOne N) = map (fun x => x * h) (nbhdFilterOne N) := h2 h
    have e2 : ((fun x => x * h⁻¹) ∘ fun x => x * h) = id := by
      funext f
      simp
    show map (fun f => h * f * h⁻¹) (nbhdFilterOne N) ≤ nbhdFilterOne N
    rw [e, ← map_map, h2h, map_map, e2, map_id]
  tfae_have 3 → 1 := by
    intro h3
    let B : GroupFilterBasis G :=
      { sets := N
        nonempty := hne
        inter_sets := fun {U V} hU hV => hdir U hU V hV
        one' := fun {U} hU => h1 U hU
        mul' := fun {U} hU => hmul U hU
        inv' := fun {U} hU => by
          obtain ⟨V, hV, hVU⟩ := hinv U hU
          exact ⟨V, hV, fun x hx => hVU (Set.mem_inv.2 (by rwa [inv_inv]))⟩
        conj' := fun x₀ {U} hU => by
          have hU' : U ∈ nbhdFilterOne N := hbasis.mem_of_mem hU
          obtain ⟨V, hV, hVU⟩ := hbasis.mem_iff.1 (h3 x₀ hU')
          exact ⟨V, hV, hVU⟩ }
    refine ⟨B.topology, B.isTopologicalGroup, (@GroupFilterBasis.t2Space_iff G _ B.topology B rfl).2 hT2, ?_⟩
    rw [B.nhds_one_eq]
    ext U
    rw [FilterBasis.mem_filter_iff, hbasis.mem_iff]
    rfl
  tfae_finish

/-- **Definition** (the characteristic topological subgroup, §16.2, l. 11996). The `h` for which conjugation by `h`
maps the neighbourhood system of the identity onto itself (continuity at `1` of conjugation by `h` and by `h⁻¹`). -/
def charTopSubgroupSet (N : Set (Set G)) : Set G :=
  {h | Tendsto (fun f => h * f * h⁻¹) (nbhdFilterOne N) (nbhdFilterOne N) ∧
    Tendsto (fun f => h⁻¹ * f * h) (nbhdFilterOne N) (nbhdFilterOne N)}

/-- **Lemma 2** (§16.2, l. 12000). The characteristic topological subgroup is a topological subgroup: a subgroup on
which the left and right neighbourhood systems agree. **[CORRECTION]** The printed "closed" is false for general
partial topological groups: in `Equiv.Perm ℝ` with `U_ε = {f | ∀ x, |f x − x| < ε}` the subgroup is the set of `g`
with `g`, `g⁻¹` uniformly continuous, and the piecewise-linear `h₀` with slope `1/k` on `[3k, 3k + 1]` (`1`
elsewhere) is a uniform limit of bi-Lipschitz maps but `h₀⁻¹` is not uniformly continuous. The book's proof shows
that the set of `h` with conjugation by `h` continuous at `1` is right-closed; in QS that set (the symmetric maps,
§16.3) is closed under inversion, so the book's later use is unaffected. -/
theorem lemma16_2 {N : Set (Set G)} (hN : IsPartialTopGroupSystem N) :
    (1 : G) ∈ charTopSubgroupSet N ∧
    (∀ a ∈ charTopSubgroupSet N, ∀ b ∈ charTopSubgroupSet N, a * b ∈ charTopSubgroupSet N) ∧
    (∀ a ∈ charTopSubgroupSet N, a⁻¹ ∈ charTopSubgroupSet N) ∧
    ∀ h ∈ charTopSubgroupSet N, leftNbhdFilter N h = rightNbhdFilter N h := by
  -- the partial-group axioms are not needed: all four claims are algebra of the conjugation limits
  have _hN := hN
  refine ⟨⟨?_, ?_⟩, ?_, ?_, ?_⟩
  · have e : (fun f : G => 1 * f * (1 : G)⁻¹) = id := by
      funext f
      simp
    rw [e]
    exact tendsto_id
  · have e : (fun f : G => (1 : G)⁻¹ * f * 1) = id := by
      funext f
      simp
    rw [e]
    exact tendsto_id
  · -- conjugation by `a b` is conjugation by `b` followed by conjugation by `a`
    rintro a ⟨ha₁, ha₂⟩ b ⟨hb₁, hb₂⟩
    refine ⟨?_, ?_⟩
    · have e : (fun f : G => a * b * f * (a * b)⁻¹) = (fun f => a * f * a⁻¹) ∘ fun f => b * f * b⁻¹ := by
        funext f
        simp [mul_assoc]
      rw [e]
      exact ha₁.comp hb₁
    · have e : (fun f : G => (a * b)⁻¹ * f * (a * b)) = (fun f => b⁻¹ * f * b) ∘ fun f => a⁻¹ * f * a := by
        funext f
        simp [mul_assoc]
      rw [e]
      exact hb₂.comp ha₂
  · -- the two conditions are exchanged by `a ↦ a⁻¹`
    rintro a ⟨ha₁, ha₂⟩
    refine ⟨?_, ?_⟩
    · simpa only [inv_inv] using ha₂
    · simpa only [inv_inv] using ha₁
  · -- `h x = (h x h⁻¹) h` and `x h = h (h⁻¹ x h)` (the step `3 → 2` of `lemma16_1`)
    rintro h ⟨hh₁, hh₂⟩
    apply le_antisymm
    · have e : (fun x => h * x) = (fun x => x * h) ∘ fun f => h * f * h⁻¹ := by
        funext f
        simp [mul_assoc]
      show map (fun x => h * x) (nbhdFilterOne N) ≤ map (fun x => x * h) (nbhdFilterOne N)
      rw [e, ← map_map]
      exact map_mono hh₁
    · have e : (fun x => x * h) = (fun x => h * x) ∘ fun f => h⁻¹ * f * h := by
        funext f
        simp [mul_assoc]
      show map (fun x => x * h) (nbhdFilterOne N) ≤ map (fun x => h * x) (nbhdFilterOne N)
      rw [e, ← map_map]
      exact map_mono hh₂

end GardinerLakic2000
