open Complex Set Metric Filter Topology MeasureTheory
open scoped ENNReal NNReal Real ComplexConjugate ContDiff Manifold

noncomputable section

namespace GardinerLakic2000

open LiZhongQC (IsHyperbolic translationLength attractingFixedPoint repellingFixedPoint IsFuchsian ExtPlane)

/-- **Formula (10.3)** (§10.2, l. 7978). For hyperbolic `A`, `cosh(ℓ(A)/2) = |trace A|/2`. -/
theorem eq10_3 {A : Matrix.SpecialLinearGroup (Fin 2) ℝ} (hA : IsHyperbolic A) :
    Real.cosh (translationLength A / 2) = |A 0 0 + A 1 1| / 2 := by
  have hA' : 2 < |LiZhongQC.slTrace A| := hA
  have h4 : 0 ≤ LiZhongQC.slTrace A ^ 2 - 4 := by
    nlinarith [sq_abs (LiZhongQC.slTrace A), abs_nonneg (LiZhongQC.slTrace A)]
  rw [LiZhongQC.translationLength_eq_arsinh h4, mul_div_cancel_left₀ _ two_ne_zero, Real.cosh_arsinh, div_pow,
    Real.sq_sqrt h4]
  have e : 1 + (LiZhongQC.slTrace A ^ 2 - 4) / 2 ^ 2 = (|LiZhongQC.slTrace A| / 2) ^ 2 := by
    rw [div_pow, sq_abs]; ring
  rw [e, Real.sqrt_sq (by positivity)]
  rfl

/-- **Definition** (normalized position, §10.2, l. 7993). `A₁ = ±diag(m, m⁻¹)` with `m > 1` (attracting fixed point
`∞`, repelling `0`) and `A₂` has attracting fixed point `1` and repelling fixed point `x₁ < 0`. -/
def IsNormalizedPair (A₁ A₂ : Matrix.SpecialLinearGroup (Fin 2) ℝ) : Prop :=
  (∃ m : ℝ, 1 < m ∧ ((A₁ 0 0 = m ∧ A₁ 1 1 = m⁻¹) ∨ (A₁ 0 0 = -m ∧ A₁ 1 1 = -m⁻¹)) ∧ A₁ 0 1 = 0 ∧ A₁ 1 0 = 0) ∧
    IsHyperbolic A₂ ∧ attractingFixedPoint A₂ = ((1 : ℂ) : ExtPlane) ∧
    ∃ x₁ : ℝ, x₁ < 0 ∧ repellingFixedPoint A₂ = ((x₁ : ℂ) : ExtPlane)

/-- Helper (§10.2). The absolute traces `|trace w(A)|` of the words `w ∈ S₀` in the elements `A₁, …, Aₙ`. -/
def absTraceVec {n : ℕ} (A : Fin n → Matrix.SpecialLinearGroup (Fin 2) ℝ) (S₀ : Finset (FreeGroup (Fin n))) :
    S₀ → ℝ :=
  fun w => |(FreeGroup.lift A w.1) 0 0 + (FreeGroup.lift A w.1) 1 1|

/-- **Definition** (moduli set, §10.2, Remark l. 7988). `S₀` is a moduli set for the normalized generators `A`: near
the trace vector of `A` there are real analytic functions `F` of the absolute traces of the words in `S₀` such that
every normalized tuple `B` with nearby traces satisfies `B_j = ±F_j(|trace w(B)| : w ∈ S₀)`. -/
def IsModuliSet {n : ℕ} (A : Fin (n + 2) → Matrix.SpecialLinearGroup (Fin 2) ℝ)
    (S₀ : Finset (FreeGroup (Fin (n + 2)))) : Prop :=
  ∃ U ∈ 𝓝 (absTraceVec A S₀), ∃ F : Fin (n + 2) → Fin 2 → Fin 2 → (S₀ → ℝ) → ℝ,
    (∀ j i k, AnalyticOnNhd ℝ (F j i k) U) ∧
    ∀ B : Fin (n + 2) → Matrix.SpecialLinearGroup (Fin 2) ℝ, IsNormalizedPair (B 0) (B 1) → absTraceVec B S₀ ∈ U →
      ∀ j, (∀ i k, B j i k = F j i k (absTraceVec B S₀)) ∨ ∀ i k, B j i k = -F j i k (absTraceVec B S₀)

/-- **Theorem 2** (§10.2, l. 7984). Let `Γ` be a Fuchsian group generated by `A₁, …, Aₙ`, `A₁`, `A₂` hyperbolic with
crossing axes (read as: some `D` puts the pair in normalized position). Then the `D A_j D⁻¹` are real analytic
functions of the absolute traces of finitely many words: there is a finite moduli set. -/
theorem thm10_2 {n : ℕ} (A : Fin (n + 2) → Matrix.SpecialLinearGroup (Fin 2) ℝ)
    (hΓ : IsFuchsian (Subgroup.closure (range A))) (D : Matrix.SpecialLinearGroup (Fin 2) ℝ)
    (hD : IsNormalizedPair (D * A 0 * D⁻¹) (D * A 1 * D⁻¹)) :
    ∃ S₀ : Finset (FreeGroup (Fin (n + 2))), IsModuliSet (fun j => D * A j * D⁻¹) S₀ := by
  sorry

/-- **Corollary 1** (§10.2, l. 7991). Let `α` be an isomorphism of `Γ = ⟨A₁, …, Aₙ⟩` onto a Fuchsian group `Γ′`,
`A_j ↦ B_j`, preserving the crossing of the axes of `A₁`, `A₂`, and with `|trace A| = |trace α(A)|` for every `A` in a
moduli set `S₀`. Then `α(A) = D A D⁻¹` (in PSL(2,ℝ), i.e. up to sign) for a Möbius transformation `D`. -/
theorem cor10_2_1 {n : ℕ} (A B : Fin (n + 2) → Matrix.SpecialLinearGroup (Fin 2) ℝ)
    (hΓ : IsFuchsian (Subgroup.closure (range A))) (hΓ' : IsFuchsian (Subgroup.closure (range B)))
    (α : Subgroup.closure (range A) ≃* Subgroup.closure (range B))
    (hα : ∀ j (h : A j ∈ Subgroup.closure (range A)), (α ⟨A j, h⟩ : Matrix.SpecialLinearGroup (Fin 2) ℝ) = B j)
    (D₁ D₂ : Matrix.SpecialLinearGroup (Fin 2) ℝ)
    (hD₁ : IsNormalizedPair (D₁ * A 0 * D₁⁻¹) (D₁ * A 1 * D₁⁻¹))
    (hD₂ : IsNormalizedPair (D₂ * B 0 * D₂⁻¹) (D₂ * B 1 * D₂⁻¹))
    (S₀ : Finset (FreeGroup (Fin (n + 2)))) (hS₀ : IsModuliSet (fun j => D₁ * A j * D₁⁻¹) S₀)
    (htr : absTraceVec A S₀ = absTraceVec B S₀) :
    ∃ D : Matrix.SpecialLinearGroup (Fin 2) ℝ, ∀ γ : Subgroup.closure (range A),
      (α γ : Matrix.SpecialLinearGroup (Fin 2) ℝ) = D * γ * D⁻¹ ∨
        (α γ : Matrix.SpecialLinearGroup (Fin 2) ℝ) = -(D * γ * D⁻¹) := by
  sorry

end GardinerLakic2000
