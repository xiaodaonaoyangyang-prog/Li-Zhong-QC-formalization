import References.GardinerLakic2000.Ch09.S05_InfinitesimalTeichmullerUniqueness

/-!
# Gardiner–Lakic 2000, Ch. 9 §9.6 Unique holomorphic motions

Source `teichmuller.txt`, lines 7841–7862 (Chapter 9, §9.6).

* Definition (the canonical holomorphic motion generated by `μ`, l. 7842) — `IsCanonicalHolMotion`
* Definition (uniquely extremal for the equivalence of `T(Ω)`, `Ω = ℂ̄ ∖ Λ`, l. 7857) — `IsUniquelyExtremalOpen`
* Theorem 7 (l. 7857) — `thm9_7`

Not items: the parametrization of holomorphic motions of `Λ` by `T(Ω) × M(Λ)` (l. 7842, U−, not cited); the closing
paragraph on sets with empty interior (l. 7861, U−; Exercise 9). Modelling: `Λ ⊆ ℂ` is closed and contains `0` and
`1` (with `∞` fixed implicitly, as batch A's holomorphic motions); `μ ∈ M(Ω)` is a Beltrami coefficient of the plane
vanishing on `Λ`; the canonical motion is `h_t(z) = f^{tμ/‖μ‖∞}(z)` on `Λ` (A: `IsHolMotion`,
`LiZhongQC.normalizedSolution`). Two coefficients of `M(Ω)` are equivalent in `T(Ω)` when their normalized solutions
agree on `Λ` [reading of the equivalence of `T(Ω)` for an open set].
-/

open Complex Set Metric Filter Topology MeasureTheory
open scoped ENNReal NNReal Real ComplexConjugate ContDiff Manifold

noncomputable section

open scoped Classical

namespace GardinerLakic2000

open LiZhongQC (IsBeltramiCoeff normalizedSolution)

/-- **Definition** (canonical holomorphic motion, §9.6, l. 7842). `h_t` is the restriction to `Λ` of the normalized
solution with Beltrami coefficient `t μ/‖μ‖∞ χ_Ω`, `|t| < 1`. -/
def IsCanonicalHolMotion (Λ : Set ℂ) (μ : ℂ → ℂ) (h : ℂ → ℂ → ℂ) : Prop :=
  ∀ t : ℂ, ‖t‖ < 1 → ∀ z ∈ Λ,
    h t z = normalizedSolution (fun w => if w ∈ Λ then 0 else t / ((eLpNorm μ ⊤ volume).toReal : ℂ) * μ w) z

/-- **Definition** (§9.6, l. 7857). `μ ∈ M(Ω)` is uniquely extremal for the equivalence defining `T(Ω)`: every `ν ∈
M(Ω)` whose normalized solution agrees with that of `μ` on `Λ` and with `‖ν‖∞ ≤ ‖μ‖∞` equals `μ` almost everywhere. -/
def IsUniquelyExtremalOpen (Λ : Set ℂ) (μ : ℂ → ℂ) : Prop :=
  (∃ k : ℝ, k < 1 ∧ IsBeltramiCoeff μ univ k) ∧ (∀ z ∈ Λ, μ z = 0) ∧
    ∀ ν : ℂ → ℂ, (∃ k : ℝ, k < 1 ∧ IsBeltramiCoeff ν univ k) → (∀ z ∈ Λ, ν z = 0) →
      (∀ z ∈ Λ, normalizedSolution ν z = normalizedSolution μ z) → eLpNorm ν ⊤ volume ≤ eLpNorm μ ⊤ volume →
        ν =ᵐ[volume] μ

/-- **Theorem 7** (§9.6, l. 7857). If the canonical holomorphic motion `h_t` of the closed set `Λ` is generated by a
Beltrami coefficient `μ` uniquely extremal for the equivalence of `T(Ω)`, `Ω = ℂ̄ ∖ Λ`, then `h_t` has a unique
extension to a holomorphic motion of `ℂ̄`. -/
theorem thm9_7 {Λ : Set ℂ} (hΛ : IsClosed Λ) (h0 : (0 : ℂ) ∈ Λ) (h1 : (1 : ℂ) ∈ Λ) {μ : ℂ → ℂ}
    (hμ0 : ¬ μ =ᵐ[volume] 0) (hμ : IsUniquelyExtremalOpen Λ μ) {h : ℂ → ℂ → ℂ} (hh : IsCanonicalHolMotion Λ μ h) :
    ∀ H₁ H₂ : ℂ → ℂ → ℂ, IsHolMotion univ H₁ → IsHolMotion univ H₂ →
      (∀ t : ℂ, ‖t‖ < 1 → ∀ z ∈ Λ, H₁ t z = h t z) → (∀ t : ℂ, ‖t‖ < 1 → ∀ z ∈ Λ, H₂ t z = h t z) →
        ∀ t : ℂ, ‖t‖ < 1 → ∀ z, H₁ t z = H₂ t z := by
  sorry

end GardinerLakic2000
