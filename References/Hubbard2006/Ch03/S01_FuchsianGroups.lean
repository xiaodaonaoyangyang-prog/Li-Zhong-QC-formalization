import References.Common.HyperbolicSurface

/-!
# Hubbard 2006, Chapter 3 §3.1: Fuchsian groups

Source: Hubbard, *Teichmüller Theory*, Vol. 1, `H1` lines 1957–2030.

**Conventions.** A Fuchsian group is a subgroup `Γ ⊆ SL(2, ℝ)` with `LiZhongQC.IsFuchsian Γ` (properly discontinuous on
`ℍ`, which is a discrete subgroup of `Aut ℍ` modulo `±1`). Hubbard's `Γ ⊆ Aut 𝔻` is its image in `PSL(2, ℝ) = SL(2,
ℝ)/{±1}` (`toPSL`); group-theoretic statements (cyclic, finite index) are read in that image. An element is *elliptic*
if `|tr| < 2` (and so `≠ ±1`), *parabolic* if `LiZhongQC.IsParabolic`, *hyperbolic* if `LiZhongQC.IsHyperbolic`.
"Non-elementary" is `References.IsNonElementary` (the limit set has more than two points).

* Notation 3.1.1 (`⟨A⟩`, the subgroup generated by `A`) — omitted: notation (`Subgroup.zpowers`)
* Proposition 3.1.2 (1) (a finite Fuchsian group is cyclic and fixes a point) — `prop3_1_2_a`
* Proposition 3.1.2 (2) (an infinite group of elliptic and parabolic elements is generated by one parabolic) —
  `prop3_1_2_b`
* Proposition 3.1.2 (3) (a hyperbolic element of finite index: cyclic, or index two over a cyclic group) — `prop3_1_2_c`
* Proposition 3.1.2 (4) (otherwise `Γ` is non-elementary and contains a free subgroup of hyperbolic elements) —
  `prop3_1_2_d`
-/

open Set
open LiZhongQC References

namespace Hubbard2006

/-- The group `PSL(2, ℝ) = SL(2, ℝ)/{±1}` (the centre of `SL(2, ℝ)` is `{±1}`). -/
abbrev PSL2R : Type :=
  Matrix.SpecialLinearGroup (Fin 2) ℝ ⧸ Subgroup.center (Matrix.SpecialLinearGroup (Fin 2) ℝ)

/-- The quotient map `SL(2, ℝ) → PSL(2, ℝ)`. -/
abbrev toPSL : Matrix.SpecialLinearGroup (Fin 2) ℝ →* PSL2R :=
  QuotientGroup.mk' (Subgroup.center (Matrix.SpecialLinearGroup (Fin 2) ℝ))

/-- **Proposition 3.1.2 (1)** (Fuchsian groups, Ch. 3 §3.1, H1:1966). If a Fuchsian group `Γ` is finite (in `Aut ℍ`,
i.e. its image in `PSL(2, ℝ)` is finite), then it is cyclic, and all its elements fix a common point of `ℍ` (a cyclic
group of rotations about a point; the generator can be taken to be the rotation by `2π/n`, `n` the order). -/
theorem prop3_1_2_a {Γ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) ℝ)} (hΓ : IsFuchsian Γ)
    (hfin : (Γ.map toPSL : Set PSL2R).Finite) :
    (∃ z₀ : UpperHalfPlane, ∀ h ∈ Γ, h • z₀ = z₀) ∧ IsCyclic (Γ.map toPSL) := by
  sorry

/-- **Proposition 3.1.2 (2)** (Ch. 3 §3.1, H1:1966). If `Γ` is infinite and all its elements are elliptic or parabolic
(`|tr| ≤ 2`), then `Γ` is infinite cyclic, generated by one parabolic element, and contains no elliptic element. -/
theorem prop3_1_2_b {Γ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) ℝ)} (hΓ : IsFuchsian Γ)
    (hinf : (Γ.map toPSL : Set PSL2R).Infinite) (hell : ∀ h ∈ Γ, |slTrace h| ≤ 2) :
    (∃ g ∈ Γ, IsParabolic g ∧ Γ.map toPSL = Subgroup.zpowers (toPSL g)) ∧ ∀ h ∈ Γ, ¬ |slTrace h| < 2 := by
  sorry

/-- **Proposition 3.1.2 (3)** (Ch. 3 §3.1, H1:1966). If `Γ` contains a hyperbolic element `γ` such that `⟨γ⟩` has finite
index in `Γ` (in `Aut ℍ`), then `Γ` is infinite cyclic generated by a hyperbolic element, or has a subgroup of index two
generated by a hyperbolic element. -/
theorem prop3_1_2_c {Γ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) ℝ)} (hΓ : IsFuchsian Γ)
    (h : ∃ γ ∈ Γ, IsHyperbolic γ ∧ (Subgroup.zpowers (toPSL γ)).relIndex (Γ.map toPSL) ≠ 0) :
    ∃ g ∈ Γ, IsHyperbolic g ∧
      ((Subgroup.zpowers (toPSL g)).relIndex (Γ.map toPSL) = 1 ∨
        (Subgroup.zpowers (toPSL g)).relIndex (Γ.map toPSL) = 2) := by
  sorry

/-- **Proposition 3.1.2 (4)** (Ch. 3 §3.1, H1:1966). In all other cases (`Γ` infinite, not consisting of elliptic and
parabolic elements, with no hyperbolic element of finite index) `Γ` is non-elementary and contains a free subgroup on
two generators all of whose non-trivial elements are hyperbolic. -/
theorem prop3_1_2_d {Γ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) ℝ)} (hΓ : IsFuchsian Γ)
    (hinf : (Γ.map toPSL : Set PSL2R).Infinite) (hnell : ∃ h ∈ Γ, 2 < |slTrace h|)
    (hnfin : ∀ γ ∈ Γ, IsHyperbolic γ → (Subgroup.zpowers (toPSL γ)).relIndex (Γ.map toPSL) = 0) :
    IsNonElementary Γ ∧ ∃ φ : FreeGroup (Fin 2) →* Matrix.SpecialLinearGroup (Fin 2) ℝ,
      Function.Injective φ ∧ (∀ w, w ≠ 1 → IsHyperbolic (φ w)) ∧ ∀ w, φ w ∈ Γ := by
  sorry

end Hubbard2006
