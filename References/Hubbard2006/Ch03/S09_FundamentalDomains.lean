open Set Metric Filter
open scoped Manifold ContDiff Topology Real
open LiZhongQC References

namespace Hubbard2006

/-- **Fundamental domain** (Def. 3.9.1, H1:2717). For a group `Γ` acting on a topological space `X`, `U ⊆ X` is a
fundamental domain if the quotient map is injective on `U` (every orbit meets `U` at most once) and surjective from the
closure of `U` (every orbit meets the closure at least once). -/
def IsFundamentalDomainTop (Γ : Type*) {X : Type*} [Group Γ] [TopologicalSpace X] [MulAction Γ X] (U : Set X) : Prop :=
  (∀ x ∈ U, ∀ y ∈ U, (∃ γ : Γ, γ • x = y) → x = y) ∧ ∀ x : X, ∃ γ : Γ, γ • x ∈ closure U

/-- The raw data of a **paired polygon** (Def. 3.9.2): a set `P ⊆ ℍ`, a set `sides` of subsets of `P`, labelled sides `s
i, s' i` for `i ∈ I`, and pairing elements `g i ∈ SL(2, ℝ)`. -/
structure PolygonData (I : Type) where
  /-- the polygon -/
  P : Set UpperHalfPlane
  /-- the sides of the polygon -/
  sides : Set (Set UpperHalfPlane)
  /-- the sides `s i` -/
  s : I → Set UpperHalfPlane
  /-- the sides `s' i` -/
  s' : I → Set UpperHalfPlane
  /-- the pairing elements -/
  g : I → Matrix.SpecialLinearGroup (Fin 2) ℝ

/-- The relation generating `∼`: `x ∼ g_i x` for `x ∈ s_i` (in either direction). -/
def pairingRel {I : Type} (D : PolygonData I) (x y : D.P) : Prop :=
  ∃ i, ((x : UpperHalfPlane) ∈ D.s i ∧ (y : UpperHalfPlane) = D.g i • (x : UpperHalfPlane)) ∨
    ((x : UpperHalfPlane) ∈ D.s' i ∧ (y : UpperHalfPlane) = (D.g i)⁻¹ • (x : UpperHalfPlane))

/-- The surface `X = P/∼` of a paired polygon, with the quotient topology. -/
abbrev polyQuot {I : Type} (D : PolygonData I) : Type := Quot (pairingRel D)

/-- **Paired polygon** (Def. 3.9.2, H1:2758): `P` is a closed, hyperbolically convex set with non-empty interior whose
frontier is the union of the `sides`, each side a closed connected piece of a geodesic line with more than one point;
any compact part of `ℍ` meets only finitely many sides; the sides `s i, s' i` (`i ∈ I`) are `2|I|` distinct sides, all
sides, and `g i` maps `s i` onto `s' i` and the side of `s i` in `P` to the side of `s' i` not in `P` (near each point
of `s' i` the images of the interior of `P` under `g i` and the interior of `P` are disjoint); every equivalence class
of `∼` (a vertex class) is finite. Simple-polygon condition (the book's "polygon": distinct sides are the edges, meeting
at most in a common endpoint): two distinct sides have at most one common point. (For a convex `P` whose frontier is the union
of the sides, a common point of two distinct sides is then an endpoint of both, and at most two sides pass through a point.) -/
def IsPairedPolygon {I : Type} (D : PolygonData I) : Prop :=
  IsClosed D.P ∧ HypConvex D.P ∧ (interior D.P).Nonempty ∧ frontier D.P = ⋃₀ D.sides ∧
    (∀ t ∈ D.sides, IsClosed t ∧ IsConnected t ∧ (∃ a ∈ t, ∃ b ∈ t, a ≠ b) ∧
      ∃ l, IsGeodesicLine l ∧ t ⊆ l) ∧
    (∀ K : Set UpperHalfPlane, IsCompact K → {t ∈ D.sides | (t ∩ K).Nonempty}.Finite) ∧
    (∀ t ∈ D.sides, ∀ t' ∈ D.sides, t ≠ t' → (t ∩ t').encard ≤ 1) ∧
    Function.Injective (Sum.elim D.s D.s') ∧ D.sides = range D.s ∪ range D.s' ∧
    (∀ i, (fun z => D.g i • z) '' D.s i = D.s' i) ∧
    (∀ i, ∀ x ∈ D.s' i, ∃ ε > 0, Disjoint (ball x ε ∩ interior D.P)
      (ball x ε ∩ (fun z => D.g i • z) '' interior D.P)) ∧
    ∀ x : D.P, {y : D.P | (Quot.mk (pairingRel D) y : polyQuot D) = Quot.mk (pairingRel D) x}.Finite

/-- The **chains** from `x` to `y` in `X = P/∼`: finite sequences `a₀, b₀, …, a_n, b_n` of points of `P` with `[a₀] =
x`, `[b_n] = y` and `[b_k] = [a_{k+1}]`. -/
def PolyChain {I : Type} (D : PolygonData I) (x y : polyQuot D) : Type :=
  {c : Σ n : ℕ, (Fin (n + 1) → D.P) × (Fin (n + 1) → D.P) //
    Quot.mk (pairingRel D) (c.2.1 0) = x ∧ Quot.mk (pairingRel D) (c.2.2 (Fin.last c.1)) = y ∧
      ∀ k : Fin c.1, Quot.mk (pairingRel D) (c.2.2 k.castSucc) = Quot.mk (pairingRel D) (c.2.1 k.succ)}

/-- The **quotient metric** of `X = P/∼`: the infimum, over the chains from `x` to `y`, of `∑ d(a_k, b_k)` (hyperbolic
distances in `ℍ`). The set of chains is non-empty (take `n = 0` and lifts of `x`, `y`), so the infimum is not junk. -/
noncomputable def polygonQuotientDist {I : Type} (D : PolygonData I) (x y : polyQuot D) : ℝ :=
  ⨅ c : PolyChain D x y, ∑ k : Fin (c.1.1 + 1), dist (c.1.2.1 k : UpperHalfPlane) (c.1.2.2 k : UpperHalfPlane)

/-- **`X = P/∼` is complete** for the quotient metric: every Cauchy sequence converges. -/
def IsPolygonQuotientComplete {I : Type} (D : PolygonData I) : Prop :=
  ∀ u : ℕ → polyQuot D, (∀ ε > 0, ∃ N, ∀ m ≥ N, ∀ n ≥ N, polygonQuotientDist D (u m) (u n) < ε) →
    ∃ x, ∀ ε > 0, ∃ N, ∀ n ≥ N, polygonQuotientDist D (u n) x < ε

/-- The **vertices** of the polygon: the points lying on two distinct sides. -/
def polygonVertices {I : Type} (D : PolygonData I) : Set UpperHalfPlane :=
  {x | ∃ t ∈ D.sides, ∃ t' ∈ D.sides, t ≠ t' ∧ x ∈ t ∧ x ∈ t'}

/-- **`θ` is the angle `α_x(P)` of the polygon at the vertex `x`** (Thm 3.9.5): the angle at `x` between two distinct
sides through `x` (`Katok1992.hypAngle`, the Euclidean angle between the geodesic rays; `π` for collinear sides). -/
def IsVertexAngle {I : Type} (D : PolygonData I) (x : UpperHalfPlane) (θ : ℝ) : Prop :=
  ∃ t ∈ D.sides, ∃ t' ∈ D.sides, t ≠ t' ∧ x ∈ t ∧ x ∈ t' ∧ ∃ a ∈ t, ∃ b ∈ t', a ≠ x ∧ b ≠ x ∧
    Katok1992.hypAngle x (Katok1992.toExtH a) (Katok1992.toExtH b) = θ

open Classical in
/-- **The angle `α_y(P)`** of the polygon at `y` (Thm 3.9.5, H1:2744–2770), by cases: `2π` at an interior point, the angle of
`IsVertexAngle` at a vertex (a point on two distinct sides; for a paired polygon the set of such angles is a singleton, so its
infimum is the angle), and `π` at a point of exactly one side. -/
noncomputable def polygonAngle {I : Type} (D : PolygonData I) (y : UpperHalfPlane) : ℝ :=
  if y ∈ interior D.P then 2 * π
  else if y ∈ polygonVertices D then sInf {θ | IsVertexAngle D y θ}
  else π

/-- The **sum of the angles over the vertex class** of `x` (Thm 3.9.5, (3.9.2)): `∑_{y ∈ V_x} α_y(P)`, the sum over the
points of `P` identified with `x`, with `α_y(P) = polygonAngle D y`. -/
noncomputable def vertexAngleSum {I : Type} (D : PolygonData I) (x : D.P) : ℝ :=
  ∑ᶠ y ∈ {y : D.P | (Quot.mk (pairingRel D) y : polyQuot D) = Quot.mk (pairingRel D) x},
    polygonAngle D (y : UpperHalfPlane)

/-- **The hypotheses of the Poincaré polygon theorem** (Thm 3.9.5 (1)): `D` is a paired polygon, `X = P/∼` is complete
for the quotient metric, and for every vertex class there is an integer `n ≥ 1` with `∑_{x ∈ V} α_x(P) = 2π/n`. -/
def SatisfiesPoincareHyp {I : Type} (D : PolygonData I) : Prop :=
  IsPairedPolygon D ∧ IsPolygonQuotientComplete D ∧
    ∀ x : D.P, (x : UpperHalfPlane) ∈ polygonVertices D → ∃ n : ℕ, 1 ≤ n ∧ vertexAngleSum D x = 2 * π / n

/-- **Theorem 3.9.5 (1)** (the Poincaré polygon theorem, Ch. 3 §3.9, H1:2764). Let `(P, (g_i))` be a paired polygon such
that `X = P/∼` is complete for the quotient metric and for every vertex class `V_z` there is an integer `n_z ≥ 1` with
`∑_{x ∈ V_z} α_x(P) = 2π/n_z`. Then the group `G = ⟨g_i⟩` generated by the `g_i` is discrete (Fuchsian), and the
interior of `P` is a fundamental domain for `G`. -/
theorem thm3_9_5_a {I : Type} (D : PolygonData I) (h : SatisfiesPoincareHyp D) :
    IsFuchsian (Subgroup.closure (range D.g)) ∧
      IsFundamentalDomainTop (Subgroup.closure (range D.g)) (interior D.P) := by
  sorry

/-- **Schottky data** (Example 3.9.7, H1:2795): `2k` disjoint closed half-planes `H_i, H_i'` of `ℍ` and elements `γ_i`
mapping the boundary of `H_i` onto the boundary of `H_i'` and `H_i` onto the complement `ℍ ∖ H̊_i'` of the interior of
`H_i'`. (Whether the boundaries have a common perpendicular — `γ_i` hyperbolic — or touch at infinity — `γ_i` parabolic
— is not a condition: it follows from disjointness. The statement `prop3_9_8` holds for every such choice of `γ_i`.) -/
def IsSchottkyData {k : ℕ} (H H' : Fin k → Set UpperHalfPlane)
    (γ : Fin k → Matrix.SpecialLinearGroup (Fin 2) ℝ) : Prop :=
  (∀ i, IsClosedHalfPlaneH (H i) ∧ IsClosedHalfPlaneH (H' i)) ∧
    (∀ i j, Disjoint (H i) (H' j)) ∧
    (∀ i j, i ≠ j → Disjoint (H i) (H j) ∧ Disjoint (H' i) (H' j)) ∧
    (∀ i, (fun z => γ i • z) '' frontier (H i) = frontier (H' i)) ∧
    ∀ i, (fun z => γ i • z) '' H i = (interior (H' i))ᶜ

/-- **Schottky group** (Prop. and Def. 3.9.8): the group generated by the `γ_i` of Schottky data. -/
def IsSchottkyGroup (Γ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) ℝ)) : Prop :=
  ∃ (k : ℕ) (H H' : Fin k → Set UpperHalfPlane) (γ : Fin k → Matrix.SpecialLinearGroup (Fin 2) ℝ),
    IsSchottkyData H H' γ ∧ Γ = Subgroup.closure (range γ)

/-- **Proposition 3.9.8** (structure of Schottky groups, Ch. 3 §3.9, H1:2805). For Schottky data, the group `Γ = ⟨γ_1,
…, γ_k⟩` is discrete, free on its generators (`FreeGroup.lift γ` is injective), and the region `U = ℍ ∖ ⋃ (H_i ∪ H_i')`
is a fundamental domain. -/
theorem prop3_9_8 {k : ℕ} {H H' : Fin k → Set UpperHalfPlane} {γ : Fin k → Matrix.SpecialLinearGroup (Fin 2) ℝ}
    (h : IsSchottkyData H H' γ) :
    IsFuchsian (Subgroup.closure (range γ)) ∧ Function.Injective (FreeGroup.lift γ) ∧
      IsFundamentalDomainTop (Subgroup.closure (range γ)) (⋃ i, (H i ∪ H' i))ᶜ := by
  sorry

/-- **`ρ` is the reflection in the geodesic line `l`** (Exercise 3.9.9): an isometry of `ℍ` fixing `l` pointwise, other
than the identity (the unique orientation-reversing isometry fixing `l`). -/
def IsReflectionIn (l : Set UpperHalfPlane) (ρ : UpperHalfPlane ≃ᵢ UpperHalfPlane) : Prop :=
  IsGeodesicLine l ∧ (∀ z ∈ l, ρ z = z) ∧ ρ ≠ IsometryEquiv.refl UpperHalfPlane

/-- The angle `π/p` at a vertex with `p ∈ ℕ ∪ {∞}`: `π/p` for finite `p`, `0` for `p = ∞`. -/
noncomputable def angleOfOrder (p : ℕ∞) : ℝ := if p = ⊤ then 0 else π / (p.toNat : ℝ)

/-- **Proposition 3.9.10** (triangle groups, Ch. 3 §3.9, H1:2823). Let `T` be a hyperbolic triangle with vertices `v i`
and angles `π/p_i`, `p_i ∈ ℕ ∪ {∞}` (`p_i ≥ 2`; angle `0` iff the vertex is ideal), let `r i` be the reflection in the
side opposite `v i`, and let `R i ∈ SL(2, ℝ)` act as `r (i+1) ∘ r (i+2)` (the rotation of angle `2θ_i` around `v i`,
parabolic for an ideal vertex). Then the orientation-preserving subgroup `G = ⟨R_0, R_1, R_2⟩` of the group generated by
the reflections is discrete; `T ∪ ρ_a T` (here the interior of `T ∪ r_0 T`) is a fundamental domain for `G`; and `G` (in
`PSL(2, ℝ)`) has the presentation `⟨R_0, R_1, R_2 | R_i^{p_i}, R_0 R_1 R_2⟩` (relations with `p_i = ∞` omitted).
Modelling: the presentation means that the kernel of `FreeGroup.lift (toPSL ∘ R)` is the normal closure of the powers
`of i ^ p_i` (`p_i` finite) and of `of 0 * of 1 * of 2`.

**Correction** (2026-10-09, leader audit, H1:2823–2833). The book's presentation (3.9.6) lists only the relations
`R_α^p`, `R_β^q`, `R_γ^r`; with `R_i = r_{i+1} r_{i+2}` one has `R_0 R_1 R_2 = r_1 r_2 r_2 r_0 r_0 r_1 = 1`, a relation
that does not follow from the powers (`⟨R_i | R_i^{p_i}⟩` is the free product `ℤ/p * ℤ/q * ℤ/r`, which is not the
triangle group). The relation `R_0 R_1 R_2` is added. Moreover `R_i ∈ SL(2, ℝ)` lifts a rotation of order `p_i` of
`PSL(2, ℝ)`, so `R_i ^ p_i = −I`: the presentation is read in `PSL(2, ℝ)`, through `toPSL ∘ R` (as in `prop3_9_14_b`).
Discreteness and the fundamental domain are stated in `SL(2, ℝ)`. -/
theorem prop3_9_10 (v : Fin 3 → ExtPlane) (p : Fin 3 → ℕ∞) (hp : ∀ i, 2 ≤ p i)
    (Δ : Set UpperHalfPlane) (hΔ : Katok1992.IsHypPolygon Δ v)
    (hθ : ∀ i, Katok1992.polygonAngle v i = angleOfOrder (p i)) (L : Fin 3 → Set UpperHalfPlane)
    (hL : ∀ i, IsGeodesicLine (L i) ∧ v (i + 1) ∈ closure (Katok1992.toExtH '' L i) ∧
      v (i + 2) ∈ closure (Katok1992.toExtH '' L i))
    (r : Fin 3 → UpperHalfPlane ≃ᵢ UpperHalfPlane) (hr : ∀ i, IsReflectionIn (L i) (r i))
    (R : Fin 3 → Matrix.SpecialLinearGroup (Fin 2) ℝ) (hR : ∀ i z, R i • z = r (i + 1) (r (i + 2) z)) :
    IsFuchsian (Subgroup.closure (range R)) ∧
      IsFundamentalDomainTop (Subgroup.closure (range R)) (interior (Δ ∪ r 0 '' Δ)) ∧
      (FreeGroup.lift (fun i => toPSL (R i))).ker =
        Subgroup.normalClosure ({w | ∃ i : Fin 3, ∃ n : ℕ, p i = n ∧ w = FreeGroup.of i ^ n} ∪
          {FreeGroup.of 0 * FreeGroup.of 1 * FreeGroup.of 2}) := by
  sorry

/-- The **modular group** `SL(2, ℤ)` as a subgroup of `SL(2, ℝ)` (its image in `PSL(2, ℝ)` is `PSL₂ℤ`;
`Katok1992.modularGroup`). -/
def sl2Z : Subgroup (Matrix.SpecialLinearGroup (Fin 2) ℝ) :=
  (Matrix.SpecialLinearGroup.map (Int.castRingHom ℝ)).range

/-- **Proposition 3.9.12** (Ford fundamental domain, Ch. 3 §3.9, H1:2869). Let `Γ` be a Fuchsian group containing the
translation `τ : z ↦ z + 1` as a generator of the stabilizer of `∞` (a parabolic that is not a power of another
parabolic), `Γ₀ = ⟨τ⟩` and `U = {|Re z| < 1/2}`. Then `Ω_Γ = U ∩ ⋂_{γ ∈ Γ ∖ Γ₀} E(γ)` is a fundamental domain for `Γ`.
Modelling: `Ω_Γ` is `GardinerLakic2000.fordDomain` for the family of the Möbius maps of `Γ ∖ Γ₀` and `U` (`‖γ′ z‖ < 1`
iff `1 < ‖c z + d‖`, i.e. `z` is exterior to the isometric circle), taken in `ℍ`. -/
theorem prop3_9_12 {Γ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) ℝ)} (hΓ : IsFuchsian Γ)
    {τ : Matrix.SpecialLinearGroup (Fin 2) ℝ} (hτ : τ ∈ Γ) (h00 : τ 0 0 = 1) (h01 : τ 0 1 = 1) (h10 : τ 1 0 = 0)
    (h11 : τ 1 1 = 1) (hstab : ∀ h ∈ Γ, h 1 0 = 0 → ∃ n : ℤ, h = τ ^ n ∨ h = -τ ^ n) :
    IsFundamentalDomainTop Γ {z : UpperHalfPlane | (z : ℂ) ∈ GardinerLakic2000.fordDomain
      {A | ∃ γ ∈ Γ, (¬ ∃ n : ℤ, γ = τ ^ n ∨ γ = -τ ^ n) ∧ A = mobiusFn (γ 0 0) (γ 0 1) (γ 1 0) (γ 1 1)}
      {w : ℂ | |w.re| < 1 / 2}} := by
  sorry

/-- **Proposition 3.9.13** (Ch. 3 §3.9, H1:2899). The Ford fundamental domain of a Fuchsian group `Γ` containing a
parabolic element (normalized as in `prop3_9_12`) is a paired polygon satisfying the hypotheses of the Poincaré polygon
theorem, and the side-pairing elements generate the group (modulo `±1`). -/
theorem prop3_9_13 {Γ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) ℝ)} (hΓ : IsFuchsian Γ)
    {τ : Matrix.SpecialLinearGroup (Fin 2) ℝ} (hτ : τ ∈ Γ) (h00 : τ 0 0 = 1) (h01 : τ 0 1 = 1) (h10 : τ 1 0 = 0)
    (h11 : τ 1 1 = 1) (hstab : ∀ h ∈ Γ, h 1 0 = 0 → ∃ n : ℤ, h = τ ^ n ∨ h = -τ ^ n) :
    ∃ (I : Type) (D : PolygonData I), SatisfiesPoincareHyp D ∧
      D.P = closure {z : UpperHalfPlane | (z : ℂ) ∈ GardinerLakic2000.fordDomain
        {A | ∃ γ ∈ Γ, (¬ ∃ n : ℤ, γ = τ ^ n ∨ γ = -τ ^ n) ∧ A = mobiusFn (γ 0 0) (γ 0 1) (γ 1 0) (γ 1 1)}
        {w : ℂ | |w.re| < 1 / 2}} ∧
      (∀ i, D.g i ∈ Γ) ∧ (Subgroup.closure (range D.g)).map toPSL = Γ.map toPSL := by
  sorry

/-- **Proposition 3.9.14 (a)** (Ford fundamental domain for `PSL₂ℤ`, Ch. 3 §3.9, H1:2929). The region `{|Re z| < 1/2,
|z| > 1}` is a fundamental domain for `PSL₂ℤ` (for `SL(2, ℤ)` acting on `ℍ`). -/
theorem prop3_9_14_a :
    IsFundamentalDomainTop sl2Z {z : UpperHalfPlane | |(z : ℂ).re| < 1 / 2 ∧ 1 < ‖(z : ℂ)‖} := by
  sorry

/-- **Proposition 3.9.14 (b)** (Ch. 3 §3.9, H1:2929). `PSL₂ℤ` is generated by `A(z) = −1/z` and `B(z) = (z − 1)/z`,
which satisfy `A² = B³ = 1`, and `⟨A, B | A², B³⟩` is a presentation of `PSL₂ℤ`. Modelling: `A, B ∈ SL(2, ℤ)` are the
matrices `(0 −1; 1 0)` and `(1 −1; 1 0)`; the kernel of `FreeGroup.lift (toPSL A, toPSL B)` is the normal closure of
`a²`, `b³`, and its range is the image of `SL(2, ℤ)` in `PSL(2, ℝ)`. -/
theorem prop3_9_14_b {A B : Matrix.SpecialLinearGroup (Fin 2) ℝ} (hA0 : A 0 0 = 0) (hA1 : A 0 1 = -1) (hA2 : A 1 0 = 1)
    (hA3 : A 1 1 = 0) (hB0 : B 0 0 = 1) (hB1 : B 0 1 = -1) (hB2 : B 1 0 = 1) (hB3 : B 1 1 = 0) :
