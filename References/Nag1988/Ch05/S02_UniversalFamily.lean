variable {Γ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) ℝ)}

/-! ## Topologies and charts -/

/-- The topology of `F(G)` as a subspace of `B(G) × ℂ` (norm `pairNorm`). Modelling: `F(G)` is open in `B(G) × ℂ`
(`para5_1_1_open`), so its open sets are the open sets of `B(G) × ℂ` contained in it; this is a genuine topology, written as
the one generated by them. (`T(G)` carries no topology instance in the project.) -/
@[instance_reducible]
def bersFiberTopology (Γ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) ℝ)) : TopologicalSpace (BersFiberSpace Γ) :=
  TopologicalSpace.generateFrom
    {S : Set (BersFiberSpace Γ) | IsBOpen pairNorm (cuspFormsL Γ ×ˢ univ) (Subtype.val '' S)}

/-- The quotient topology on `V(G) = F(G)/G` (`LiZhongQC.BersQuotient`): coinduced by the quotient map. -/
@[instance_reducible]
def bersQuotientTopology (Γ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) ℝ)) : TopologicalSpace (BersQuotient Γ) :=
  @TopologicalSpace.coinduced _ _ (Quot.mk (bersFiberRel Γ) : BersFiberSpace Γ → BersQuotient Γ) (bersFiberTopology Γ)

/-- The topology of `T(G)` (the Bers image) as a subspace of `B(G)` with the cusp norm. -/
@[instance_reducible]
def bersImageTopology (Γ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) ℝ)) : TopologicalSpace (bersImage Γ) :=
  TopologicalSpace.generateFrom {S : Set (bersImage Γ) | IsBOpen (cuspNorm lowerHalf) (cuspFormsL Γ) (Subtype.val '' S)}

/-- `p` and `q` lie in the same `G`-orbit of `F(G)`: `q = γ p` for some `γ ∈ G`. -/
def GEquiv (Γ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) ℝ)) (p q : (ℂ → ℂ) × ℂ) : Prop :=
  ∃ γ ∈ Γ, bersFiberSpaceAction Γ γ p = q

/-- `N` is mapped off itself by every element of `G` other than `±I` (small neighbourhoods of a free action). -/
def HasDisjointNbhd (Γ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) ℝ)) (N : Set ((ℂ → ℂ) × ℂ)) : Prop :=
  ∀ γ ∈ Γ, γ ≠ 1 → γ ≠ -1 → Disjoint (bersFiberSpaceAction Γ γ '' N) N

/-- **Chart-wise complex manifold structure on `F(G)/G` of dimension `m`** (finite-dimensional case, `T(G)` of finite
dimension). Every point `p` of `F(G)` has an open neighbourhood `N` with a holomorphic `G`-invariant map `c : N → ℂ^m`
separating exactly the `G`-orbits and mapping open subsets of `N` to open subsets of `ℂ^m`: `c` is a homeomorphism of
`N/G` onto an open subset of `ℂ^m`. Modelling: the complex structure of the quotient is the one making these maps
holomorphic charts; the compatibility of overlapping charts is not part of the predicate. -/
def IsQuotientManifoldOfDim (Γ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) ℝ)) (m : ℕ) : Prop :=
  ∀ p ∈ BersFiberSpace Γ, ∃ (N : Set ((ℂ → ℂ) × ℂ)) (c : (ℂ → ℂ) × ℂ → (Fin m → ℂ)),
    IsBOpen pairNorm (cuspFormsL Γ ×ˢ univ) N ∧ p ∈ N ∧ N ⊆ BersFiberSpace Γ ∧
    (∀ γ ∈ Γ, ∀ x ∈ N, bersFiberSpaceAction Γ γ x ∈ N → c (bersFiberSpaceAction Γ γ x) = c x) ∧
    (∀ x ∈ N, ∀ y ∈ N, c x = c y → ∃ γ ∈ Γ, bersFiberSpaceAction Γ γ x = y) ∧
    IsBHolOn pairNorm (fun v : Fin m → ℂ => ENNReal.ofReal ‖v‖) N c ∧
    (∀ W : Set ((ℂ → ℂ) × ℂ), W ⊆ N → IsBOpen pairNorm (cuspFormsL Γ ×ˢ univ) W → IsOpen (c '' W))

/-- The elliptic points of `Γ` in `ℍ`: the points fixed by an element other than `±I`. -/
def ellipticPoints (Γ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) ℝ)) : Set UpperHalfPlane :=
  {τ | ∃ γ ∈ Γ, γ ≠ 1 ∧ γ ≠ -1 ∧ γ • τ = τ}

/-- `Γ` has exactly `n` conjugacy classes of maximal elliptic subgroups: the elliptic points form exactly `n` `Γ`-orbits. -/
def HasEllipticClasses (Γ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) ℝ)) (n : ℕ) : Prop :=
  Cardinal.mk (Quot fun τ σ : ellipticPoints Γ => ∃ γ ∈ Γ, γ • (τ : UpperHalfPlane) = σ) = n

/-- `ℍ/Γ` is a compact Riemann surface `S` of genus `g` (also for a group with torsion): there is a holomorphic open
surjection `p : ℍ → S` whose fibers are the `Γ`-orbits. Modelling: `p` is a branched covering; for a group with torsion
`LiZhongQC.IsUniformization` (a covering) does not apply, so `S = ℍ/Γ` is described through `p`. -/
def IsBranchedQuotientOfGenus (Γ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) ℝ)) (g : ℕ) : Prop :=
  ∃ (S : Type) (_ : TopologicalSpace S) (_ : T2Space S) (_ : ConnectedSpace S) (_ : ChartedSpace ℂ S)
    (_ : IsManifold 𝓘(ℂ) ω S) (p : UpperHalfPlane → S),
    MDifferentiable 𝓘(ℂ) 𝓘(ℂ) p ∧ Function.Surjective p ∧ IsOpenMap p ∧
      (∀ τ₁ τ₂, p τ₁ = p τ₂ ↔ ∃ γ ∈ Γ, γ • τ₁ = τ₂) ∧ HasGenus S g

/-- `Γ` is torsion free and `ℍ/Γ` is a Riemann surface of finite type `(g, n)` without boundary discs (`n` punctures),
i.e. the Fuchsian group of the surface of type `(g, n)` in Nag's `T(g,n)`. -/
def IsOfType (Γ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) ℝ)) (g n : ℕ) : Prop :=
  ∃ (S : Type) (_ : TopologicalSpace S) (_ : ChartedSpace ℂ S) (p : UpperHalfPlane → S),
    IsUniformization Γ p ∧ IsFiniteType S g n 0

/-! ## §5.2.1 -/

/-- **Theorem 5.2.1 (a)** (Ch. 5 §5.2.1). `G` (as a subgroup of `mod(G)`) acts properly discontinuously and effectively
on `F(G)` as a group of fiber-preserving biholomorphic automorphisms. Modelling: properly discontinuous = every point has a
neighbourhood `N` such that only finitely many transformations of `F(G)` induced by `G` meet `N` in `N`; effective =
only `±I` acts trivially. -/
theorem thm5_2_1_a (hΓ : IsFuchsian Γ) :
    (∀ γ ∈ Γ, IsBBiholOn pairNorm pairNorm (BersFiberSpace Γ) (BersFiberSpace Γ) (bersFiberSpaceAction Γ γ) ∧
      ∀ p ∈ BersFiberSpace Γ, (bersFiberSpaceAction Γ γ p).1 = p.1) ∧
    (∀ p ∈ BersFiberSpace Γ, ∃ N : Set ((ℂ → ℂ) × ℂ), IsBOpen pairNorm (cuspFormsL Γ ×ˢ univ) N ∧ p ∈ N ∧
      N ⊆ BersFiberSpace Γ ∧
      {T : (ℂ → ℂ) × ℂ → (ℂ → ℂ) × ℂ | ∃ γ ∈ Γ, T = bersFiberSpaceAction Γ γ ∧ (T '' N ∩ N).Nonempty}.Finite) ∧
    ∀ γ ∈ Γ, (∀ p ∈ BersFiberSpace Γ, bersFiberSpaceAction Γ γ p = p) → γ = 1 ∨ γ = -1 := by
  sorry

/-- **Theorem 5.2.1 (b)** (Ch. 5 §5.2.1). If `G` is torsion free, then `V(G) = F(G)/G` is a holomorphic fiber space over
`T(G)` whose fiber over `[μ]` is `X^μ = w^μ(U)/G^μ`. Modelling: the structure of `V(G)` is the quotient structure: every
point of `F(G)` has a neighbourhood `N` on which the quotient map is injective and `Prod.fst` is a holomorphic split
submersion onto an open set of `T(G)`; the fiber over `φ` is homeomorphic to the orbit space of `D_φ` under `G_φ`. -/
theorem thm5_2_1_b (hΓ : IsFuchsian Γ) (hfree : ActsFreely Γ) :
    (∀ p ∈ BersFiberSpace Γ, ∃ N : Set ((ℂ → ℂ) × ℂ), IsBOpen pairNorm (cuspFormsL Γ ×ˢ univ) N ∧ p ∈ N ∧
      N ⊆ BersFiberSpace Γ ∧ HasDisjointNbhd Γ N ∧
      IsBOpen (cuspNorm lowerHalf) (cuspFormsL Γ) (Prod.fst '' N) ∧
      IsHolFiberSpace pairNorm (cuspNorm lowerHalf) N (Prod.fst '' N) Prod.fst) ∧
    ∀ φ ∈ bersImage Γ, letI := bersQuotientTopology Γ
      Nonempty (↥(bersProjection Γ ⁻¹' {φ}) ≃ₜ
        Quot fun z w : bersDisc Γ φ => ∃ γ ∈ Γ, bersFiberAction Γ γ φ z = w) := by
  sorry

/-- **Theorem 5.2.1 (c)** (Ch. 5 §5.2.1). For `G` torsion free, `F(G) → V(G)` is the (holomorphic) universal covering of
`V(G)`: the quotient map is a covering map and `F(G)` is simply connected. -/
theorem thm5_2_1_c (hΓ : IsFuchsian Γ) (hfree : ActsFreely Γ) :
    letI := bersFiberTopology Γ
    letI := bersQuotientTopology Γ
    IsCoveringMap (Quot.mk (bersFiberRel Γ) : BersFiberSpace Γ → BersQuotient Γ) ∧
      SimplyConnectedSpace (BersFiberSpace Γ) := by
  sorry

/-- **Unlabelled claim** (Ch. 5 §5.2.1, local trivializations (2.2), (2.3), N2:4686–4708). Let `σ` be a local holomorphic
section of `Φ` over an open set `S ⊆ T(G)`: `σ(s) ∈ M(G)` with `[σ(s)] = s`. Then `θ(s, z) = (s, w^{σ(s)}(z))` (2.2) is a
homeomorphism of `S × U` onto `F⁻¹(S)`, its horizontal slices `s ↦ θ(s, z)` are holomorphic, and
`θ(s, g z) = (g⁻¹)^*(θ(s, z))` (2.3), which is `(s, g_s (w^{σ(s)} z))` with `g_s` the action `bersFiberAction`. -/
theorem para5_2_1_trivialization (hΓ : IsFuchsian Γ) (S : Set (ℂ → ℂ)) (hS : S ⊆ bersImage Γ)
    (hSo : IsBOpen (cuspNorm lowerHalf) (cuspFormsL Γ) S) (σ : (ℂ → ℂ) → BeltramiGamma Γ)
    (hσ : ∀ s ∈ S, bersFunctionGamma (σ s) = s)
    (hσhol : IsBHolOn (cuspNorm lowerHalf) essNorm S fun s => (σ s).1.1) :
    let θ : (ℂ → ℂ) × ℂ → (ℂ → ℂ) × ℂ := fun q => (q.1, normalizedSolution (σ q.1).1.1 q.2)
    IsBHomeoOn pairNorm pairNorm (S ×ˢ upperHalf) {p | p ∈ BersFiberSpace Γ ∧ p.1 ∈ S} θ ∧
      (∀ z ∈ upperHalf, IsBHolOn (cuspNorm lowerHalf) pairNorm S fun s => θ (s, z)) ∧
      ∀ s ∈ S, ∀ g ∈ Γ, ∀ z ∈ upperHalf,
        θ (s, LiZhongQC.mobiusFn (g 0 0) (g 0 1) (g 1 0) (g 1 1) z) = bersFiberSpaceAction Γ g (θ (s, z)) := by
  sorry

/-! ## §5.2.2 The punctured fiber space -/

/-- **Punctured Bers fiber space `F₀(G)`** (Ch. 5 §5.2.2, (2.4), N2:4712): `F₀(G) = {([μ], z) : z ∈ w^μ(U_G)}` with
`U_G = U` minus the elliptic fixed points of `G`. Modelling: `z = w^μ(u)` for a representative `μ` of the Bers coordinate
and a non-elliptic `u ∈ ℍ` (the image of the elliptic points does not depend on the representative: it is the set of
elliptic fixed points of `G^μ`). `V₀(G) = F₀(G)/G` is its orbit space. -/
def puncturedBersFiberSpace (Γ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) ℝ)) : Set ((ℂ → ℂ) × ℂ) :=
  {p | p ∈ BersFiberSpace Γ ∧ ∃ μ : BeltramiGamma Γ, bersFunctionGamma μ = p.1 ∧ ∃ u : UpperHalfPlane,
    u ∉ ellipticPoints Γ ∧ p.2 = normalizedSolution μ.1.1 u}

/-- **Unlabelled claim** (Ch. 5 §5.2.2, N2:4724, cited at N2:4808). `G` acts freely and discontinuously on `F₀(G)`, and
`π₀ : V₀(G) → T(G)` is a holomorphic fiber space (chart-wise, as in `thm5_2_1_b`). -/
theorem para5_2_2_punctured (hΓ : IsFuchsian Γ) :
    (∀ γ ∈ Γ, ∀ p ∈ puncturedBersFiberSpace Γ, bersFiberSpaceAction Γ γ p = p → γ = 1 ∨ γ = -1) ∧
    ∀ p ∈ puncturedBersFiberSpace Γ, ∃ N : Set ((ℂ → ℂ) × ℂ), IsBOpen pairNorm (cuspFormsL Γ ×ˢ univ) N ∧ p ∈ N ∧
      N ⊆ puncturedBersFiberSpace Γ ∧ HasDisjointNbhd Γ N ∧
      IsBOpen (cuspNorm lowerHalf) (cuspFormsL Γ) (Prod.fst '' N) ∧
      IsHolFiberSpace pairNorm (cuspNorm lowerHalf) N (Prod.fst '' N) Prod.fst := by
  sorry

/-! ## §5.2.3, §5.2.4 -/

/-- **Unlabelled claim** (Ch. 5 §5.2.3, N2:4736, cited at N2:5648). For `G` torsion free of type `(g, n)` with
`2g - 2 + n > 0`, `π' : V(g,n)' → T(g,n)` is topologically globally trivial: `V(G)` is homeomorphic to `T(G) × X`,
`X = U/G`, by a homeomorphism commuting with the projections to `T(G)`. Modelling: the parenthetical "in fact `C^∞`"
refinement is not formalized. -/
theorem para5_2_3 (hΓ : IsFuchsian Γ) (hfree : ActsFreely Γ) {g n : ℕ} (hty : IsOfType Γ g n) (hhyp : 2 < 2 * g + n) :
    letI := bersQuotientTopology Γ
    letI := bersImageTopology Γ
    ∃ h : BersQuotient Γ ≃ₜ (bersImage Γ × Quotient (MulAction.orbitRel Γ UpperHalfPlane)),
      ∀ v, ((h v).1 : ℂ → ℂ) = bersProjection Γ v := by
  sorry

/-- **Proposition 5.2.4 (a)** (Ch. 5 §5.2.4). Let `G` be finitely generated of the first kind, with `n` conjugacy classes of
maximal elliptic subgroups, no parabolics, and `U/G` compact of genus `g` (here: `G` cocompact, `ℍ/G` of genus `g`).
Then `V(G) = F(G)/G` is a complex manifold of dimension `3g - 2 + n`. Modelling: `IsQuotientManifoldOfDim`; the
hypothesis `2 < 2g + n` makes `3g - 2 + n` a true natural number. -/
theorem prop5_2_4_a (hΓ : IsFuchsian Γ) (hco : IsCocompact Γ) {g n : ℕ} (hg : IsBranchedQuotientOfGenus Γ g)
    (hn : HasEllipticClasses Γ n) (hhyp : 2 < 2 * g + n) : IsQuotientManifoldOfDim Γ (3 * g + n - 2) := by
  sorry

/-- **Proposition 5.2.4 (b)** (Ch. 5 §5.2.4). In the setting of (a), `π : V(g,n) → T(g,n)` is a holomorphic fiber space
with compact genus `g` fibers `U^μ/G^μ`; it has `n` disjoint global holomorphic sections `s_j` induced by
`s̃_j([μ]) = ([μ], w^μ(z_j))` with `z_j` an elliptic fixed point (one for each class) (2.9). Modelling: `z : Fin n → ℍ`
lists one elliptic point from each class; `s_j` are the lifts to `F(G)`, holomorphic on `T(G)`, pairwise `G`-inequivalent. -/
theorem prop5_2_4_b (hΓ : IsFuchsian Γ) (hco : IsCocompact Γ) {g n : ℕ} (hg : IsBranchedQuotientOfGenus Γ g)
    (hn : HasEllipticClasses Γ n) (hhyp : 2 < 2 * g + n) (z : Fin n → UpperHalfPlane)
    (hz : ∀ j, z j ∈ ellipticPoints Γ) (hzd : ∀ j k, j ≠ k → ∀ γ ∈ Γ, γ • z j ≠ z k)
    (hzall : ∀ τ ∈ ellipticPoints Γ, ∃ j, ∃ γ ∈ Γ, γ • z j = τ) :
    (∀ φ ∈ bersImage Γ, letI := bersQuotientTopology Γ; HasGenus (↥(bersProjection Γ ⁻¹' {φ})) g) ∧
      ∃ s : Fin n → (ℂ → ℂ) → (ℂ → ℂ) × ℂ,
        (∀ j, IsBHolOn (cuspNorm lowerHalf) pairNorm (bersImage Γ) (s j)) ∧
        (∀ j, ∀ φ ∈ bersImage Γ, s j φ ∈ BersFiberSpace Γ ∧ (s j φ).1 = φ ∧
          ∀ μ : BeltramiGamma Γ, bersFunctionGamma μ = φ → (s j φ).2 = normalizedSolution μ.1.1 (z j)) ∧
        ∀ j k, j ≠ k → ∀ φ ∈ bersImage Γ, ¬ GEquiv Γ (s j φ) (s k φ) := by
  sorry

/-! ## §5.2.5 -/

/-- **Proposition 5.2.5** (Ch. 5 §5.2.5). If `T(G)` is finite dimensional, `mod(G)` acts properly discontinuously on
`F(G)`: every point has a neighbourhood `N` such that only finitely many classes in `mod(G)` have a representative `ω`
with `ω^*(N) ∩ N ≠ ∅`. -/
theorem prop5_2_5 (hΓ : IsFuchsian Γ) (hfd : FiniteDimensional ℂ (Submodule.span ℂ (cuspFormsL Γ))) :
    ∀ p ∈ BersFiberSpace Γ, ∃ N : Set ((ℂ → ℂ) × ℂ), IsBOpen pairNorm (cuspFormsL Γ ×ˢ univ) N ∧ p ∈ N ∧
      N ⊆ BersFiberSpace Γ ∧
      {c : modExtended Γ | ∃ om : qcNormalizer Γ, Quot.mk _ om = c ∧ ∃ q ∈ N, ∃ r ∈ N, modStarFiber Γ om.1 q r}.Finite := by
  sorry

/-- **Lemma 5.2.5** (Ch. 5 §5.2.5). The `mod(G)` action on `F(G)` descends to a well-defined `Mod(G)` action on
`V(G) = F(G)/G`, and each `om` induces a biholomorphism `X^μ → X^ν`. Modelling: (i) if `om^*` takes `p` to `q` and `p'` to
`q'` with `p`, `p'` in one `G`-orbit then `q`, `q'` lie in one `G`-orbit, also when `om'` is another representative of the
`Mod(G)`-class of `om` (boundary values `GardinerLakic2000.qcBdry`, in `ℂ̂`, differing by an element of `G`); (ii) the
conformal map `g = w^ν ∘ om⁻¹ ∘ (w^μ)⁻¹ : U^μ → U^ν` of Lemma 5.1.3 (given by its formula `g(w^μ(u)) = w^ν(y)` for
`om(y) = u`, not by a normalization at `0, 1, ∞`, which it need not satisfy: AUDIT3_Nag B5) conjugates the group `G^μ`
into `G^ν`. -/
theorem lemma5_2_5 (hΓ : IsFuchsian Γ) :
    (∀ om ∈ qcNormalizer Γ, ∀ om' ∈ qcNormalizer Γ, (∃ γ ∈ Γ, ∀ x : ℝ,
        GardinerLakic2000.qcBdry om' ((x : ℂ) : LiZhongQC.ExtPlane) =
          LiZhongQC.mobiusSL (LiZhongQC.slRealToComplex γ) (GardinerLakic2000.qcBdry om ((x : ℂ) : LiZhongQC.ExtPlane))) →
      ∀ p ∈ BersFiberSpace Γ, ∀ p' ∈ BersFiberSpace Γ, GEquiv Γ p p' → ∀ q q', modStarFiber Γ om p q →
        modStarFiber Γ om' p' q' → GEquiv Γ q q') ∧
    ∀ om ∈ qcNormalizer Γ, ∀ μ ν : BeltramiGamma Γ, IsOmegaPullback Γ om μ ν →
      ∀ g : ℂ → ℂ, (∀ u ∈ upperHalf, ∀ y ∈ upperHalf, om y = u →
          g (normalizedSolution μ.1.1 u) = normalizedSolution ν.1.1 y) →
        ∀ γ ∈ Γ, ∃ γ' ∈ Γ, ∀ z ∈ normalizedSolution μ.1.1 '' upperHalf,
          g (bersFiberAction Γ γ (bersFunctionGamma μ) z) = bersFiberAction Γ γ' (bersFunctionGamma ν) (g z) := by
  sorry

/-! ## §5.2.6 Tori -/

/-- **The `ℤ²`-action `(m, n)^*(τ, z) = (τ, z + m + nτ)` on `U × ℂ`** (Ch. 5 §5.2.6, (2.14), N2:4888). -/
def torusAction (m n : ℤ) (p : UpperHalfPlane × ℂ) : UpperHalfPlane × ℂ := (p.1, p.2 + m + n * p.1)

/-- **`V(1,0) = V(1,1) = (U × ℂ)/ℤ²`** (Ch. 5 §5.2.6, (2.15)): the orbit space of the `ℤ²`-action `torusAction`. -/
def TorusFiberSpace : Type := Quot fun p q : UpperHalfPlane × ℂ => ∃ m n : ℤ, torusAction m n p = q

/-- **`(U × ℂ)'`** (Ch. 5 §5.2.6, (2.16)): the points with `z ≢ 0 mod L(1, τ)` (`L(1, τ) = ℤ + ℤτ`). -/
def punctTorusBase : Set (UpperHalfPlane × ℂ) := {p | ∀ m n : ℤ, p.2 ≠ m + n * p.1}

/-- **Unlabelled claim** (Ch. 5 §5.2.6, N2:4888–4914, cited at N3:315). `U × ℂ` is the holomorphic universal covering of
`V(1,0) = (U × ℂ)/ℤ²` (the quotient map is a covering and `U × ℂ` is simply connected), and the set `(U × ℂ)'` of (2.16),
whose quotient (2.17) models `V(1,1)'`, is open and invariant under the `ℤ²`-action. -/
theorem para5_2_6_tori :
    IsCoveringMap (Quot.mk _ : UpperHalfPlane × ℂ → TorusFiberSpace) ∧ SimplyConnectedSpace (UpperHalfPlane × ℂ) ∧
      IsOpen punctTorusBase ∧ ∀ m n : ℤ, torusAction m n '' punctTorusBase = punctTorusBase := by
  sorry

end Nag1988
