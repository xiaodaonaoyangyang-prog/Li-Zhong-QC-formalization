import References.Nag1988.Ch04.S05_BersBoundary
import Mathlib.Analysis.SpecialFunctions.Elliptic.Weierstrass

/-!
# Nag, Chapter 4 §4.6: Complex analytic parameters for `T(1, 1)` and `T(1, 2)` (W2 batch N3)

Source: S. Nag, *The Complex Analytic Theory of Teichmüller Spaces*, Wiley 1988, Ch. 4 §4.6 (`full.md` N2:4050–4330,
folder `The Complex Analytic Theory … c10f6cd1`).

Conventions as in `Ch04/S04_SchwarzianAndDeformations`. The lattice `L(1, τ)` is `ℤ·1 + ℤ·τ` (`τ ∈ U`), the Weierstrass function `℘` is Mathlib's
`PeriodPair.weierstrassP` (notation `℘[L]`) for a `PeriodPair` `L` with `ω₁ = 1`, `ω₂ = τ`; the lattice of a `PeriodPair` is `L.lattice`. The canonical
`μ`-quasiconformal map `w^μ` of `ℂ` is `LiZhongQC.normalizedSolution μ`. The Fuchsian group of a once-punctured torus is `Nag1988.IsOfType Γ 1 1`.

* Proposition 4.6.2 (a) (the uniformizing group of a once-punctured torus is free on two hyperbolic generators `A`, `B` with parabolic
  commutator, N2:4055) — `prop4_6_2_a`
* Proposition 4.6.2 (b) (the covering `p' : ℂ − L̂ → X` corresponds to the commutator subgroup, N2:4066) — omitted: covering-space bookkeeping
  (the commutator subgroup `F_∞`); used only in the remark on the monodromy group of the Lamé equation
* Lemma 4.6.3 (double periodicity of `w^μ`, N2:4082) — `lem4_6_3`
* Theorem 4.6.3 (`w^μ(τ₀)` takes values in `U` and every `τ ∈ U` occurs: `U` is `T(1, 1)` through `μ ↦ w^μ(τ₀)`, N2:4098) — `thm4_6_3_a`, `thm4_6_3_b`
  (the identification of `μ ↦ w^μ(τ₀)` with the fundamental projection `Φ` onto `T(X)` is not stated)
* Unlabelled (§4.6.4, the trace relation `x² + y² + z² = xyz`, (6.6), N2:4152) — `lem4_6_4`
* Unlabelled (§4.6.4–§4.6.5, Keen's real analytic realization of `T(1, 1)` by (6.6), `QF(1, 1)` and the complex diagonal `xy = 2z`, (6.10)) — omitted:
  quoted from Keen [Ke-2]; needs the Fricke space of the once-punctured torus and `QF(1, 1)` (not in the project)
* Lemma 4.6.6 (`S r = ½ ℘` for a local inverse `r` of the covering `L → ℂ − L̂₀`, N2:4217) — `lem4_6_6`
* Theorem 4.6.6 (the Bers embedding of `T(1, 1)` is the set of `b` for which Lamé's equation (6.16) has a quasidisk universal covering of
  `ℂ − L̂₀` as monodromy quotient, N2:4240) — `thm4_6_6`
* Proposition 4.6.7 (the canonical map `T(1, 2) → T(0, 5)` associates the five points `℘(1/2), ℘(τ/2), ∞, ℘((1+τ)/2), ℘(σ)`, N2:4290) — `prop4_6_7`
* Corollary 4.6.7 (explicit holomorphic coordinates `(w₁, w₂)` of `T(0, 5)`, N2:4304) — `cor4_6_7`
  (the identification of the coordinates with the canonical isometry `T(1, 2) → T(0, 5)` of Section 2.3.8 is not stated)

Readings: Theorem 4.6.6 is stated by its second formulation ("otherwise stated"): `φ = bφ₀` with `φ₀ = (p')²` (the normalization
`(φ₀ ∘ r)(r')² = 1` of N2:4228) lies in `T_β(G₀)` iff the local inverses `ρ` of a holomorphic covering `q` of `ℂ − L̂₀` by a quasidisk satisfy
`S ρ = ½ ℘ + b` (the ratio `η₁/η₂` of solutions of (6.16)).
-/

open Complex Set Metric Filter Topology MeasureTheory
open scoped ENNReal NNReal Real ComplexConjugate MatrixGroups PeriodPair

noncomputable section

namespace Nag1988

open LiZhongQC (lowerHalf ExtPlane toExt meroToExt schwarzian IsFuchsian bersImage normalizedSolution IsBeltramiCoeff IsHyperbolic
  IsParabolic IsKQuasidisc automorphicQD)

variable {Γ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) ℝ)}

/-- **Proposition 4.6.2 (a)** (Ch. 4 §4.6.2, N2:4055). For any once-punctured torus `X` the uniformizing torsion-free Fuchsian group `G`
(`U/G = X`) is a free group on two hyperbolic generators `A` and `B` with their commutator `C = ABA⁻¹B⁻¹` parabolic. Modelling: `G` is generated by
`A, B` modulo `±1`, the homomorphism of the free group `F₂` on `a, b` onto `⟨A, B⟩` is injective. -/
theorem prop4_6_2_a (hΓ : IsFuchsian Γ) (hX : IsOfType Γ 1 1) :
    ∃ A B : Matrix.SpecialLinearGroup (Fin 2) ℝ, A ∈ Γ ∧ B ∈ Γ ∧ IsHyperbolic A ∧ IsHyperbolic B ∧ IsParabolic (A * B * A⁻¹ * B⁻¹) ∧
      Subgroup.closure {A, B} ⊔ Subgroup.zpowers (-1) = Γ ⊔ Subgroup.zpowers (-1) ∧
        Function.Injective (FreeGroup.lift (fun i : Fin 2 => ![A, B] i)) := by
  sorry

/-- **Lemma 4.6.3** (Ch. 4 §4.6.3, N2:4082). Let `τ₀ ∈ U`, `L̂ = L(1, τ₀)` and `μ` a Beltrami coefficient on `ℂ` invariant under the translations
of `L̂` (a Beltrami differential of the torus `X = (ℂ − L̂)/L̂`). Then the canonical `μ`-quasiconformal map `w^μ` (fixing `0, 1, ∞`) satisfies
`w^μ(z + mτ₀ + n) = w^μ(z) + m w^μ(τ₀) + n` for all `z ∈ ℂ`, `m, n ∈ ℤ`. -/
theorem lem4_6_3 {τ₀ : ℂ} (hτ₀ : 0 < τ₀.im) {μ : ℂ → ℂ} {k : ℝ} (hk : k < 1) (hμ : IsBeltramiCoeff μ univ k)
    (hper : ∀ m n : ℤ, ∀ᵐ z : ℂ, μ (z + m * τ₀ + n) = μ z) (z : ℂ) (m n : ℤ) :
    normalizedSolution μ (z + m * τ₀ + n) = normalizedSolution μ z + m * normalizedSolution μ τ₀ + n := by
  sorry

/-- **Theorem 4.6.3, part (a)** (Ch. 4 §4.6.3, N2:4098). For a lattice-invariant Beltrami coefficient `μ`, `w^μ(τ₀)` lies in the upper
half-plane `U` (the map `φ(μ) = w^μ(τ₀)` of (6.4) takes values in `U`). -/
theorem thm4_6_3_a {τ₀ : ℂ} (hτ₀ : 0 < τ₀.im) {μ : ℂ → ℂ} {k : ℝ} (hk : k < 1) (hμ : IsBeltramiCoeff μ univ k)
    (hper : ∀ m n : ℤ, ∀ᵐ z : ℂ, μ (z + m * τ₀ + n) = μ z) : 0 < (normalizedSolution μ τ₀).im := by
  sorry

/-- **Theorem 4.6.3, part (b)** (Ch. 4 §4.6.3, N2:4098). Every `τ ∈ U` is `w^μ(τ₀)` for a lattice-invariant Beltrami coefficient `μ`
(`U = {w^μ(τ₀)}`, the image of `φ` is `U`). -/
theorem thm4_6_3_b {τ₀ : ℂ} (hτ₀ : 0 < τ₀.im) {τ : ℂ} (hτ : 0 < τ.im) :
    ∃ (μ : ℂ → ℂ) (k : ℝ), k < 1 ∧ IsBeltramiCoeff μ univ k ∧ (∀ m n : ℤ, ∀ᵐ z : ℂ, μ (z + m * τ₀ + n) = μ z) ∧
      normalizedSolution μ τ₀ = τ := by
  sorry

/-- **Unlabelled** (Ch. 4 §4.6.4, N2:4152, (6.5)–(6.6)). For `A, B ∈ SL(2, ℂ)` with `x = tr A`, `y = tr B`, `z = tr AB`, the commutator has
`tr (ABA⁻¹B⁻¹) = x² + y² + z² − xyz − 2`; so a parabolic commutator of trace `−2` gives `x² + y² + z² = xyz` (6.6). -/
theorem lem4_6_4 (A B : SL(2, ℂ)) :
    (A * B * A⁻¹ * B⁻¹ : SL(2, ℂ)) 0 0 + (A * B * A⁻¹ * B⁻¹ : SL(2, ℂ)) 1 1 =
      (A 0 0 + A 1 1) ^ 2 + (B 0 0 + B 1 1) ^ 2 + ((A * B : SL(2, ℂ)) 0 0 + (A * B : SL(2, ℂ)) 1 1) ^ 2 -
        (A 0 0 + A 1 1) * (B 0 0 + B 1 1) * ((A * B : SL(2, ℂ)) 0 0 + (A * B : SL(2, ℂ)) 1 1) - 2 := by
  sorry

/-- **Lemma 4.6.6** (Ch. 4 §4.6.6, N2:4217, (6.13)). Let `p : L → ℂ − L̂₀` be the holomorphic universal covering of the infinitely
punctured plane by `L = 𝕃` (`L̂₀ = L(1, i)`, here the lattice of a `PeriodPair` with `ω₁ = 1`, `ω₂ = i`). If `r` is a local inverse of `p`
(holomorphic near `w₀` with `p ∘ r = id`), then the Schwarzian derivative of `r` is well defined and satisfies `S r = ½ ℘`, `℘` the
Weierstrass elliptic function with periods `1` and `i`. -/
theorem lem4_6_6 (Lp : PeriodPair) (h₁ : Lp.ω₁ = 1) (h₂ : Lp.ω₂ = I) {p : ℂ → ℂ} (hp : DifferentiableOn ℂ p lowerHalf)
    (hcov : IsCoveringMapOn (fun z : ↥lowerHalf => p z) ((Lp.lattice : Set ℂ)ᶜ)) (hsurj : p '' lowerHalf = (Lp.lattice : Set ℂ)ᶜ)
    {r : ℂ → ℂ} {U : Set ℂ} (hU : IsOpen U) (hUl : U ⊆ (Lp.lattice : Set ℂ)ᶜ) (hr : DifferentiableOn ℂ r U)
    (hrp : ∀ w ∈ U, r w ∈ lowerHalf ∧ p (r w) = w) : ∀ w ∈ U, schwarzian r w = (1 / 2 : ℂ) * ℘[Lp] w := by
  sorry

/-- **Theorem 4.6.6** (Ch. 4 §4.6.6, N2:4240). Let `G₀` be the Fuchsian group of the covering `p : L → ℂ − L̂₀` (its deck group) and
`φ₀ = (p')²` the generator of the one-dimensional space `B₂(L, G₀)`, normalized so that `(φ₀ ∘ r)(r')² = 1`. The Bers embedding of
`T(1, 1) = T(G₀)` corresponds to those values `b ∈ ℂ` (`b φ₀ ∈ T_β(G₀)`) for which the ratio `η₁/η₂` of a pair of linearly independent
solutions of Lamé's equation `2y'' + (½ ℘ + b) y = 0` on `ℂ − L̂₀` is the local inverse of a holomorphic universal covering `q` of `ℂ − L̂₀` by a
quasidisk `Q` (the image of `L` under the schlicht solution `v` of `S v = b φ₀`): the local inverses `ρ` of `q` satisfy `S ρ = ½ ℘ + b`. -/
theorem thm4_6_6 (Lp : PeriodPair) (h₁ : Lp.ω₁ = 1) (h₂ : Lp.ω₂ = I) (hΓ : IsFuchsian Γ) {p : ℂ → ℂ}
    (hp : DifferentiableOn ℂ p lowerHalf) (hcov : IsCoveringMapOn (fun z : ↥lowerHalf => p z) ((Lp.lattice : Set ℂ)ᶜ))
    (hsurj : p '' lowerHalf = (Lp.lattice : Set ℂ)ᶜ) (hdeck : ∀ g ∈ Γ, ∀ z ∈ lowerHalf, p (mobAct g z) = p z)
    (hdeck' : ∀ z ∈ lowerHalf, ∀ w ∈ lowerHalf, p z = p w → ∃ g ∈ Γ, mobAct g z = w)
    {φ₀ : ℂ → ℂ} (hφ₀ : (∀ z ∈ lowerHalf, φ₀ z = (deriv p z) ^ 2) ∧ ∀ z ∉ lowerHalf, φ₀ z = 0) (b : ℂ) :
    b • φ₀ ∈ bersImage Γ ↔
      ∃ (Q : Set ℂ) (q : ℂ → ℂ) (K : ℝ), IsKQuasidisc Q K ∧ DifferentiableOn ℂ q Q ∧ q '' Q = (Lp.lattice : Set ℂ)ᶜ ∧
        IsCoveringMapOn (fun z : ↥Q => q z) ((Lp.lattice : Set ℂ)ᶜ) ∧
        ∀ (ρ : ℂ → ℂ) (U : Set ℂ), IsOpen U → U ⊆ (Lp.lattice : Set ℂ)ᶜ → DifferentiableOn ℂ ρ U →
          (∀ w ∈ U, ρ w ∈ Q ∧ q (ρ w) = w) → ∀ w ∈ U, schwarzian ρ w = (1 / 2 : ℂ) * ℘[Lp] w + b := by
  sorry

/-- **Proposition 4.6.7** (Ch. 4 §4.6.7, N2:4290, (6.17)). The twice-punctured torus `(τ, σ)` (punctures at `±σ`) is mapped, by the
two-sheeted covering `℘ : X_τ → ℂ̂` whose sheet interchange is `z ↦ −z`, to the five-punctured sphere with punctures at
`℘(1/2) = e₁`, `℘(τ/2) = e₂`, `℘(0) = ∞`, `℘((1+τ)/2) = e₃`, `℘(σ)`. Modelling: `℘` is even, `℘(z) = ℘(w)` iff `w ≡ ±z` modulo the
lattice `L(1, τ)` (order two), and the five points are pairwise distinct (`e₁, e₂, e₃` distinct, `℘(σ) ∉ {e₁, e₂, e₃}` for `σ` not a half
period or a lattice point). -/
theorem prop4_6_7 (Lp : PeriodPair) (h₁ : Lp.ω₁ = 1) {τ : ℂ} (h₂ : Lp.ω₂ = τ) (hτ : 0 < τ.im) :
    (∀ z, ℘[Lp] (-z) = ℘[Lp] z) ∧
      (∀ z w, z ∉ (Lp.lattice : Set ℂ) → w ∉ (Lp.lattice : Set ℂ) →
        (℘[Lp] z = ℘[Lp] w ↔ ∃ l ∈ (Lp.lattice : Set ℂ), z = w + l ∨ z = -w + l)) ∧
      ℘[Lp] (1 / 2) ≠ ℘[Lp] (τ / 2) ∧ ℘[Lp] (1 / 2) ≠ ℘[Lp] ((1 + τ) / 2) ∧ ℘[Lp] (τ / 2) ≠ ℘[Lp] ((1 + τ) / 2) ∧
      ∀ σ : ℂ, (∀ l ∈ (Lp.lattice : Set ℂ), 2 * σ ≠ l) →
        ℘[Lp] σ ≠ ℘[Lp] (1 / 2) ∧ ℘[Lp] σ ≠ ℘[Lp] (τ / 2) ∧ ℘[Lp] σ ≠ ℘[Lp] ((1 + τ) / 2) := by
  sorry

/-- **Corollary 4.6.7** (Ch. 4 §4.6.7, N2:4304). The coordinates `(w₁, w₂)` of `T(0, 5)`: `w₁` is the position of `℘((1+τ)/2)` and `w₂` the position of
`℘(σ)` under the Möbius automorphism of `ℂ̂` that sends `℘(1/2), ℘(τ/2), ∞` to `0, 1, ∞`:
`w₁ = (e₃ − e₁)/(e₂ − e₁)`, `w₂ = (℘(σ) − e₁)/(e₂ − e₁)`. They depend holomorphically on `(τ, σ)` on the domain `{Im τ > 0, 2σ ∉ L(1, τ)}`.
Modelling: for a family `Lp τ` of period pairs with periods `1, τ`. -/
theorem cor4_6_7 {Lp : ℂ → PeriodPair} (hLp : ∀ τ, 0 < τ.im → (Lp τ).ω₁ = 1 ∧ (Lp τ).ω₂ = τ) :
    DifferentiableOn ℂ (fun x : ℂ × ℂ => (℘[Lp x.1] ((1 + x.1) / 2) - ℘[Lp x.1] (1 / 2)) / (℘[Lp x.1] (x.1 / 2) - ℘[Lp x.1] (1 / 2)))
        {x : ℂ × ℂ | 0 < x.1.im ∧ ∀ l ∈ ((Lp x.1).lattice : Set ℂ), 2 * x.2 ≠ l} ∧
      DifferentiableOn ℂ (fun x : ℂ × ℂ => (℘[Lp x.1] x.2 - ℘[Lp x.1] (1 / 2)) / (℘[Lp x.1] (x.1 / 2) - ℘[Lp x.1] (1 / 2)))
        {x : ℂ × ℂ | 0 < x.1.im ∧ ∀ l ∈ ((Lp x.1).lattice : Set ℂ), 2 * x.2 ≠ l} := by
  sorry

end Nag1988
