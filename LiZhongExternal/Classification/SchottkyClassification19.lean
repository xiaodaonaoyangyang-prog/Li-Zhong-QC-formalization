/-!
# Dual connectivity of completed surface triangulations

A completed finite triangulation of a connected surface has connected dual graph.  The proof
does not require a separate cyclic-link theorem.  If the faces split into two dual components,
their closed carriers can meet only at triangulation vertices.  Deleting that finite vertex
locus would therefore disconnect the surface, contradicting finite-puncture connectivity.
-/

open scoped Manifold

namespace LeanEval
namespace Topology
namespace ClassificationOfSurfaces

namespace TriangleFamily

variable {Vertex : Type*} [DecidableEq Vertex]

/-- Membership of a raw face in the dual component generated by `root`. -/
def FaceReachable (faces : Finset (Finset Vertex)) (root : Face faces)
    (t : Finset Vertex) : Prop :=
  ∃ ht : t ∈ faces,
    Relation.ReflTransGen (FaceAdjacent faces) root ⟨t, ht⟩

omit [DecidableEq Vertex] in
theorem faceReachable_iff
    {faces : Finset (Finset Vertex)} (root f : Face faces) :
    FaceReachable faces root f.1 ↔
      Relation.ReflTransGen (FaceAdjacent faces) root f := by
  constructor
  · rintro ⟨hf, hpath⟩
    simpa only [Subtype.coe_eta] using hpath
  · intro hpath
    exact ⟨f.2, hpath⟩

omit [DecidableEq Vertex] in
theorem faceReachable_root
    {faces : Finset (Finset Vertex)} (root : Face faces) :
    FaceReachable faces root root.1 :=
  (faceReachable_iff root root).2 Relation.ReflTransGen.refl

omit [DecidableEq Vertex] in
/-- A face outside the component of `root` cannot share an edge with a face inside it. -/
theorem not_faceAdjacent_of_faceReachable_of_not
    {faces : Finset (Finset Vertex)} (root f g : Face faces)
    (hf : FaceReachable faces root f.1)
    (hg : ¬FaceReachable faces root g.1) :
    ¬FaceAdjacent faces f g := by
  intro hfg
  apply hg
  have hpath : Relation.ReflTransGen (FaceAdjacent faces) root f :=
    (faceReachable_iff root f).1 hf
  have hpath' : Relation.ReflTransGen (FaceAdjacent faces) root g :=
    Relation.ReflTransGen.tail hpath hfg
  exact (faceReachable_iff root g).2 hpath'

end TriangleFamily

namespace Moise

namespace PartialTriangulation

variable {S : Type*} [TopologicalSpace S] (T : PartialTriangulation S)

/-- A finite partial triangulation which covers a connected surface has connected dual graph. -/
theorem isDualConnected_of_support_eq_univ
    [T2Space S] [ConnectedSpace S]
    [ChartedSpace (EuclideanHalfSpace 2) S]
    (hcovers : T.support = Set.univ) :
    TriangleFamily.IsDualConnected T.faces := by
  classical
  by_contra hnotDual
  simp only [TriangleFamily.IsDualConnected, not_forall] at hnotDual
  obtain ⟨root, other, hother⟩ := hnotDual
  let Reach : Finset T.Vertex → Prop :=
    TriangleFamily.FaceReachable T.faces root
  let A : Set S := (T.restrictFaces Reach).support
  let B : Set S := (T.restrictFaces fun t ↦ ¬Reach t).support
  let vertices : Set S :=
    Set.range fun v : T.toIntrinsic.UsedVertex ↦
      T.embed (T.toIntrinsic.vertexPoint v)
  have hAclosed : IsClosed A :=
    (T.restrictFaces Reach).isCompact_support.isClosed
  have hBclosed : IsClosed B :=
    (T.restrictFaces fun t ↦ ¬Reach t).isCompact_support.isClosed
  have hverticesFinite : vertices.Finite :=
    Set.finite_range _
  have hABcover : (Set.univ : Set S) ⊆ A ∪ B := by
    intro x _
    have hxSupport : x ∈ T.support := by
      rw [hcovers]
      exact Set.mem_univ x
    obtain ⟨z, rfl⟩ := hxSupport
    rcases z.2.2 with ⟨t, ht, hzt⟩
    by_cases hReach : Reach t
    · left
      change T.embed z ∈ (T.restrictFaces Reach).support
      rw [T.restrictFaces_support]
      exact ⟨z, ⟨t, ht, hReach, hzt⟩, rfl⟩
    · right
      change T.embed z ∈ (T.restrictFaces fun t ↦ ¬Reach t).support
      rw [T.restrictFaces_support]
      exact ⟨z, ⟨t, ht, hReach, hzt⟩, rfl⟩
  have hABinter : A ∩ B ⊆ vertices := by
    rintro x ⟨hxA, hxB⟩
    change x ∈ (T.restrictFaces Reach).support at hxA
    rw [T.restrictFaces_support] at hxA
    change x ∈ (T.restrictFaces fun t ↦ ¬Reach t).support at hxB
    rw [T.restrictFaces_support] at hxB
    rcases hxA with ⟨a, ⟨f, hf, hfReach, haf⟩, hax⟩
    rcases hxB with ⟨b, ⟨g, hg, hgNotReach, hbg⟩, hbx⟩
    have hab : a = b :=
      T.isEmbedding.injective (hax.trans hbx.symm)
    subst b
    let fFace : TriangleFamily.Face T.faces := ⟨f, hf⟩
    let gFace : TriangleFamily.Face T.faces := ⟨g, hg⟩
    have hnotAdjacent :
        ¬TriangleFamily.FaceAdjacent T.faces fFace gFace :=
      TriangleFamily.not_faceAdjacent_of_faceReachable_of_not
        root fFace gFace hfReach hgNotReach
    have hcard : (f ∩ g).card ≤ 1 := by
      simpa [fFace, gFace] using
        TriangleFamily.card_inter_le_one_of_not_faceAdjacent hnotAdjacent
    have haInter :
        a ∈ T.toIntrinsic.faceCarrier (f ∩ g) := by
      rw [← T.toIntrinsic.faceCarrier_inter f g]
      exact ⟨haf, hbg⟩
    obtain ⟨v, hav⟩ :=
      T.toIntrinsic.exists_eq_vertexPoint_of_mem_faceCarrier_of_card_le_one
        (⟨f, hf⟩ : T.toIntrinsic.Face)
        Finset.inter_subset_left hcard haInter
    refine ⟨v, ?_⟩
    exact (congrArg T.embed hav.symm).trans hax
  have hotherNotReach : ¬Reach other.1 := by
    intro hReach
    apply hother
    exact (TriangleFamily.faceReachable_iff root other).1 hReach
  let rootCenter : S :=
    T.embed (T.toIntrinsic.faceCenter
      (⟨root.1, root.2⟩ : T.toIntrinsic.Face))
  let otherCenter : S :=
    T.embed (T.toIntrinsic.faceCenter
      (⟨other.1, other.2⟩ : T.toIntrinsic.Face))
  have hrootCenterA : rootCenter ∈ A := by
    change rootCenter ∈ (T.restrictFaces Reach).support
    rw [T.restrictFaces_support]
    refine ⟨T.toIntrinsic.faceCenter
      (⟨root.1, root.2⟩ : T.toIntrinsic.Face), ?_, rfl⟩
    refine ⟨root.1, root.2, ?_,
      T.toIntrinsic.faceCenter_mem_faceCarrier
        (⟨root.1, root.2⟩ : T.toIntrinsic.Face)⟩
    exact TriangleFamily.faceReachable_root root
  have hotherCenterB : otherCenter ∈ B := by
    change otherCenter ∈ (T.restrictFaces fun t ↦ ¬Reach t).support
    rw [T.restrictFaces_support]
    refine ⟨T.toIntrinsic.faceCenter
      (⟨other.1, other.2⟩ : T.toIntrinsic.Face), ?_, rfl⟩
    exact ⟨other.1, other.2, hotherNotReach,
      T.toIntrinsic.faceCenter_mem_faceCarrier
        (⟨other.1, other.2⟩ : T.toIntrinsic.Face)⟩
  have hrootCenterNotVertices : rootCenter ∈ verticesᶜ := by
    rintro ⟨v, hv⟩
    apply T.toIntrinsic.faceCenter_ne_vertexPoint
      (⟨root.1, root.2⟩ : T.toIntrinsic.Face) v
    apply T.isEmbedding.injective
    simpa [rootCenter] using hv.symm
  have hotherCenterNotVertices : otherCenter ∈ verticesᶜ := by
    rintro ⟨v, hv⟩
    apply T.toIntrinsic.faceCenter_ne_vertexPoint
      (⟨other.1, other.2⟩ : T.toIntrinsic.Face) v
    apply T.isEmbedding.injective
    simpa [otherCenter] using hv.symm
  have hrootCenterNotB : rootCenter ∈ Bᶜ := by
    intro hrootB
    exact hrootCenterNotVertices (hABinter ⟨hrootCenterA, hrootB⟩)
  have hotherCenterNotA : otherCenter ∈ Aᶜ := by
    intro hotherA
    exact hotherCenterNotVertices (hABinter ⟨hotherA, hotherCenterB⟩)
  have hcover : verticesᶜ ⊆ Bᶜ ∪ Aᶜ := by
    intro x hxVertices
    by_cases hxA : x ∈ A
    · left
      intro hxB
      exact hxVertices (hABinter ⟨hxA, hxB⟩)
    · exact Or.inr hxA
  have hleftNonempty : (verticesᶜ ∩ Bᶜ).Nonempty :=
    ⟨rootCenter, hrootCenterNotVertices, hrootCenterNotB⟩
  have hrightNonempty : (verticesᶜ ∩ Aᶜ).Nonempty :=
    ⟨otherCenter, hotherCenterNotVertices, hotherCenterNotA⟩
  obtain ⟨x, _hxVertices, hxNotB, hxNotA⟩ :=
    (isConnected_compl_finite_surface hverticesFinite).isPreconnected
      Bᶜ Aᶜ hBclosed.isOpen_compl hAclosed.isOpen_compl
      hcover hleftNonempty hrightNonempty
  rcases hABcover (Set.mem_univ x) with hxA | hxB
  · exact hxNotA hxA
  · exact hxNotB hxB

end PartialTriangulation

end Moise

namespace GeometricTriangulation

variable {S : Type*} [TopologicalSpace S] (T : GeometricTriangulation S)

/-- Every finite geometric triangulation of a connected surface has connected dual graph. -/
theorem faces_isDualConnected
    [ConnectedSpace S] [ChartedSpace (EuclideanHalfSpace 2) S] :
    TriangleFamily.IsDualConnected T.faces := by
  letI : T2Space S := T.t2Space
  let P : Moise.PartialTriangulation S := {
    Vertex := T.Vertex
    faces := T.faces
    faces_card := T.faces_card
    embed := T.homeo
    isEmbedding := T.homeo.isEmbedding }
  have hsupport : P.support = Set.univ :=
    Set.range_eq_univ.mpr T.homeo.surjective
  exact P.isDualConnected_of_support_eq_univ hsupport

/-- A finite geometric triangulation of a connected surface carries the complete incidence
certificate needed by the cell-complex bridge. -/
theorem surfaceIncidence
    [ConnectedSpace S] [ChartedSpace (EuclideanHalfSpace 2) S] :
    T.SurfaceIncidence := by
  refine {
    faces_nonempty := T.faces_nonempty
    edge_valence_le_two := ?_
    dual_connected := T.faces_isDualConnected }
  intro e he
  have hecard : e.card = 2 := by
    change e ∈ T.edges at he
    exact T.card_of_mem_edges he
  exact Moise.edge_valence_le_two_of_isEmbedding
    T.faces T.faces_card T.homeo T.homeo.isEmbedding e hecard

end GeometricTriangulation

end ClassificationOfSurfaces
end Topology
end LeanEval
