/-!
# Pairings in canonical normal-form words

This file classifies the directed polygonal identifications generated by both canonical boundary
word families. The nonorientable generators are same-parameter crosscap pairings and
opposite-parameter boundary-seam pairings. The orientable generators are opposite-parameter
`a`-handle, `b`-handle, and boundary-seam pairings. Each pairing appears in both source/target
orders. The free `h` dart in each boundary block occurs only once and contributes no gluing.
-/

namespace LeanEval
namespace Topology
namespace ClassificationOfSurfaces
namespace NormalForm

open SurfaceCellComplex

/-! ## Nonorientable pairing instructions -/

/-- The same-direction identification contributed by the square `aᵢ aᵢ`. -/
def nonOrientableCrosscapIdentification {p n : ℕ} (i : Fin p) :
    PolygonGluing.Identification (nonOrientableCellComplex p n).Face
      (nonOrientableCellComplex p n).faceBoundaryLength :=
  PolygonGluing.Identification.sameDirection
    ((nonOrientableCellComplex p n).occurrenceSide
      (oneFaceOccurrence (nonOrientableBoundaryWord p n)
        (nonOrientableCrosscapPosition p n i 0)))
    ((nonOrientableCellComplex p n).occurrenceSide
      (oneFaceOccurrence (nonOrientableBoundaryWord p n)
        (nonOrientableCrosscapPosition p n i 1)))

/-- The opposite-direction identification contributed by `cⱼ ... cⱼ⁻¹`. -/
def nonOrientableBoundaryIdentification {p n : ℕ} (j : Fin n) :
    PolygonGluing.Identification (nonOrientableCellComplex p n).Face
      (nonOrientableCellComplex p n).faceBoundaryLength :=
  PolygonGluing.Identification.oppositeDirection
    ((nonOrientableCellComplex p n).occurrenceSide
      (oneFaceOccurrence (nonOrientableBoundaryWord p n)
        (nonOrientableBoundaryPosition p n j 0)))
    ((nonOrientableCellComplex p n).occurrenceSide
      (oneFaceOccurrence (nonOrientableBoundaryWord p n)
        (nonOrientableBoundaryPosition p n j 2)))

/-- The reverse ordered direction of a crosscap identification. -/
def nonOrientableCrosscapIdentificationReverse {p n : ℕ} (i : Fin p) :
    PolygonGluing.Identification (nonOrientableCellComplex p n).Face
      (nonOrientableCellComplex p n).faceBoundaryLength :=
  PolygonGluing.Identification.sameDirection
    ((nonOrientableCellComplex p n).occurrenceSide
      (oneFaceOccurrence (nonOrientableBoundaryWord p n)
        (nonOrientableCrosscapPosition p n i 1)))
    ((nonOrientableCellComplex p n).occurrenceSide
      (oneFaceOccurrence (nonOrientableBoundaryWord p n)
        (nonOrientableCrosscapPosition p n i 0)))

/-- The reverse ordered direction of a boundary-seam identification. -/
def nonOrientableBoundaryIdentificationReverse {p n : ℕ} (j : Fin n) :
    PolygonGluing.Identification (nonOrientableCellComplex p n).Face
      (nonOrientableCellComplex p n).faceBoundaryLength :=
  PolygonGluing.Identification.oppositeDirection
    ((nonOrientableCellComplex p n).occurrenceSide
      (oneFaceOccurrence (nonOrientableBoundaryWord p n)
        (nonOrientableBoundaryPosition p n j 2)))
    ((nonOrientableCellComplex p n).occurrenceSide
      (oneFaceOccurrence (nonOrientableBoundaryWord p n)
        (nonOrientableBoundaryPosition p n j 0)))

private theorem identification_eq_of_source_target_direction
    {Face : Type} {sideCount : Face → ℕ}
    {first second : PolygonGluing.Identification Face sideCount}
    (hsource : first.source = second.source)
    (htarget : first.target = second.target)
    (hdirection : first.direction = second.direction) :
    first = second := by
  cases first
  cases second
  simp_all

theorem nonOrientableCrosscapPosition_zero_ne_one
    {p n : ℕ} (i : Fin p) :
    nonOrientableCrosscapPosition p n i 0 ≠
      nonOrientableCrosscapPosition p n i 1 := by
  intro h
  have hval := congrArg Fin.val h
  simp only [nonOrientableCrosscapPosition_val] at hval
  omega

theorem nonOrientableBoundaryPosition_zero_ne_two
    {p n : ℕ} (j : Fin n) :
    nonOrientableBoundaryPosition p n j 0 ≠
      nonOrientableBoundaryPosition p n j 2 := by
  intro h
  have hval := congrArg Fin.val h
  simp only [nonOrientableBoundaryPosition_val] at hval
  omega

theorem nonOrientableBoundaryWord_edgeOccurrences_a {p n : ℕ} (i : Fin p) :
    wordEdgeOccurrences (nonOrientableBoundaryWord p n) (.a i) =
      {nonOrientableCrosscapPosition p n i 0,
        nonOrientableCrosscapPosition p n i 1} := by
  symm
  apply Finset.eq_of_subset_of_card_le
  · intro k hk
    simp only [Finset.mem_insert, Finset.mem_singleton] at hk
    rcases hk with rfl | rfl
    · rw [mem_wordEdgeOccurrences, nonOrientableBoundaryWord_get_crosscap_a_first]
      rfl
    · rw [mem_wordEdgeOccurrences, nonOrientableBoundaryWord_get_crosscap_a_second]
      rfl
  · rw [nonOrientableBoundaryWord_edge_occurrences]
    simp [nonOrientableCrosscapPosition_zero_ne_one (n := n) i]

theorem nonOrientableBoundaryWord_edgeOccurrences_c {p n : ℕ} (j : Fin n) :
    wordEdgeOccurrences (nonOrientableBoundaryWord p n) (.c j) =
      {nonOrientableBoundaryPosition p n j 0,
        nonOrientableBoundaryPosition p n j 2} := by
  symm
  apply Finset.eq_of_subset_of_card_le
  · intro k hk
    simp only [Finset.mem_insert, Finset.mem_singleton] at hk
    rcases hk with rfl | rfl
    · rw [mem_wordEdgeOccurrences, nonOrientableBoundaryWord_get_boundary_c_pos]
      rfl
    · rw [mem_wordEdgeOccurrences, nonOrientableBoundaryWord_get_boundary_c_neg]
      rfl
  · rw [nonOrientableBoundaryWord_edge_occurrences]
    simp [nonOrientableBoundaryPosition_zero_ne_two (p := p) j]

theorem nonOrientableBoundaryWord_edgeOccurrences_h {p n : ℕ} (j : Fin n) :
    wordEdgeOccurrences (nonOrientableBoundaryWord p n) (.h j) =
      {nonOrientableBoundaryPosition p n j 1} := by
  symm
  apply Finset.eq_of_subset_of_card_le
  · intro k hk
    simp only [Finset.mem_singleton] at hk
    subst k
    rw [mem_wordEdgeOccurrences, nonOrientableBoundaryWord_get_boundary_h_pos]
    rfl
  · rw [nonOrientableBoundaryWord_edge_occurrences]
    simp

theorem nonOrientableCrosscapIdentification_mem
    {p n : ℕ} (hp : 1 ≤ p) (i : Fin p) :
    nonOrientableCrosscapIdentification (n := n) i ∈
      (nonOrientableCellComplex p n).polygonalIdentifications
        (nonOrientableCellComplex_occurrencePairingValid hp) := by
  unfold nonOrientableCrosscapIdentification nonOrientableCellComplex
  erw [oneFace_mem_polygonalIdentifications_iff]
  let source := oneFaceOccurrence (nonOrientableBoundaryWord p n)
    (nonOrientableCrosscapPosition p n i 0)
  let target := oneFaceOccurrence (nonOrientableBoundaryWord p n)
    (nonOrientableCrosscapPosition p n i 1)
  have hne : source ≠ target := by
    intro h
    apply nonOrientableCrosscapPosition_zero_ne_one (n := n) i
    have hval := congrArg
      (fun o :
        (oneFacePresentation (NonOrientableEdge p n)
          (nonOrientableBoundaryWord p n)).BoundaryOccurrence ↦ o.2.val) h
    exact Fin.ext hval
  have hsource :
      (nonOrientableCellComplex p n).Occurs (.pos (.a i)) source := by
    exact Or.inl (nonOrientableBoundaryWord_get_crosscap_a_first p n i)
  have htarget :
      (nonOrientableCellComplex p n).Occurs (.pos (.a i)) target := by
    exact Or.inl (nonOrientableBoundaryWord_get_crosscap_a_second p n i)
  have hnotBoundary :
      ¬(nonOrientableCellComplex p n).IsBoundaryDart (.pos (.a i)) :=
    not_isBoundaryDart_of_occurs_at_ne hne hsource htarget
  change
    ¬(oneFacePresentation (NonOrientableEdge p n)
      (nonOrientableBoundaryWord p n)).IsBoundaryDart (.pos (.a i)) at hnotBoundary
  refine ⟨nonOrientableCrosscapPosition p n i 0,
    nonOrientableCrosscapPosition p n i 1, rfl, rfl,
    nonOrientableCrosscapPosition_zero_ne_one i, ?_, ?_, ?_⟩
  · simpa only [nonOrientableBoundaryWord_get_crosscap_a_first] using hnotBoundary
  · simpa only [nonOrientableBoundaryWord_get_crosscap_a_second] using hnotBoundary
  · change
      (nonOrientableBoundaryWord p n).get
          (nonOrientableCrosscapPosition p n i 1) =
        (nonOrientableBoundaryWord p n).get
          (nonOrientableCrosscapPosition p n i 0)
    rw [nonOrientableBoundaryWord_get_crosscap_a_second,
      nonOrientableBoundaryWord_get_crosscap_a_first]

theorem nonOrientableBoundaryIdentification_mem
    {p n : ℕ} (hp : 1 ≤ p) (j : Fin n) :
    nonOrientableBoundaryIdentification (p := p) j ∈
      (nonOrientableCellComplex p n).polygonalIdentifications
        (nonOrientableCellComplex_occurrencePairingValid hp) := by
  unfold nonOrientableBoundaryIdentification nonOrientableCellComplex
  erw [oneFace_mem_polygonalIdentifications_iff]
  let source := oneFaceOccurrence (nonOrientableBoundaryWord p n)
    (nonOrientableBoundaryPosition p n j 0)
  let target := oneFaceOccurrence (nonOrientableBoundaryWord p n)
    (nonOrientableBoundaryPosition p n j 2)
  have hne : source ≠ target := by
    intro h
    apply nonOrientableBoundaryPosition_zero_ne_two (p := p) j
    have hval := congrArg
      (fun o :
        (oneFacePresentation (NonOrientableEdge p n)
          (nonOrientableBoundaryWord p n)).BoundaryOccurrence ↦ o.2.val) h
    exact Fin.ext hval
  have hsource :
      (nonOrientableCellComplex p n).Occurs (.pos (.c j)) source := by
    exact Or.inl (nonOrientableBoundaryWord_get_boundary_c_pos p n j)
  have htarget :
      (nonOrientableCellComplex p n).Occurs (.pos (.c j)) target := by
    exact Or.inr (nonOrientableBoundaryWord_get_boundary_c_neg p n j)
  have hnotBoundary :
      ¬(nonOrientableCellComplex p n).IsBoundaryDart (.pos (.c j)) :=
    not_isBoundaryDart_of_occurs_at_ne hne hsource htarget
  change
    ¬(oneFacePresentation (NonOrientableEdge p n)
      (nonOrientableBoundaryWord p n)).IsBoundaryDart (.pos (.c j)) at hnotBoundary
  refine ⟨nonOrientableBoundaryPosition p n j 0,
    nonOrientableBoundaryPosition p n j 2, rfl, rfl,
    nonOrientableBoundaryPosition_zero_ne_two j, ?_, ?_, ?_⟩
  · simpa only [nonOrientableBoundaryWord_get_boundary_c_pos] using hnotBoundary
  · rw [nonOrientableBoundaryWord_get_boundary_c_neg]
    intro hboundary
    apply hnotBoundary
    exact
      ((oneFacePresentation (NonOrientableEdge p n)
        (nonOrientableBoundaryWord p n)).isBoundaryDart_inv_iff
          (.pos (.c j))).mp hboundary
  · change
      (nonOrientableBoundaryWord p n).get
          (nonOrientableBoundaryPosition p n j 2) =
        SignedDart.flipEquiv (NonOrientableEdge p n)
          ((nonOrientableBoundaryWord p n).get
            (nonOrientableBoundaryPosition p n j 0))
    rw [nonOrientableBoundaryWord_get_boundary_c_neg,
      nonOrientableBoundaryWord_get_boundary_c_pos]
    rfl

theorem nonOrientableCrosscapIdentificationReverse_mem
    {p n : ℕ} (hp : 1 ≤ p) (i : Fin p) :
    nonOrientableCrosscapIdentificationReverse (n := n) i ∈
      (nonOrientableCellComplex p n).polygonalIdentifications
        (nonOrientableCellComplex_occurrencePairingValid hp) := by
  simpa [swapIdentification, nonOrientableCrosscapIdentificationReverse,
      nonOrientableCrosscapIdentification,
      PolygonGluing.Identification.sameDirection] using
    (swapIdentification_mem_polygonalIdentifications
      (nonOrientableCellComplex_occurrencePairingValid hp)
      (nonOrientableCrosscapIdentification_mem (n := n) hp i))

theorem nonOrientableBoundaryIdentificationReverse_mem
    {p n : ℕ} (hp : 1 ≤ p) (j : Fin n) :
    nonOrientableBoundaryIdentificationReverse (p := p) j ∈
      (nonOrientableCellComplex p n).polygonalIdentifications
        (nonOrientableCellComplex_occurrencePairingValid hp) := by
  simpa [swapIdentification, nonOrientableBoundaryIdentificationReverse,
      nonOrientableBoundaryIdentification,
      PolygonGluing.Identification.oppositeDirection] using
    (swapIdentification_mem_polygonalIdentifications
      (nonOrientableCellComplex_occurrencePairingValid hp)
      (nonOrientableBoundaryIdentification_mem (p := p) hp j))

/-- Every directed polygonal identification in the canonical nonorientable word is one of the
two ordered directions of an `aᵢ` or `cⱼ` generator. -/
theorem mem_nonOrientable_polygonalIdentifications_iff
    {p n : ℕ} (hp : 1 ≤ p)
    (identification :
      PolygonGluing.Identification (nonOrientableCellComplex p n).Face
        (nonOrientableCellComplex p n).faceBoundaryLength) :
    identification ∈
        (nonOrientableCellComplex p n).polygonalIdentifications
          (nonOrientableCellComplex_occurrencePairingValid hp) ↔
      (∃ i : Fin p,
          identification = nonOrientableCrosscapIdentification (n := n) i ∨
          identification = nonOrientableCrosscapIdentificationReverse (n := n) i) ∨
      ∃ j : Fin n,
        identification = nonOrientableBoundaryIdentification (p := p) j ∨
        identification = nonOrientableBoundaryIdentificationReverse (p := p) j := by
  constructor
  · intro hidentification
    unfold nonOrientableCellComplex at identification hidentification
    erw [oneFace_mem_polygonalIdentifications_iff] at hidentification
    rcases hidentification with
      ⟨i, j, hsource, htarget, hij, _hsourceBoundary, _htargetBoundary, hcompatible⟩
    have hiMem :
        i ∈ wordEdgeOccurrences (nonOrientableBoundaryWord p n)
          (SignedDart.edgeName ((nonOrientableBoundaryWord p n).get i)) := by
      rw [mem_wordEdgeOccurrences]
    have hjMem :
        j ∈ wordEdgeOccurrences (nonOrientableBoundaryWord p n)
          (SignedDart.edgeName ((nonOrientableBoundaryWord p n).get i)) := by
      rw [mem_wordEdgeOccurrences]
      cases hdirection : identification.direction with
      | same =>
          simp only [hdirection] at hcompatible
          rw [hcompatible]
      | opposite =>
          simp only [hdirection] at hcompatible
          rw [hcompatible]
          exact SignedDart.edgeName_flip _
    cases hedge :
        SignedDart.edgeName ((nonOrientableBoundaryWord p n).get i) with
    | a k =>
        rw [hedge, nonOrientableBoundaryWord_edgeOccurrences_a] at hiMem hjMem
        simp only [Finset.mem_insert, Finset.mem_singleton] at hiMem hjMem
        rcases hiMem with hi | hi <;> rcases hjMem with hj | hj
        · exact (hij (hi.trans hj.symm)).elim
        · subst i
          subst j
          left
          refine ⟨k, Or.inl ?_⟩
          have hdirection : identification.direction = .same := by
            cases hdirection : identification.direction with
            | same => rfl
            | opposite =>
                simp only [hdirection] at hcompatible
                rw [nonOrientableBoundaryWord_get_crosscap_a_second,
                  nonOrientableBoundaryWord_get_crosscap_a_first] at hcompatible
                cases hcompatible
          apply identification_eq_of_source_target_direction
          · simpa [nonOrientableCrosscapIdentification,
              nonOrientableCellComplex,
              PolygonGluing.Identification.sameDirection] using hsource
          · simpa [nonOrientableCrosscapIdentification,
              nonOrientableCellComplex,
              PolygonGluing.Identification.sameDirection] using htarget
          · change identification.direction = .same
            exact hdirection
        · subst i
          subst j
          left
          refine ⟨k, Or.inr ?_⟩
          have hdirection : identification.direction = .same := by
            cases hdirection : identification.direction with
            | same => rfl
            | opposite =>
                simp only [hdirection] at hcompatible
                rw [nonOrientableBoundaryWord_get_crosscap_a_first,
                  nonOrientableBoundaryWord_get_crosscap_a_second] at hcompatible
                cases hcompatible
          apply identification_eq_of_source_target_direction
          · simpa [nonOrientableCrosscapIdentificationReverse,
              nonOrientableCellComplex,
              PolygonGluing.Identification.sameDirection] using hsource
          · simpa [nonOrientableCrosscapIdentificationReverse,
              nonOrientableCellComplex,
              PolygonGluing.Identification.sameDirection] using htarget
          · change identification.direction = .same
            exact hdirection
        · exact (hij (hi.trans hj.symm)).elim
    | c k =>
        rw [hedge, nonOrientableBoundaryWord_edgeOccurrences_c] at hiMem hjMem
        simp only [Finset.mem_insert, Finset.mem_singleton] at hiMem hjMem
        rcases hiMem with hi | hi <;> rcases hjMem with hj | hj
        · exact (hij (hi.trans hj.symm)).elim
        · subst i
          subst j
          right
          refine ⟨k, Or.inl ?_⟩
          have hdirection : identification.direction = .opposite := by
            cases hdirection : identification.direction with
            | same =>
                simp only [hdirection] at hcompatible
                rw [nonOrientableBoundaryWord_get_boundary_c_neg,
                  nonOrientableBoundaryWord_get_boundary_c_pos] at hcompatible
                cases hcompatible
            | opposite => rfl
          apply identification_eq_of_source_target_direction
          · simpa [nonOrientableBoundaryIdentification,
              nonOrientableCellComplex,
              PolygonGluing.Identification.oppositeDirection] using hsource
          · simpa [nonOrientableBoundaryIdentification,
              nonOrientableCellComplex,
              PolygonGluing.Identification.oppositeDirection] using htarget
          · change identification.direction = .opposite
            exact hdirection
        · subst i
          subst j
          right
          refine ⟨k, Or.inr ?_⟩
          have hdirection : identification.direction = .opposite := by
            cases hdirection : identification.direction with
            | same =>
                simp only [hdirection] at hcompatible
                rw [nonOrientableBoundaryWord_get_boundary_c_pos,
                  nonOrientableBoundaryWord_get_boundary_c_neg] at hcompatible
                cases hcompatible
            | opposite => rfl
          apply identification_eq_of_source_target_direction
          · simpa [nonOrientableBoundaryIdentificationReverse,
              nonOrientableCellComplex,
              PolygonGluing.Identification.oppositeDirection] using hsource
          · simpa [nonOrientableBoundaryIdentificationReverse,
              nonOrientableCellComplex,
              PolygonGluing.Identification.oppositeDirection] using htarget
          · change identification.direction = .opposite
            exact hdirection
        · exact (hij (hi.trans hj.symm)).elim
    | h k =>
        rw [hedge, nonOrientableBoundaryWord_edgeOccurrences_h] at hiMem hjMem
        simp only [Finset.mem_singleton] at hiMem hjMem
        exact (hij (hiMem.trans hjMem.symm)).elim
  · rintro (⟨i, rfl | rfl⟩ | ⟨j, rfl | rfl⟩)
    · exact nonOrientableCrosscapIdentification_mem hp i
    · exact nonOrientableCrosscapIdentificationReverse_mem hp i
    · exact nonOrientableBoundaryIdentification_mem hp j
    · exact nonOrientableBoundaryIdentificationReverse_mem hp j

/-! ## Orientable pairing instructions -/

theorem orientableHandlePosition_zero_ne_two
    {p n : ℕ} (i : Fin p) :
    orientableHandlePosition p n i 0 ≠
      orientableHandlePosition p n i 2 := by
  intro h
  have hval := congrArg Fin.val h
  simp only [orientableHandlePosition_val] at hval
  omega

theorem orientableHandlePosition_one_ne_three
    {p n : ℕ} (i : Fin p) :
    orientableHandlePosition p n i 1 ≠
      orientableHandlePosition p n i 3 := by
  intro h
  have hval := congrArg Fin.val h
  simp only [orientableHandlePosition_val] at hval
  omega

theorem orientableBoundaryPosition_zero_ne_two
    {p n : ℕ} (j : Fin n) :
    orientableBoundaryPosition p n j 0 ≠
      orientableBoundaryPosition p n j 2 := by
  intro h
  have hval := congrArg Fin.val h
  simp only [orientableBoundaryPosition_val] at hval
  omega

theorem orientableBoundaryWord_edgeOccurrences_a {p n : ℕ} (i : Fin p) :
    wordEdgeOccurrences (orientableBoundaryWord p n) (.a i) =
      {orientableHandlePosition p n i 0,
        orientableHandlePosition p n i 2} := by
  symm
  apply Finset.eq_of_subset_of_card_le
  · intro k hk
    simp only [Finset.mem_insert, Finset.mem_singleton] at hk
    rcases hk with rfl | rfl
    · rw [mem_wordEdgeOccurrences, orientableBoundaryWord_get_handle_a_pos]
      rfl
    · rw [mem_wordEdgeOccurrences, orientableBoundaryWord_get_handle_a_neg]
      rfl
  · rw [orientableBoundaryWord_edge_occurrences]
    simp [orientableHandlePosition_zero_ne_two (n := n) i]

