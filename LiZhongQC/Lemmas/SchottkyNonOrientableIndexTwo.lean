import Mathlib.Tactic.Linarith
import Mathlib.Tactic.Ring

/-!
# An index-two subgroup of `⟨a₀, …, a_{p-1} | ∏ aᵢ²⟩` with odd real first Betti number

For `p ≥ 2` let `Π_p = ⟨a₀, …, a_{p-1} | a₀² ⋯ a_{p-1}²⟩` (the fundamental group of the closed
non-orientable surface `N_p`) and `χ : Π_p → ℤ/2`, `a₀ ↦ 1`, `aᵢ ↦ 0` (`i ≠ 0`).  Then
`K = ker χ` has index `2` and `dim_ℝ Hom(K, ℝ) = 2p - 3` (`s78no_indexTwo_finrank`); `K` is
the fundamental group of the non-orientable double cover `N_{2p-2}`.

* `s78no_ker_le_closure`: Schreier generators of an index-two kernel.
* `s78no_exists_affine_rep`: the affine representation of `Π_p` on `ℝ²` realising every
  admissible character of `K`.
-/

open Set

noncomputable section
namespace LiZhongQC

/-- An element of `Multiplicative (ZMod 2)` is `1` or the generator. -/
theorem s78no_zmod2_cases (z : Multiplicative (ZMod 2)) :
    z = 1 ∨ z = Multiplicative.ofAdd 1 := by
  revert z; decide

/-- **Schreier generators of an index-two kernel.**  Let `χ : G → ℤ/2` send `t` to the generator
and every element of `A` to `0`, where `t` and `A` generate `G`.  Then `ker χ` is generated by
`t²`, `A` and the conjugates `t a t⁻¹`, `a ∈ A`. -/
theorem s78no_ker_le_closure {G : Type*} [Group G] (χ : G →* Multiplicative (ZMod 2)) (t : G)
    (ht : χ t = Multiplicative.ofAdd 1) (A : Set G)
    (hA : Subgroup.closure (insert t A) = ⊤) (hAχ : ∀ a ∈ A, χ a = 1) :
    χ.ker ≤ Subgroup.closure ({t ^ 2} ∪ A ∪ (fun a => t * a * t⁻¹) '' A) := by
  set H := Subgroup.closure ({t ^ 2} ∪ A ∪ (fun a => t * a * t⁻¹) '' A) with hH
  have ht2 : t ^ 2 ∈ H := Subgroup.subset_closure (by simp)
  have hAH : ∀ a ∈ A, a ∈ H := fun a ha => Subgroup.subset_closure (Or.inl (Or.inr ha))
  have hBH : ∀ a ∈ A, t * a * t⁻¹ ∈ H :=
    fun a ha => Subgroup.subset_closure (Or.inr ⟨a, ha, rfl⟩)
  -- conjugation by `t` preserves `H`
  have hconj : ∀ h ∈ H, t * h * t⁻¹ ∈ H := by
    intro h hh
    induction hh using Subgroup.closure_induction with
    | mem x hx =>
      rcases hx with (hx | hx) | ⟨a, ha, rfl⟩
      · rw [Set.mem_singleton_iff] at hx; subst hx
        have : t * t ^ 2 * t⁻¹ = t ^ 2 := by simp only [pow_two]; group
        rw [this]; exact ht2
      · exact hBH x hx
      · have : t * (t * a * t⁻¹) * t⁻¹ = t ^ 2 * a * (t ^ 2)⁻¹ := by simp only [pow_two]; group
        rw [this]
        exact H.mul_mem (H.mul_mem ht2 (hAH a ha)) (H.inv_mem ht2)
    | one => simp
    | mul x y _ _ hx hy =>
      have : t * (x * y) * t⁻¹ = (t * x * t⁻¹) * (t * y * t⁻¹) := by group
      rw [this]; exact H.mul_mem hx hy
    | inv x _ hx =>
      have : t * x⁻¹ * t⁻¹ = (t * x * t⁻¹)⁻¹ := by group
      rw [this]; exact H.inv_mem hx
  -- every element is in `H` or in `H t`
  have key : ∀ g : G, (χ g = 1 → g ∈ H) ∧ (χ g = Multiplicative.ofAdd 1 → g * t⁻¹ ∈ H) := by
    intro g
    have hg : g ∈ Subgroup.closure (insert t A) := by rw [hA]; trivial
    induction hg using Subgroup.closure_induction with
    | mem x hx =>
      rcases hx with rfl | hx
      · refine ⟨fun h => ?_, fun _ => by simp⟩
        rw [ht] at h; exact absurd h (by decide)
      · refine ⟨fun _ => hAH x hx, fun h => ?_⟩
        rw [hAχ x hx] at h; exact absurd h (by decide)
    | one => exact ⟨fun _ => H.one_mem, fun h => absurd h (by rw [map_one]; decide)⟩
    | mul x y _ _ hx hy =>
      constructor
      · intro hxy
        rw [map_mul] at hxy
        rcases s78no_zmod2_cases (χ x) with h1 | h1 <;>
          rcases s78no_zmod2_cases (χ y) with h2 | h2
        · exact H.mul_mem (hx.1 h1) (hy.1 h2)
        · rw [h1, h2] at hxy; exact absurd hxy (by decide)
        · rw [h1, h2] at hxy; exact absurd hxy (by decide)
        · have : x * y = (x * t⁻¹) * (t * (y * t⁻¹) * t⁻¹) * t ^ 2 := by simp only [pow_two]; group
          rw [this]
          exact H.mul_mem (H.mul_mem (hx.2 h1) (hconj _ (hy.2 h2))) ht2
      · intro hxy
        rw [map_mul] at hxy
        rcases s78no_zmod2_cases (χ x) with h1 | h1 <;>
          rcases s78no_zmod2_cases (χ y) with h2 | h2
        · rw [h1, h2] at hxy; exact absurd hxy (by decide)
        · have : x * y * t⁻¹ = x * (y * t⁻¹) := by group
          rw [this]; exact H.mul_mem (hx.1 h1) (hy.2 h2)
        · have : x * y * t⁻¹ = (x * t⁻¹) * (t * y * t⁻¹) := by group
          rw [this]; exact H.mul_mem (hx.2 h1) (hconj _ (hy.1 h2))
        · rw [h1, h2] at hxy; exact absurd hxy (by decide)
    | inv x _ hx =>
      constructor
      · intro h
        rw [map_inv] at h
        exact H.inv_mem (hx.1 (inv_eq_one.mp h))
      · intro h
        have h' : χ x = Multiplicative.ofAdd 1 := by
          rw [map_inv] at h
          rcases s78no_zmod2_cases (χ x) with h1 | h1
          · rw [h1] at h; exact absurd h (by decide)
          · exact h1
        have : x⁻¹ * t⁻¹ = (t * (x * t⁻¹) * t⁻¹ * t ^ 2)⁻¹ := by simp only [pow_two]; group
        rw [this]
        exact H.inv_mem (H.mul_mem (hconj _ (hx.2 h')) ht2)
  intro g hg
  exact (key g).1 hg

/-- A monoid hom commutes with ordered products of `List.ofFn`. -/
theorem s78no_ofFn_prod_map {M N : Type*} [Monoid M] [Monoid N] (C : M →* N) :
    ∀ (n : ℕ) (g : Fin n → M), (List.ofFn fun i => C (g i)).prod = C (List.ofFn g).prod
  | 0, g => by simp
  | n + 1, g => by
    rw [List.ofFn_succ, List.ofFn_succ, List.prod_cons, List.prod_cons, map_mul,
      s78no_ofFn_prod_map C n (fun i => g i.succ)]

/-- A real character of a subgroup, evaluated on a product of subgroup elements. -/
theorem s78no_hom_ofFn_prod {G : Type*} [Group G] (K : Subgroup G) (φ : Additive K →+ ℝ) :
    ∀ (n : ℕ) (f : Fin n → G) (hf : ∀ i, f i ∈ K),
      φ (Additive.ofMul ⟨(List.ofFn f).prod, K.list_prod_mem (by
        intro g hg; obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hg; exact hf i)⟩) =
        ∑ i, φ (Additive.ofMul ⟨f i, hf i⟩)
  | 0, f, hf => by
    simp only [List.ofFn_zero, Finset.univ_eq_empty, Finset.sum_empty]
    exact φ.map_zero
  | n + 1, f, hf => by
    have ih := s78no_hom_ofFn_prod K φ n (fun i => f i.succ) (fun i => hf i.succ)
    rw [Fin.sum_univ_succ, ← ih, ← map_add, ← ofMul_mul]
    congr 2
    apply Subtype.ext
    simp [List.ofFn_succ]

/-- The affine representation of `⟨a₀, …, a_{p-1} | ∏ aᵢ²⟩` on `ℝ²` used to construct real
characters of the index-two subgroup: `a₀ ↦ (v ↦ swap v + (0, x₀))`, `aᵢ ↦ (v ↦ v + (xᵢ, yᵢ))`
for `i ≠ 0`.  It is well defined when `x₀ = y₀`, `x₀ + 2 ∑_{i≠0} xᵢ = 0`, `y₀ + 2 ∑_{i≠0} yᵢ = 0`. -/
theorem s78no_exists_affine_rep (p : ℕ) (x y : Fin p → ℝ)
    (h0 : ∀ i : Fin p, i.val = 0 → x i = y i)
    (h1 : ∑ i : Fin p, (if i.val = 0 then (1 : ℝ) else 2) * x i = 0)
    (h2 : ∑ i : Fin p, (if i.val = 0 then (1 : ℝ) else 2) * y i = 0) :
    ∃ Ψ : PresentedGroup ({(List.ofFn fun i : Fin p => FreeGroup.of i ^ 2).prod} :
        Set (FreeGroup (Fin p))) →* ((ℝ × ℝ) ≃ᵃ[ℝ] (ℝ × ℝ)),
      ∀ i : Fin p, Ψ (PresentedGroup.of i) =
        if i.val = 0 then
          AffineEquiv.constVAdd ℝ (ℝ × ℝ) (0, x i) *
            (LinearEquiv.prodComm ℝ ℝ ℝ).toAffineEquiv
        else AffineEquiv.constVAdd ℝ (ℝ × ℝ) (x i, y i) := by
  set f : Fin p → ((ℝ × ℝ) ≃ᵃ[ℝ] (ℝ × ℝ)) := fun i =>
    if i.val = 0 then
      AffineEquiv.constVAdd ℝ (ℝ × ℝ) (0, x i) * (LinearEquiv.prodComm ℝ ℝ ℝ).toAffineEquiv
    else AffineEquiv.constVAdd ℝ (ℝ × ℝ) (x i, y i) with hf
  have hsq : ∀ i, f i ^ 2 = AffineEquiv.constVAddHom ℝ (ℝ × ℝ)
      (Multiplicative.ofAdd ((if i.val = 0 then (1 : ℝ) else 2) * x i,
        (if i.val = 0 then (1 : ℝ) else 2) * y i)) := by
    intro i
    apply AffineEquiv.ext
    intro v
    by_cases hi : i.val = 0
    · have hxy := h0 i hi
      simp only [hf, hi, ite_true, pow_two, AffineEquiv.coe_mul, Function.comp_apply,
        AffineEquiv.constVAddHom_apply, toAdd_ofAdd, one_mul]
      simp [AffineEquiv.constVAdd_apply, LinearEquiv.prodComm_apply, hxy, Prod.ext_iff]
    · simp only [hf, hi, ite_false, pow_two, AffineEquiv.coe_mul, Function.comp_apply,
        AffineEquiv.constVAddHom_apply, toAdd_ofAdd]
      simp [AffineEquiv.constVAdd_apply, Prod.ext_iff]
      all_goals constructor <;> ring
  have hrel : ∀ r ∈ ({(List.ofFn fun i : Fin p => FreeGroup.of i ^ 2).prod} :
      Set (FreeGroup (Fin p))), FreeGroup.lift f r = 1 := by
    intro r hr
    rw [Set.mem_singleton_iff] at hr
    subst hr
    rw [map_list_prod, List.map_ofFn]
    have : (FreeGroup.lift f) ∘ (fun i : Fin p => FreeGroup.of i ^ 2) = fun i => f i ^ 2 := by
      funext i; simp
    rw [this]
    simp_rw [hsq]
    rw [s78no_ofFn_prod_map, List.prod_ofFn, ← ofAdd_sum]
    have hsum : (∑ i : Fin p, ((if i.val = 0 then (1 : ℝ) else 2) * x i,
        (if i.val = 0 then (1 : ℝ) else 2) * y i)) = 0 := by
      rw [Prod.ext_iff]
      simp only [Prod.fst_sum, Prod.snd_sum, Prod.fst_zero, Prod.snd_zero]
      exact ⟨h1, h2⟩
    rw [hsum, ofAdd_zero, map_one]
  exact ⟨PresentedGroup.toGroup hrel, fun i => by rw [PresentedGroup.toGroup.of]⟩

/-- **The index-two subgroup of `⟨a₀, …, a_{p-1} | ∏ aᵢ²⟩` with odd first Betti number.**  For
`p ≥ 2`, the kernel `K` of `χ : aᵢ ↦ [i = 0] ∈ ℤ/2` has index `2` and
`dim_ℝ Hom(K, ℝ) = 2p - 3`.  (Schreier generators `a₀²`, `aᵢ`, `a₀ aᵢ a₀⁻¹` (`i ≠ 0`), which give
coordinates; the two Schreier relations `a₀² ∏ aᵢ² = 1`, `a₀² ∏ (a₀ aᵢ a₀⁻¹)² = 1` cut out the image;
every admissible coordinate vector is realised by the affine representation
`s78no_exists_affine_rep`.) -/
theorem s78no_indexTwo_finrank (p : ℕ) (hp : 2 ≤ p) :
    ∃ K : Subgroup (PresentedGroup ({(List.ofFn fun i : Fin p => FreeGroup.of i ^ 2).prod} :
        Set (FreeGroup (Fin p)))),
      K.index = 2 ∧ Module.finrank ℝ (Additive K →+ ℝ) = 2 * p - 3 := by
  classical
  set R : Set (FreeGroup (Fin p)) := {(List.ofFn fun i : Fin p => FreeGroup.of i ^ 2).prod}
    with hR
  set i0 : Fin p := ⟨0, by omega⟩ with hi0
  set i1 : Fin p := ⟨1, by omega⟩ with hi1
  set t : PresentedGroup R := PresentedGroup.of i0 with ht
  -- the character `χ`
  set fχ : Fin p → Multiplicative (ZMod 2) := fun i =>
    if i.val = 0 then Multiplicative.ofAdd 1 else 1 with hfχ
  have hχrel : ∀ r ∈ R, FreeGroup.lift fχ r = 1 := by
    intro r hr
    rw [hR, Set.mem_singleton_iff] at hr
    subst hr
    rw [map_list_prod, List.map_ofFn]
    have : (FreeGroup.lift fχ) ∘ (fun i : Fin p => FreeGroup.of i ^ 2) = fun _ => 1 := by
      funext i
      simp only [Function.comp_apply, map_pow, FreeGroup.lift_apply_of, hfχ]
      split_ifs <;> decide
    rw [this]
    simp
  set χ := PresentedGroup.toGroup hχrel with hχ
  have hχof : ∀ i, χ (PresentedGroup.of i) = fχ i := fun i => PresentedGroup.toGroup.of hχrel
  have hχt : χ t = Multiplicative.ofAdd 1 := by rw [ht, hχof]; simp [hfχ, hi0]
  have hχa : ∀ i : Fin p, i.val ≠ 0 → χ (PresentedGroup.of i) = 1 := by
    intro i hi; rw [hχof]; simp [hfχ, hi]
  -- the relation in the group
  have hrelG : (List.ofFn fun i : Fin p => (PresentedGroup.of i : PresentedGroup R) ^ 2).prod
      = 1 := by
    have h := PresentedGroup.one_of_mem (rels := R)
      (x := (List.ofFn fun i : Fin p => FreeGroup.of i ^ 2).prod) rfl
    rw [map_list_prod, List.map_ofFn] at h
    exact h
  refine ⟨χ.ker, ?_, ?_⟩
  · -- index two
    rw [Subgroup.index_ker]
    have hrange : χ.range = ⊤ := by
      rw [eq_top_iff]
      intro z _
      rcases s78no_zmod2_cases z with rfl | rfl
      · exact χ.range.one_mem
      · exact ⟨t, hχt⟩
    rw [hrange, Subgroup.card_top, Nat.card_eq_fintype_card]
    rfl
  -- coordinates
  set c : Fin p → PresentedGroup R := fun i =>
    if i.val = 0 then t ^ 2 else PresentedGroup.of i with hc
  set d : Fin p → PresentedGroup R := fun i =>
    if i.val = 0 then t ^ 2 else t * PresentedGroup.of i * t⁻¹ with hd
  have ht2 : t ^ 2 ∈ χ.ker := by
    rw [MonoidHom.mem_ker, map_pow, hχt]; decide
  have hcK : ∀ i, c i ∈ χ.ker := by
    intro i
    by_cases hi : i.val = 0
    · simp only [hc, hi, ite_true]; exact ht2
    · simp only [hc, hi, ite_false]; exact hχa i hi
  have hdK : ∀ i, d i ∈ χ.ker := by
    intro i
    by_cases hi : i.val = 0
    · simp only [hd, hi, ite_true]; exact ht2
    · simp only [hd, hi, ite_false, MonoidHom.mem_ker, map_mul, hχa i hi, mul_one]
      exact mul_inv_cancel _
  set w : Fin p → ℝ := fun i => if i.val = 0 then 1 else 2 with hw
  let C : (Additive χ.ker →+ ℝ) →ₗ[ℝ] (Fin p → ℝ) × (Fin p → ℝ) :=
    { toFun := fun φ => (fun i => φ (Additive.ofMul ⟨c i, hcK i⟩),
        fun i => φ (Additive.ofMul ⟨d i, hdK i⟩))
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  let L : (Fin p → ℝ) × (Fin p → ℝ) →ₗ[ℝ] (Fin 3 → ℝ) :=
    { toFun := fun v => ![v.1 i0 - v.2 i0, ∑ i, w i * v.1 i, ∑ i, w i * v.2 i]
      map_add' := by
        intro u v; ext j; fin_cases j <;>
          simp [Finset.sum_add_distrib, mul_add] <;> ring
      map_smul' := by
        intro a v; ext j; fin_cases j
        all_goals simp [Finset.mul_sum, mul_sub, mul_left_comm] }
  -- (I) injectivity: Schreier generation
  have hgen : χ.ker ≤ Subgroup.closure ({t ^ 2} ∪ {g | ∃ i : Fin p, i.val ≠ 0 ∧
      g = PresentedGroup.of i} ∪ (fun a => t * a * t⁻¹) ''
        {g | ∃ i : Fin p, i.val ≠ 0 ∧ g = PresentedGroup.of i}) := by
    apply s78no_ker_le_closure χ t hχt
    · rw [eq_top_iff, ← PresentedGroup.closure_range_of R]
      apply Subgroup.closure_mono
      rintro g ⟨i, rfl⟩
      by_cases hi : i.val = 0
      · left; rw [ht]; congr 1; exact Fin.ext hi
      · right; exact ⟨i, hi, rfl⟩
    · rintro a ⟨i, hi, rfl⟩; exact hχa i hi
  have hinj : Function.Injective C := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro φ hφ
    have hcz : ∀ i, φ (Additive.ofMul ⟨c i, hcK i⟩) = 0 := fun i =>
      congrFun (congrArg Prod.fst hφ) i
    have hdz : ∀ i, φ (Additive.ofMul ⟨d i, hdK i⟩) = 0 := fun i =>
      congrFun (congrArg Prod.snd hφ) i
    refine AddMonoidHom.ext fun k => ?_
    obtain ⟨⟨g, hg⟩, rfl⟩ : ∃ x : χ.ker, Additive.ofMul x = k := ⟨Additive.toMul k, rfl⟩
    show _ = 0
    have hall : ∀ g ∈ Subgroup.closure ({t ^ 2} ∪ {g | ∃ i : Fin p, i.val ≠ 0 ∧
        g = PresentedGroup.of i} ∪ (fun a => t * a * t⁻¹) ''
          {g | ∃ i : Fin p, i.val ≠ 0 ∧ g = PresentedGroup.of i}),
        ∃ hgK : g ∈ χ.ker, φ (Additive.ofMul ⟨g, hgK⟩) = 0 := by
      intro g hg
      induction hg using Subgroup.closure_induction with
      | mem x hx =>
        rcases hx with (hx | ⟨i, hi, rfl⟩) | ⟨a, ⟨i, hi, rfl⟩, rfl⟩
        · rw [Set.mem_singleton_iff] at hx; subst hx
          refine ⟨ht2, ?_⟩
          have := hcz i0
          simpa [hc, hi0] using this
        · refine ⟨hχa i hi, ?_⟩
          have := hcz i
          simpa [hc, hi] using this
        · refine ⟨by simpa [hd, hi] using hdK i, ?_⟩
          have := hdz i
          simpa [hd, hi] using this
      | one => exact ⟨χ.ker.one_mem, φ.map_zero⟩
      | mul x y _ _ hx hy =>
        obtain ⟨hxK, hx0⟩ := hx
        obtain ⟨hyK, hy0⟩ := hy
        refine ⟨χ.ker.mul_mem hxK hyK, ?_⟩
        have : (⟨x * y, χ.ker.mul_mem hxK hyK⟩ : χ.ker) = ⟨x, hxK⟩ * ⟨y, hyK⟩ := rfl
        rw [this, ofMul_mul, map_add, hx0, hy0, add_zero]
      | inv x _ hx =>
        obtain ⟨hxK, hx0⟩ := hx
        refine ⟨χ.ker.inv_mem hxK, ?_⟩
        have : (⟨x⁻¹, χ.ker.inv_mem hxK⟩ : χ.ker) = (⟨x, hxK⟩)⁻¹ := rfl
        rw [this, ofMul_inv, map_neg, hx0, neg_zero]
    obtain ⟨_, h0⟩ := hall g (hgen hg)
    exact h0
  -- (II a) the image lies in `ker L`
  have hsqK : ∀ i, (PresentedGroup.of i : PresentedGroup R) ^ 2 ∈ χ.ker := by
    intro i
    rw [MonoidHom.mem_ker, map_pow]
    rcases s78no_zmod2_cases (χ (PresentedGroup.of i)) with h | h <;> rw [h] <;> decide
  have hsqK' : ∀ i, t * (PresentedGroup.of i : PresentedGroup R) ^ 2 * t⁻¹ ∈ χ.ker :=
    fun i => (χ.normal_ker).conj_mem _ (hsqK i) t
  have hrelG' : (List.ofFn fun i : Fin p =>
      t * (PresentedGroup.of i : PresentedGroup R) ^ 2 * t⁻¹).prod = 1 := by
    have h := s78no_ofFn_prod_map (MulAut.conj t).toMonoidHom p
      (fun i : Fin p => (PresentedGroup.of i : PresentedGroup R) ^ 2)
    simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply] at h
    rw [h, hrelG]; group
  have hrange_le : LinearMap.range C ≤ LinearMap.ker L := by
    rintro v ⟨φ, rfl⟩
    rw [LinearMap.mem_ker]
    have e1 := s78no_hom_ofFn_prod χ.ker φ p
      (fun i => (PresentedGroup.of i : PresentedGroup R) ^ 2) hsqK
    have e2 := s78no_hom_ofFn_prod χ.ker φ p
      (fun i => t * (PresentedGroup.of i : PresentedGroup R) ^ 2 * t⁻¹) hsqK'
    have l1 : (⟨(List.ofFn fun i : Fin p => (PresentedGroup.of i : PresentedGroup R) ^ 2).prod,
        χ.ker.list_prod_mem (by
          intro g hg; obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hg; exact hsqK i)⟩ : χ.ker) = 1 :=
      Subtype.ext hrelG
    have l2 : (⟨(List.ofFn fun i : Fin p =>
        t * (PresentedGroup.of i : PresentedGroup R) ^ 2 * t⁻¹).prod,
        χ.ker.list_prod_mem (by
          intro g hg; obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hg; exact hsqK' i)⟩ : χ.ker) = 1 :=
      Subtype.ext hrelG'
    rw [l1, ofMul_one, map_zero] at e1
    rw [l2, ofMul_one, map_zero] at e2
    have t1 : ∀ i, φ (Additive.ofMul ⟨(PresentedGroup.of i : PresentedGroup R) ^ 2, hsqK i⟩) =
        w i * φ (Additive.ofMul ⟨c i, hcK i⟩) := by
      intro i
      by_cases hi : i.val = 0
      · have hii : i = i0 := Fin.ext hi
        have : (⟨(PresentedGroup.of i : PresentedGroup R) ^ 2, hsqK i⟩ : χ.ker) =
            ⟨c i, hcK i⟩ := Subtype.ext (by subst hii; simp [hc, ht, hi0])
        rw [this]; simp [hw, hi]
      · have : (⟨(PresentedGroup.of i : PresentedGroup R) ^ 2, hsqK i⟩ : χ.ker) =
            ⟨c i, hcK i⟩ * ⟨c i, hcK i⟩ := Subtype.ext (by simp [hc, hi, pow_two])
        rw [this, ofMul_mul, map_add]; simp [hw, hi]; ring
    have t2 : ∀ i, φ (Additive.ofMul ⟨t * (PresentedGroup.of i : PresentedGroup R) ^ 2 * t⁻¹,
        hsqK' i⟩) = w i * φ (Additive.ofMul ⟨d i, hdK i⟩) := by
      intro i
      by_cases hi : i.val = 0
      · have hii : i = i0 := Fin.ext hi
        have : (⟨t * (PresentedGroup.of i : PresentedGroup R) ^ 2 * t⁻¹, hsqK' i⟩ : χ.ker) =
            ⟨d i, hdK i⟩ := Subtype.ext (by
              simp only [hd, hi, ite_true]; rw [hii, ← ht]; simp only [pow_two]; group)
        rw [this]; simp [hw, hi]
      · have : (⟨t * (PresentedGroup.of i : PresentedGroup R) ^ 2 * t⁻¹, hsqK' i⟩ : χ.ker) =
            ⟨d i, hdK i⟩ * ⟨d i, hdK i⟩ := Subtype.ext (by
              simp only [hd, hi, ite_false, Subgroup.coe_mul, pow_two]; group)
        rw [this, ofMul_mul, map_add]; simp [hw, hi]; ring
    simp only [t1] at e1
    simp only [t2] at e2
    ext j
    fin_cases j
    · simp [L, C, hc, hd, hi0]
    · simpa [L, C] using e1.symm
    · simpa [L, C] using e2.symm
  -- (II b) every vector of `ker L` is realised
  have hle_range : LinearMap.ker L ≤ LinearMap.range C := by
    intro v hv
    rw [LinearMap.mem_ker] at hv
    have h0 : v.1 i0 = v.2 i0 := by
      have := congrFun hv 0; simp [L] at this; linarith
    have h1 : ∑ i : Fin p, (if i.val = 0 then (1 : ℝ) else 2) * v.1 i = 0 := by
      have := congrFun hv 1; simpa [L, hw] using this
    have h2 : ∑ i : Fin p, (if i.val = 0 then (1 : ℝ) else 2) * v.2 i = 0 := by
      have := congrFun hv 2; simpa [L, hw] using this
    obtain ⟨Ψ, hΨ⟩ := s78no_exists_affine_rep p v.1 v.2
      (fun i hi => by rw [show i = i0 from Fin.ext hi]; exact h0) h1 h2
    set swapL := LinearEquiv.prodComm ℝ ℝ ℝ with hswapL
    set lin := (AffineEquiv.linearHom (k := ℝ) (P₁ := ℝ × ℝ)).comp Ψ with hlin
    have hswap2 : swapL * swapL = 1 := LinearEquiv.ext fun u => by simp [hswapL]
    have hswapinv : swapL⁻¹ = swapL := LinearEquiv.ext fun u => by
      simp [hswapL, LinearEquiv.coe_inv]
    have hlinof : ∀ i, lin (PresentedGroup.of i) = if i.val = 0 then swapL else 1 := by
      intro i
      simp only [hlin, MonoidHom.coe_comp, Function.comp_apply, hΨ i]
      split_ifs
      · rw [map_mul]; ext u <;> rfl
      · ext u <;> simp
    have hlinχ : ∀ g, (χ g = 1 → lin g = 1) ∧ (χ g = Multiplicative.ofAdd 1 → lin g = swapL) := by
      intro g
      have hg : g ∈ Subgroup.closure (Set.range (PresentedGroup.of : Fin p → PresentedGroup R)) := by
        rw [PresentedGroup.closure_range_of]; trivial
      induction hg using Subgroup.closure_induction with
      | mem x hx =>
        obtain ⟨i, rfl⟩ := hx
        rw [hlinof, hχof]
        by_cases hi : i.val = 0
        · simp only [hfχ, hi, ite_true]
          exact ⟨fun h => absurd h (by decide), fun _ => trivial⟩
        · simp only [hfχ, hi, ite_false]
          exact ⟨fun _ => trivial, fun h => absurd h (by decide)⟩
      | one => exact ⟨fun _ => map_one _, fun h => absurd h (by rw [map_one]; decide)⟩
      | mul x y _ _ hx hy =>
        rcases s78no_zmod2_cases (χ x) with h1 | h1 <;>
          rcases s78no_zmod2_cases (χ y) with h2 | h2
        · refine ⟨fun _ => by rw [map_mul, hx.1 h1, hy.1 h2, one_mul], fun h => ?_⟩
          rw [map_mul, h1, h2] at h; exact absurd h (by decide)
        · refine ⟨fun h => ?_, fun _ => by rw [map_mul, hx.1 h1, hy.2 h2, one_mul]⟩
          rw [map_mul, h1, h2] at h; exact absurd h (by decide)
        · refine ⟨fun h => ?_, fun _ => by rw [map_mul, hx.2 h1, hy.1 h2, mul_one]⟩
          rw [map_mul, h1, h2] at h; exact absurd h (by decide)
        · refine ⟨fun _ => by rw [map_mul, hx.2 h1, hy.2 h2, hswap2], fun h => ?_⟩
          rw [map_mul, h1, h2] at h; exact absurd h (by decide)
      | inv x _ hx =>
        rcases s78no_zmod2_cases (χ x) with h1 | h1
        · refine ⟨fun _ => by rw [map_inv, hx.1 h1, inv_one], fun h => ?_⟩
          rw [map_inv, h1] at h; exact absurd h (by decide)
        · refine ⟨fun h => ?_, fun _ => by rw [map_inv, hx.2 h1, hswapinv]⟩
          rw [map_inv, h1] at h; exact absurd h (by decide)
    -- elements of the kernel act by translations
    have htrans : ∀ g ∈ χ.ker, ∀ u : ℝ × ℝ, Ψ g u = u + Ψ g 0 := by
      intro g hg u
      have hl : (Ψ g).linear = LinearEquiv.refl ℝ (ℝ × ℝ) := (hlinχ g).1 hg
      have := (Ψ g).map_vadd 0 u
      rw [vadd_eq_add, add_zero, hl] at this
      rw [this]; rfl
    let φ : Additive χ.ker →+ ℝ :=
      { toFun := fun k => (Ψ (Additive.toMul k).1 0).1
        map_zero' := by
          simp only [toMul_zero, OneMemClass.coe_one, map_one]; rfl
        map_add' := by
          intro a b
          simp only [toMul_add, Subgroup.coe_mul, map_mul, AffineEquiv.coe_mul,
            Function.comp_apply]
          rw [htrans _ (Additive.toMul a).2, Prod.fst_add, add_comm] }
    have hφ : ∀ k : χ.ker, φ (Additive.ofMul k) = (Ψ k.1 0).1 := fun _ => rfl
    have hΨt : Ψ t = AffineEquiv.constVAdd ℝ (ℝ × ℝ) (0, v.1 i0) *
        (LinearEquiv.prodComm ℝ ℝ ℝ).toAffineEquiv := by
      rw [ht, hΨ i0]; simp [hi0, hswapL]
    have ht2v : (Ψ (t ^ 2) 0).1 = v.1 i0 := by
      rw [map_pow, pow_two, AffineEquiv.coe_mul, Function.comp_apply, hΨt]
      simp [AffineEquiv.constVAdd_apply, LinearEquiv.prodComm_apply]
    have hlint : (Ψ t).linear = swapL := (hlinχ t).2 hχt
    refine ⟨φ, Prod.ext (funext fun i => ?_) (funext fun i => ?_)⟩
    · change φ (Additive.ofMul ⟨c i, hcK i⟩) = v.1 i
      rw [hφ]
      by_cases hi : i.val = 0
      · have hii : i = i0 := Fin.ext hi
        simp only [hc, hi, ite_true]; rw [ht2v, hii]
      · simp only [hc, hi, ite_false]
        rw [hΨ i]; simp [hi, AffineEquiv.constVAdd_apply]
    · change φ (Additive.ofMul ⟨d i, hdK i⟩) = v.2 i
      rw [hφ]
      by_cases hi : i.val = 0
      · have hii : i = i0 := Fin.ext hi
        simp only [hd, hi, ite_true]; rw [ht2v, hii, h0]
      · simp only [hd, hi, ite_false]
        rw [map_mul, map_mul, AffineEquiv.coe_mul, AffineEquiv.coe_mul, Function.comp_apply,
          Function.comp_apply, hΨ i]
        simp only [hi, ite_false, AffineEquiv.constVAdd_apply]
        have hback : Ψ t (Ψ t⁻¹ 0) = 0 := by
          rw [← Function.comp_apply (f := Ψ t), ← AffineEquiv.coe_mul, ← map_mul,
            mul_inv_cancel, map_one]; rfl
        rw [(Ψ t).map_vadd, hback, hlint]
        simp [hswapL]
  -- dimension count
  have hrange : LinearMap.range C = LinearMap.ker L := le_antisymm hrange_le hle_range
  have hi01 : i1 ≠ i0 := by rw [hi0, hi1]; intro h; simp [Fin.ext_iff] at h
  have hLsurj : Function.Surjective L := by
    intro z
    refine ⟨(Pi.single i1 (z 1 / 2), Pi.single i0 (-(z 0)) + Pi.single i1 ((z 2 + z 0) / 2)), ?_⟩
    have hw0 : w i0 = 1 := by simp [hw, hi0]
    have hw1 : w i1 = 2 := by simp [hw, hi1]
    ext j
    fin_cases j
    · simp [L, hi01, Pi.single_apply]
    · simp [L, Pi.single_apply, hw1]; ring
    · simp [L, Pi.single_apply, Finset.sum_add_distrib, mul_add, hw0, hw1, hi01]; ring
  calc Module.finrank ℝ (Additive χ.ker →+ ℝ) = Module.finrank ℝ (LinearMap.range C) :=
        (LinearMap.finrank_range_of_inj hinj).symm
    _ = Module.finrank ℝ (LinearMap.ker L) := by rw [hrange]
    _ = 2 * p - 3 := by
      have h := LinearMap.finrank_range_add_finrank_ker L
      rw [LinearMap.range_eq_top.mpr hLsurj, finrank_top, Module.finrank_fin_fun,
        Module.finrank_prod, Module.finrank_fin_fun] at h
      omega

end LiZhongQC
