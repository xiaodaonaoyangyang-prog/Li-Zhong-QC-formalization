import LiZhongExternal.DifferentialGeometry.SchottkyVanKampen
import LiZhongQC.Lemmas.SchottkyOneRelator
import Mathlib.AlgebraicTopology.FundamentalGroupoid.SimplyConnected

universe u

namespace LiZhongQC

open DifferentialGeometry.Topology.VanKampen

/-- The normal closure of the image of a cyclic group is that of the image of its generator. -/
theorem s78dg_range_normalClosure {G H : Type*} [Group G] [Group H] (φ : H →* G) (γ : H)
    (hγ : ∀ z, z ∈ Subgroup.zpowers γ) :
    Subgroup.normalClosure (φ.range : Set G) = Subgroup.normalClosure ({φ γ} : Set G) := by
  have key : ∀ y ∈ (φ.range : Set G), y ∈ Subgroup.normalClosure ({φ γ} : Set G) := by
    rintro y ⟨z, rfl⟩
    obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp (hγ z)
    rw [map_zpow]
    exact Subgroup.zpow_mem _ (Subgroup.subset_normalClosure (Set.mem_singleton (φ γ))) n
  have key2 : ∀ y ∈ ({φ γ} : Set G), y ∈ (φ.range : Set G) := by
    intro y hy
    rw [Set.mem_singleton_iff.mp hy]
    exact ⟨γ, rfl⟩
  exact le_antisymm (Subgroup.normalClosure_le_normal key) (Subgroup.normalClosure_mono key2)

/-- **One 2-cell attached (van Kampen).**  Let `X = U ∪ V` with `U`, `V` open and path-connected, `U ∩ V`
path-connected with cyclic fundamental group generated by `γ`, and `V` simply connected.  If
`π₁(U) ≅ ⟨α | R⟩` and the image of `γ` in `π₁(U)` is the class of the word `w`, then
`π₁(X) ≅ ⟨α | R, w⟩`. -/
theorem s78dg_svk_one_cell {X : Type u} [TopologicalSpace X] (U V : Set X)
    (hU : IsOpen U) (hV : IsOpen V) (hcover : U ∪ V = Set.univ) (x₀ : X) (hx₀ : x₀ ∈ U ∩ V)
    [PathConnectedSpace U] [PathConnectedSpace V] [PathConnectedSpace (↑(U ∩ V))]
    [SimplyConnectedSpace V] {α : Type*} {R : Set (FreeGroup α)}
    (eU : fundamentalGroupFactor U V x₀ hx₀ false ≃* PresentedGroup R)
    (γ : FundamentalGroup (↑(U ∩ V)) (overlapBasepoint U V x₀ hx₀))
    (hγ : ∀ z, z ∈ Subgroup.zpowers γ) (w : FreeGroup α)
    (hw : PresentedGroup.mk R w = eU (fundamentalGroupAmalgamation U V x₀ hx₀ false γ)) :
    Nonempty (FundamentalGroup X x₀ ≃* PresentedGroup (insert w R)) := by
  have : Subsingleton (fundamentalGroupFactor U V x₀ hx₀ true) :=
    inferInstanceAs (Subsingleton (FundamentalGroup V (rightBasepoint V x₀ hx₀.2)))
  obtain ⟨e2⟩ := s78dg_pushoutI_one_trivial (fundamentalGroupAmalgamation U V x₀ hx₀)
  let φ0 := fundamentalGroupAmalgamation U V x₀ hx₀ false
  let x : fundamentalGroupFactor U V x₀ hx₀ false := φ0 γ
  have hx : eU.symm (PresentedGroup.mk R w) = x := by
    rw [hw]; exact eU.symm_apply_apply _
  have hN : Subgroup.normalClosure (φ0.range : Set (fundamentalGroupFactor U V x₀ hx₀ false)) =
      Subgroup.normalClosure ({eU.symm (PresentedGroup.mk R w)} : Set _) := by
    rw [hx]
    exact s78dg_range_normalClosure φ0 γ hγ
  obtain ⟨e3⟩ := s78dg_quotient_presented R w eU
  exact ⟨(fundamentalGroupEquivAmalgamatedProduct U V hU hV hcover x₀ hx₀).symm.trans
    (e2.trans ((QuotientGroup.quotientMulEquivOfEq hN).trans e3))⟩

end LiZhongQC
